  "gates": {
    "schema_version": 1,
    "_comment": "Governed-gate manifest consumed by bin/check-pr-preflight and bin/refresh-governance-artifacts (docs/specs/governed-gates.md §1). Every fast repo-state gate hosted CI blocks merge on appears here; tests/Architecture/PreflightParityTest.php binds this file to composer.json and the workflow files so it cannot drift from CI. {base} in a run command is replaced with the diff base ref (committed-state gates).",
    "gates": [
      {
        "id": "check-composer-policy",
        "alias": "check-composer-policy",
        "run": "php bin/check-composer-policy",
        "repair": "fix the reported composer.json policy violation (CPxxx codes are documented in bin/check-composer-policy)",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#php bin/check-composer-policy"
      },
      {
        "id": "check-portable-paths",
        "alias": "check-portable-paths",
        "run": "php bin/check-portable-paths",
        "repair": "rename the offending tracked path to a portable form",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-portable-paths"
      },
      {
        "id": "check-package-layers",
        "alias": "check-package-layers",
        "run": "php bin/check-package-layers",
        "repair": "move the dependency to a permitted layer or add a KERNEL_EXEMPT_FILES entry with rationale",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#php bin/check-package-layers"
      },
      {
        "id": "check-symfony-imports",
        "alias": "check-symfony-imports",
        "run": "php bin/check-symfony-imports",
        "repair": "use the Waaseyaa abstraction or extend .symfony-import-allowlist.json with a reviewed entry",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-symfony-imports",
        "refresh": {
          "mode": "manual",
          "instruction": "use the Waaseyaa abstraction, or add a reviewed .symfony-import-allowlist.json entry"
        }
      },
      {
        "id": "check-phpstan-paths",
        "alias": "check-phpstan-paths",
        "run": "bash bin/check-phpstan-paths",
        "repair": "add the missing path to phpstan.neon paths",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-phpstan-paths"
      },
      {
        "id": "check-phpunit-paths",
        "alias": "check-phpunit-paths",
        "run": "bash bin/check-phpunit-paths",
        "repair": "add the missing test directory to phpunit.xml.dist",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-phpunit-paths"
      },
      {
        "id": "check-phpunit-skip-policy",
        "alias": "check-phpunit-skip-policy",
        "run": "php bin/check-phpunit-skip-policy",
        "repair": "remove the skip from a required-hosted proof, narrow a broad catch, or add a reviewed tools/phpunit-skip-policy.json entry with an explicit predicate and rationale",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-phpunit-skip-policy",
        "refresh": {
          "mode": "manual",
          "instruction": "classify the exact semantic site in tools/phpunit-skip-policy.json; required-hosted files and broad catches cannot be allowlisted"
        }
      },
      {
        "id": "check-package-layers-pl008-self-test",
        "alias": "check-package-layers-pl008-self-test",
        "run": "php bin/check-package-layers-pl008-self-test",
        "repair": "restore the PL008 detection behavior in bin/check-package-layers",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-package-layers-pl008-self-test"
      },
      {
        "id": "check-distribution-extensions",
        "alias": "check-distribution-extensions",
        "run": "php bin/check-distribution-extensions",
        "repair": "keep distribution-extension packages out of the core metapackage require graphs",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-distribution-extensions"
      },
      {
        "id": "check-local-operator-tool-profile",
        "alias": "check-local-operator-tool-profile",
        "run": "php bin/check-local-operator-tool-profile",
        "repair": "review the reported tool change — it alters the local operator's least-privilege default (ADR-022 D-7) — then regenerate with php bin/check-local-operator-tool-profile --write-roster and commit support/local-operator-tool-profile-roster.json",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-local-operator-tool-profile",
        "refresh": {
          "mode": "manual",
          "instruction": "the roster records the local operator's least-privilege default (ADR-022 D-7) — review what changed, decide deliberately whether the tool belongs on LocalOperatorToolProfile::DEFAULT_TOOL_IDS, then run php bin/check-local-operator-tool-profile --write-roster and commit the roster"
        }
      },
      {
        "id": "check-getquery-bindings",
        "alias": "check-getquery-bindings",
        "run": "php bin/check-getquery-bindings",
        "repair": "bind the query (->setAccount / ->accessCheck(false)) or append a commented exemption via php bin/check-getquery-bindings --generate-baseline",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-getquery-bindings",
        "refresh": {
          "mode": "manual",
          "instruction": "php bin/check-getquery-bindings --generate-baseline, then replace every \"# TODO: add exemption reason\" stub with a real reviewed reason before committing"
        }
      },
      {
        "id": "check-dispatcher-keys",
        "alias": "check-dispatcher-keys",
        "run": "php bin/check-dispatcher-keys",
        "repair": "fix the dispatcher key or regenerate with php bin/check-dispatcher-keys --generate-baseline",
        "profile": "default",
        "enforced_by": "workflow:ci.yml#run_gate check-dispatcher-keys",
        "refresh": {
          "mode": "auto",
          "write": "php bin/check-dispatcher-keys --generate-baseline"
        }
      },
      {
        "id": "check-admin-coercion-patterns",
        "alias": "check-admin-coercion-patterns",
        "run": "bash bin/check-admin-coercion-patterns",
