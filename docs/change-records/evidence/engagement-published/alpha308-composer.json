{
    "name": "waaseyaa/engagement-consumer-probe",
    "type": "project",
    "require": {
        "php": "^8.5",
        "waaseyaa/core": "0.1.0-alpha.308",
        "waaseyaa/api": "0.1.0-alpha.308",
        "waaseyaa/engagement": "0.1.0-alpha.308",
        "waaseyaa/cli": "0.1.0-alpha.308",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "EngagementConsumer\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "waaseyaa": {
            "providers": [
                "EngagementConsumer\\EngagementConsumerServiceProvider"
            ],
            "migrations": "migrations"
        }
    }
}
