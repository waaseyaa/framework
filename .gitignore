# Dependencies
vendor
vendor/
packages/*/vendor/
packages/*/composer.lock
# The skeleton ships without a lock (create-project writes a fresh one per
# project); ignore artifacts from running composer inside skeleton/ locally.
skeleton/composer.lock
skeleton/vendor/
mcp/node_modules/
tools/spec-retrieval/node_modules/

# IDE
.idea/
.vscode/

# PHPUnit
.phpunit.result.cache
packages/*/.phpunit.result.cache
packages/*/.phpunit.cache/

# PHP CS Fixer
.php-cs-fixer.cache

# PHPStan + dead-code cache + any other transient scratch
/tmp/

# Layer 0 / local audit bundles (regenerate via scripts/layer0_audit/ and
# tools/audit/GenerateLayerAudit.php)
artifacts/
/build/

# Claude Code local scheduler lock (machine-specific)
.claude/scheduled_tasks.lock

# Background sync tool stray working dirs
waaseyaa-sync-*/

# OIDC JWKS test fixture working dirs (hash-suffixed, regenerated per run)
waaseyaa_oidc_jwks_*/

# Playwright runner state (transient, regenerated per test run)
test-results/

# Database
*.sqlite

# Admin SPA build artifacts and dependencies
packages/admin/.nuxt/
packages/admin/.nuxtrc
packages/admin/.output/
packages/admin/node_modules/

# Admin SPA pre-built distribution (committed by CI)
!packages/admin-surface/dist/

# Storage (compiled artifacts, database files)
storage/*
!storage/.gitkeep

# Environment
.env
.env.*
!.env.example

# Worktrees
.worktrees/

.playwright-mcp/

# Playwright test artifacts
packages/admin/playwright-report/
packages/admin/test-results/

# Smoke test screenshots
smoke-*.png
admin-login-smoke-*.png

# PHPStan cache when run from repo root (CI variant — tmp/phpstan/ is already ignored)
/phpstan/

# Node/Vitest temp artifacts
node-compile-cache/
.superpowers/

