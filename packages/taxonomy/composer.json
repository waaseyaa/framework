{
    "name": "waaseyaa/taxonomy",
    "description": "Taxonomy vocabulary and term entity types for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.302",
        "waaseyaa/database-legacy": "^0.1.0-alpha.302",
        "waaseyaa/entity": "^0.1.0-alpha.302",
        "waaseyaa/field": "^0.1.0-alpha.302",
        "waaseyaa/foundation": "^0.1.0-alpha.302"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/entity-storage": "^0.1.0-alpha.302"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Taxonomy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Taxonomy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "administer taxonomy": {
                    "title": "Administer taxonomy",
                    "description": "Bypass ordinary vocabulary-specific taxonomy access checks."
                }
            },
            "policies": [
                "Waaseyaa\\Taxonomy\\TermAccessPolicy",
                "Waaseyaa\\Taxonomy\\VocabularyAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Taxonomy\\TaxonomyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
