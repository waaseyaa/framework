{
    "name": "waaseyaa/api",
    "description": "RESTful JSON:API resource layer for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../auth"
        },
        {
            "type": "path",
            "url": "../cache"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../mail"
        },
        {
            "type": "path",
            "url": "../media"
        },
        {
            "type": "path",
            "url": "../notification"
        },
        {
            "type": "path",
            "url": "../queue"
        },
        {
            "type": "path",
            "url": "../relationship"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../scheduler"
        },
        {
            "type": "path",
            "url": "../search"
        },
        {
            "type": "path",
            "url": "../workflows"
        },
        {
            "type": "path",
            "url": "../telescope"
        },
        {
            "type": "path",
            "url": "../testing"
        },
        {
            "type": "path",
            "url": "../ai-tools"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../mcp"
        },
        {
            "type": "path",
            "url": "../node"
        },
        {
            "type": "path",
            "url": "../oidc"
        },
        {
            "type": "path",
            "url": "../user"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/html-sanitizer": "^8.0",
        "waaseyaa/access": "^0.1.0-alpha.297",
        "waaseyaa/audit": "^0.1.0-alpha.297",
        "waaseyaa/cache": "^0.1.0-alpha.297",
        "waaseyaa/database-legacy": "^0.1.0-alpha.297",
        "waaseyaa/entity": "^0.1.0-alpha.297",
        "waaseyaa/entity-storage": "^0.1.0-alpha.297",
        "waaseyaa/field": "^0.1.0-alpha.297",
        "waaseyaa/foundation": "^0.1.0-alpha.297",
        "waaseyaa/mail": "^0.1.0-alpha.297",
        "waaseyaa/media": "^0.1.0-alpha.297",
        "waaseyaa/notification": "^0.1.0-alpha.297",
        "waaseyaa/queue": "^0.1.0-alpha.297",
        "waaseyaa/relationship": "^0.1.0-alpha.297",
        "waaseyaa/routing": "^0.1.0-alpha.297",
        "waaseyaa/scheduler": "^0.1.0-alpha.297",
        "waaseyaa/workflows": "^0.1.0-alpha.297"
    },
    "suggest": {
        "waaseyaa/auth": "Provides atomic rate limiting for the optional public content search endpoint",
        "waaseyaa/search": "Provides principal-safe search for the optional public content search endpoint",
        "waaseyaa/oidc": "Provides optional OIDC client administration routes"
    },
    "conflict": {
        "waaseyaa/auth": "<0.1.0-alpha.287 || >=0.2.0",
        "waaseyaa/search": "<0.1.0-alpha.287 || >=0.2.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^13.0",
        "waaseyaa/ai-tools": "^0.1.0-alpha.297",
        "waaseyaa/audit": "^0.1.0-alpha.297",
        "waaseyaa/auth": "^0.1.0-alpha.297",
        "waaseyaa/config": "^0.1.0-alpha.297",
        "waaseyaa/database-legacy": "^0.1.0-alpha.297",
        "waaseyaa/mcp": "^0.1.0-alpha.297",
        "waaseyaa/media": "^0.1.0-alpha.297",
        "waaseyaa/node": "^0.1.0-alpha.297",
        "waaseyaa/oidc": "^0.1.0-alpha.297",
        "waaseyaa/search": "^0.1.0-alpha.297",
        "waaseyaa/telescope": "^0.1.0-alpha.297",
        "waaseyaa/testing": "^0.1.0-alpha.297",
        "waaseyaa/user": "^0.1.0-alpha.297"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Api\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "waaseyaa": {
            "migrations": "migrations",
            "providers": [
                "Waaseyaa\\Api\\ApiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
