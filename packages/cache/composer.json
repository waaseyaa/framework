{
    "name": "waaseyaa/cache",
    "description": "Cache bins with cache tag invalidation for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "waaseyaa/database-legacy": "^0.1.0-alpha.296",
        "waaseyaa/foundation": "^0.1.0-alpha.296"
    },
    "suggest": {
        "waaseyaa/entity": "^0.1.0-alpha.261",
        "waaseyaa/config": "^0.1.0-alpha.261",
        "waaseyaa/entity-storage": "^0.1.0-alpha.261"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/config": "^0.1.0-alpha.296",
        "waaseyaa/entity": "^0.1.0-alpha.296",
        "waaseyaa/entity-storage": "^0.1.0-alpha.296"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Cache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\Cache\\CacheServiceProvider"
            ],
            "migrations": "migrations"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        }
    ]
}
