{
    "name": "waaseyaa/user",
    "description": "User entity, authentication, and session management for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../mail"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../ssr"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/entity": "^0.1.0-alpha.297",
        "waaseyaa/access": "^0.1.0-alpha.297",
        "waaseyaa/foundation": "^0.1.0-alpha.297",
        "waaseyaa/mail": "^0.1.0-alpha.297",
        "symfony/http-foundation": "^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/database-legacy": "^0.1.0-alpha.297",
        "waaseyaa/entity-storage": "^0.1.0-alpha.297",
        "waaseyaa/field": "^0.1.0-alpha.297",
        "waaseyaa/ssr": "^0.1.0-alpha.297"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\User\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\User\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "policies": [
                "Waaseyaa\\User\\UserAccessPolicy",
                "Waaseyaa\\User\\UserBlockAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\User\\UserServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
