{
    "name": "waaseyaa/genealogy",
    "description": "Distribution-extension package — Indigenous genealogy entities, graph traversal, and public SSR for Waaseyaa-based distributions",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../relationship"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../ssr"
        },
        {
            "type": "path",
            "url": "../user"
        },
        {
            "type": "path",
            "url": "../workflows"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        }
    ],
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Genealogy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Genealogy\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.291",
        "waaseyaa/audit": "^0.1.0-alpha.291",
        "waaseyaa/entity": "^0.1.0-alpha.291",
        "waaseyaa/field": "^0.1.0-alpha.291",
        "waaseyaa/foundation": "^0.1.0-alpha.291",
        "waaseyaa/relationship": "^0.1.0-alpha.291",
        "waaseyaa/routing": "^0.1.0-alpha.291",
        "waaseyaa/ssr": "^0.1.0-alpha.291",
        "waaseyaa/user": "^0.1.0-alpha.291",
        "waaseyaa/workflows": "^0.1.0-alpha.291"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/api": "^0.1.0-alpha.291",
        "waaseyaa/database-legacy": "^0.1.0-alpha.291",
        "waaseyaa/entity-storage": "^0.1.0-alpha.291"
    },
    "extra": {
        "waaseyaa": {
            "distributionExtension": true,
            "policies": [
                "Waaseyaa\\Genealogy\\Access\\GenealogyContentAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Genealogy\\GenealogyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "verify:no-api-coupling": "@php scripts/check-no-waaseyaa-api-coupling.php"
    }
}
