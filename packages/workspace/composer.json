{
    "name": "waaseyaa/workspace",
    "description": "Opt-in workspace shell primitives — the shared chat surface (SSE client, markdown renderer, composer scaffold) and, in later cuts, the canvas+rails layout and preview panel",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../foundation"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/http-foundation": "^7.0",
        "waaseyaa/entity": "^0.1.0-alpha.217",
        "waaseyaa/foundation": "^0.1.0-alpha.217",
        "waaseyaa/routing": "^0.1.0-alpha.217"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Workspace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Workspace\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\Workspace\\WorkspaceServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
