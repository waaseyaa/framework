{
    "name": "waaseyaa/config",
    "description": "Configuration management as YAML with package-aware ownership for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "waaseyaa/database-legacy": "^0.1.0-alpha.294",
        "waaseyaa/foundation": "^0.1.0-alpha.294",
        "symfony/event-dispatcher": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/entity": "^0.1.0-alpha.294"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Config\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "waaseyaa": {
            "config-contract": {
                "schema-provider": "Waaseyaa\\Config\\Authority\\ConfigurationAuthorityServiceProvider",
                "version": 1,
                "readable_versions": [
                    1
                ]
            },
            "providers": [
                "Waaseyaa\\Config\\Authority\\ConfigurationAuthorityServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../entity"
        }
    ]
}
