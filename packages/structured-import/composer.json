{
    "name": "waaseyaa/structured-import",
    "description": "Pluggable structured-import pipeline for entity-template ingestion (default: GFM 2-column table).",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        }
    ],
    "require": {
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "php": "^8.5",
        "waaseyaa/entity": "^0.1.0-alpha.299",
        "waaseyaa/field": "^0.1.0-alpha.299",
        "waaseyaa/foundation": "^0.1.0-alpha.299"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\StructuredImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\StructuredImport\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\StructuredImport\\StructuredImportServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
