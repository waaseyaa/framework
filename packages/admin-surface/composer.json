{
    "name": "waaseyaa/admin-surface",
    "description": "Canonical integration boundary for the Waaseyaa Admin SPA",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../workflows"
        },
        {
            "type": "path",
            "url": "../node"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/http-foundation": "^7.0",
        "waaseyaa/entity": "^0.1.0-alpha.260",
        "waaseyaa/access": "^0.1.0-alpha.260",
        "waaseyaa/routing": "^0.1.0-alpha.260",
        "waaseyaa/foundation": "^0.1.0-alpha.260",
        "waaseyaa/api": "^0.1.0-alpha.260"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "waaseyaa/config": "^0.1.0-alpha.260",
        "waaseyaa/database-legacy": "^0.1.0-alpha.260",
        "waaseyaa/node": "^0.1.0-alpha.260",
        "waaseyaa/workflows": "^0.1.0-alpha.260"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\AdminSurface\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\AdminSurface\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\AdminSurface\\AdminSurfaceServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
