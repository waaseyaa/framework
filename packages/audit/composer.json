{
    "name": "waaseyaa/audit",
    "description": "OCAP append-only audit log substrate — unified event table, writer + query contracts, retention policy.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../scheduler"
        },
        {
            "type": "path",
            "url": "../testing"
        },
        {
            "type": "path",
            "url": "../user"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.297",
        "waaseyaa/database-legacy": "^0.1.0-alpha.297",
        "waaseyaa/entity": "^0.1.0-alpha.297",
        "waaseyaa/entity-storage": "^0.1.0-alpha.297",
        "waaseyaa/foundation": "^0.1.0-alpha.297",
        "waaseyaa/scheduler": "^0.1.0-alpha.297"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/entity-storage": "^0.1.0-alpha.297",
        "waaseyaa/testing": "^0.1.0-alpha.297",
        "waaseyaa/user": "^0.1.0-alpha.297"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Audit\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\Audit\\AuditServiceProvider"
            ],
            "migrations": "migrations"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
