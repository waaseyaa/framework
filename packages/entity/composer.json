{
    "name": "waaseyaa/entity",
    "description": "Entity type system \u2014 types, interfaces, lifecycle, queries. No storage.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../cache"
        },
        {
            "type": "path",
            "url": "../plugin"
        },
        {
            "type": "path",
            "url": "../typed-data"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../validation"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.211",
        "waaseyaa/cache": "^0.1.0-alpha.211",
        "waaseyaa/config": "^0.1.0-alpha.211",
        "waaseyaa/foundation": "^0.1.0-alpha.211",
        "waaseyaa/plugin": "^0.1.0-alpha.211",
        "waaseyaa/typed-data": "^0.1.0-alpha.211",
        "waaseyaa/validation": "^0.1.0-alpha.211",
        "symfony/event-dispatcher": "^7.0",
        "symfony/uid": "^7.0",
        "symfony/validator": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "nesbot/carbon": "Optional domain for datetime_immutable cast with domain carbon_immutable (#1183)."
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Entity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Entity\\PhpStan\\": "testing/PhpStan/",
            "Waaseyaa\\Entity\\Testing\\": "testing/",
            "Waaseyaa\\Entity\\Testing\\Translation\\": "testing/Translation/",
            "Waaseyaa\\Entity\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
