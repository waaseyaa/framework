{
    "name": "waaseyaa/node",
    "description": "Content node entity type for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.301",
        "waaseyaa/database-legacy": "^0.1.0-alpha.301",
        "waaseyaa/entity": "^0.1.0-alpha.301",
        "waaseyaa/entity-storage": "^0.1.0-alpha.301",
        "waaseyaa/field": "^0.1.0-alpha.301",
        "waaseyaa/foundation": "^0.1.0-alpha.301"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Node\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Node\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "access content": {
                    "title": "Access published content",
                    "description": "View published content governed by the node access policy."
                },
                "administer nodes": {
                    "title": "Administer nodes",
                    "description": "Bypass ordinary node bundle and ownership access checks."
                },
                "view own unpublished content": {
                    "title": "View own unpublished content",
                    "description": "View unpublished content owned by the acting account."
                }
            },
            "policies": [
                "Waaseyaa\\Node\\NodeAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Node\\NodeServiceProvider"
            ],
            "migrations": "migrations"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
