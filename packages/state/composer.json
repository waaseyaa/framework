{
    "name": "waaseyaa/state",
    "description": "Key-value state storage for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "waaseyaa/database-legacy": "^0.1.0-alpha.298"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/entity": "^0.1.0-alpha.298"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        }
    ],
    "autoload": {
        "psr-4": {
            "Waaseyaa\\State\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\State\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "migrations": "migrations"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
