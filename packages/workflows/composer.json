{
    "name": "waaseyaa/workflows",
    "description": "Content moderation and editorial workflow states for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../config"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../groups"
        },
        {
            "type": "path",
            "url": "../relationship"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../node"
        },
        {
            "type": "path",
            "url": "../publishing"
        },
        {
            "type": "path",
            "url": "../user"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.301",
        "waaseyaa/audit": "^0.1.0-alpha.301",
        "waaseyaa/config": "^0.1.0-alpha.301",
        "waaseyaa/entity": "^0.1.0-alpha.301",
        "waaseyaa/entity-storage": "^0.1.0-alpha.301",
        "waaseyaa/field": "^0.1.0-alpha.301",
        "waaseyaa/foundation": "^0.1.0-alpha.301",
        "waaseyaa/groups": "^0.1.0-alpha.301",
        "waaseyaa/publishing": "^0.1.0-alpha.301",
        "waaseyaa/relationship": "^0.1.0-alpha.301"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/database-legacy": "^0.1.0-alpha.301",
        "waaseyaa/node": "^0.1.0-alpha.301",
        "waaseyaa/user": "^0.1.0-alpha.301"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Workflows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Workflows\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "use editorial transition archive": {
                    "title": "Archive transition",
                    "description": "Use the archive transition on the editorial workflow."
                },
                "use editorial transition publish": {
                    "title": "Publish transition",
                    "description": "Use the publish transition on the editorial workflow."
                },
                "use editorial transition reject": {
                    "title": "Send back transition",
                    "description": "Use the reject transition on the editorial workflow."
                },
                "use editorial transition restore": {
                    "title": "Restore to draft transition",
                    "description": "Use the restore transition on the editorial workflow."
                },
                "use editorial transition restore_to_published": {
                    "title": "Restore transition",
                    "description": "Use the restore_to_published transition on the editorial workflow."
                },
                "use editorial transition revise": {
                    "title": "Create new draft transition",
                    "description": "Use the revise transition on the editorial workflow."
                },
                "use editorial transition submit_for_review": {
                    "title": "Submit for review transition",
                    "description": "Use the submit_for_review transition on the editorial workflow."
                }
            },
            "config-contract": {
                "schema-provider": "Waaseyaa\\Workflows\\WorkflowServiceProvider",
                "version": 1,
                "readable_versions": [
                    1
                ]
            },
            "policies": [
                "Waaseyaa\\Workflows\\Access\\WorkflowAuthorityAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Workflows\\WorkflowServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
