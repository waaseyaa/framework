{
    "name": "waaseyaa/oauth-provider",
    "description": "OAuth 2.0 provider abstraction for Waaseyaa applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "waaseyaa/http-client": "^0.1.0-alpha.288"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\OAuthProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\OAuthProvider\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../http-client"
        }
    ]
}
