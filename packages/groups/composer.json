{
    "name": "waaseyaa/groups",
    "description": "Multi-bundle Group content entity type for Waaseyaa (group + group_type; app-defined bundles)",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../relationship"
        },
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../user"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../routing"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.296",
        "waaseyaa/database-legacy": "^0.1.0-alpha.296",
        "waaseyaa/entity": "^0.1.0-alpha.296",
        "waaseyaa/entity-storage": "^0.1.0-alpha.296",
        "waaseyaa/field": "^0.1.0-alpha.296",
        "waaseyaa/foundation": "^0.1.0-alpha.296",
        "waaseyaa/relationship": "^0.1.0-alpha.296"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/api": "^0.1.0-alpha.296",
        "waaseyaa/routing": "^0.1.0-alpha.296",
        "waaseyaa/user": "^0.1.0-alpha.296"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Groups\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Groups\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "administer groups": {
                    "title": "Administer groups",
                    "description": "Create, view, update, and delete groups and group types."
                }
            },
            "policies": [
                "Waaseyaa\\Groups\\GroupAccessPolicy",
                "Waaseyaa\\Groups\\StaffDirectory\\CapabilityScopedStaffDirectoryAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Groups\\GroupsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
