{
    "name": "waaseyaa/mcp",
    "description": "Remote MCP server endpoint for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../ai-tools"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../user"
        },
        {
            "type": "path",
            "url": "../auth"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../testing"
        }
    ],
    "require": {
        "composer-runtime-api": "^2.2",
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.294",
        "waaseyaa/ai-tools": "^0.1.0-alpha.294",
        "waaseyaa/api": "^0.1.0-alpha.294",
        "waaseyaa/auth": "^0.1.0-alpha.294",
        "waaseyaa/database-legacy": "^0.1.0-alpha.294",
        "waaseyaa/entity": "^0.1.0-alpha.294",
        "waaseyaa/foundation": "^0.1.0-alpha.294",
        "waaseyaa/routing": "^0.1.0-alpha.294",
        "waaseyaa/user": "^0.1.0-alpha.294"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/audit": "^0.1.0-alpha.294",
        "waaseyaa/testing": "^0.1.0-alpha.294"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Mcp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\Mcp\\McpServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
