{% extends "layouts/base.html.twig" %}

{# `title` is the access-checked label (SsrPageHandler::handleRenderPage() via
   EntityAccessHandler::viewableLabel(), R7 WP1) — never read entity.label
   directly here, it bypasses field-level access. #}
{% block title %}{{ title }}{% endblock %}

{% block meta %}
  {# schema.org JSON-LD for agents/crawlers (FR-014); built by EntitySchemaOrgMapper. #}
  {% if schema_org_jsonld is defined and schema_org_jsonld %}{{ schema_org_jsonld|raw }}{% endif %}
{% endblock %}

{% block body %}
<article class="entity entity-{{ entity_type }} entity-view-{{ view_mode }}">
  {% for field_name, field in fields %}
    <div class="field field-{{ field_name }}">
      {{ field.formatted|raw }}
    </div>
  {% endfor %}

  <footer class="entity-agent-readable">
    {# Visible affordance + machine-discoverable alternate: the exact Markdown an
       agent receives via `Accept: text/markdown` on this same URL (FR-005). #}
    <a href="?raw=1" rel="alternate" type="text/markdown" data-agent-readable="markdown">View as Markdown</a>
  </footer>
</article>
{% endblock %}
