<article class="entity entity-{{ entity_type }} entity-view-{{ view_mode }}">
  {% for field_name, field in fields %}
    <div class="field field-{{ field_name }}">
      {{ field.formatted|raw }}
    </div>
  {% endfor %}

  <footer class="entity-agent-readable">
    {# Visible affordance + machine-discoverable alternate: the exact Markdown an
       agent receives via `Accept: text/markdown` on this same URL (FR-005). #}
    <a href="?raw=1" rel="alternate" type="text/markdown" data-agent-readable="markdown">View as Markdown</a>
  </footer>
</article>
