{
    "name": "waaseyaa/foundation",
    "description": "Core framework primitives: service providers, domain events, results, error handling",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../cache"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../queue"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../error-handler"
        },
        {
            "type": "path",
            "url": "../routing"
        },
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../ai-tools"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../auth"
        },
        {
            "type": "path",
            "url": "../cli"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../graphql"
        },
        {
            "type": "path",
            "url": "../groups"
        },
        {
            "type": "path",
            "url": "../i18n"
        },
        {
            "type": "path",
            "url": "../mcp"
        },
        {
            "type": "path",
            "url": "../media"
        },
        {
            "type": "path",
            "url": "../node"
        },
        {
            "type": "path",
            "url": "../scheduler"
        },
        {
            "type": "path",
            "url": "../seo"
        },
        {
            "type": "path",
            "url": "../ssr"
        },
        {
            "type": "path",
            "url": "../taxonomy"
        },
        {
            "type": "path",
            "url": "../user"
        },
        {
            "type": "path",
            "url": "../workflows"
        }
    ],
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/polyfill-intl-normalizer": "^1.30",
        "symfony/polyfill-mbstring": "^1.30",
        "symfony/uid": "^7.0",
        "waaseyaa/cache": "^0.1.0-alpha.297",
        "waaseyaa/database-legacy": "^0.1.0-alpha.297",
        "waaseyaa/queue": "^0.1.0-alpha.297"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/access": "^0.1.0-alpha.297",
        "waaseyaa/ai-tools": "^0.1.0-alpha.297",
        "waaseyaa/api": "^0.1.0-alpha.297",
        "waaseyaa/audit": "^0.1.0-alpha.297",
        "waaseyaa/auth": "^0.1.0-alpha.297",
        "waaseyaa/cli": "^0.1.0-alpha.297",
        "waaseyaa/entity": "^0.1.0-alpha.297",
        "waaseyaa/entity-storage": "^0.1.0-alpha.297",
        "waaseyaa/error-handler": "^0.1.0-alpha.297",
        "waaseyaa/field": "^0.1.0-alpha.297",
        "waaseyaa/graphql": "^0.1.0-alpha.297",
        "waaseyaa/groups": "^0.1.0-alpha.297",
        "waaseyaa/i18n": "^0.1.0-alpha.297",
        "waaseyaa/mcp": "^0.1.0-alpha.297",
        "waaseyaa/media": "^0.1.0-alpha.297",
        "waaseyaa/node": "^0.1.0-alpha.297",
        "waaseyaa/routing": "^0.1.0-alpha.297",
        "waaseyaa/scheduler": "^0.1.0-alpha.297",
        "waaseyaa/seo": "^0.1.0-alpha.297",
        "waaseyaa/ssr": "^0.1.0-alpha.297",
        "waaseyaa/taxonomy": "^0.1.0-alpha.297",
        "waaseyaa/user": "^0.1.0-alpha.297",
        "waaseyaa/workflows": "^0.1.0-alpha.297"
    },
    "autoload": {
        "files": [
            "src/Http/Request.php"
        ],
        "psr-4": {
            "Waaseyaa\\Foundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Foundation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "waaseyaa": {
            "migrations": "migrations",
            "providers": [
                "Waaseyaa\\Foundation\\FoundationServiceProvider",
                "Waaseyaa\\Foundation\\MercureMonitorServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
