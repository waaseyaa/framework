{
    "name": "waaseyaa/media",
    "description": "Media entity type and file management for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../audit"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../api"
        },
        {
            "type": "path",
            "url": "../user"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/entity": "^0.1.0-alpha.301",
        "waaseyaa/field": "^0.1.0-alpha.301",
        "waaseyaa/foundation": "^0.1.0-alpha.301",
        "waaseyaa/access": "^0.1.0-alpha.301",
        "waaseyaa/audit": "^0.1.0-alpha.301",
        "waaseyaa/database-legacy": "^0.1.0-alpha.301"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/access": "^0.1.0-alpha.301",
        "waaseyaa/api": "^0.1.0-alpha.301",
        "waaseyaa/database-legacy": "^0.1.0-alpha.301",
        "waaseyaa/user": "^0.1.0-alpha.301"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "waaseyaa": {
            "permissions": {
                "access media": {
                    "title": "Access published media",
                    "description": "View published media governed by the media access policy."
                },
                "administer media": {
                    "title": "Administer media",
                    "description": "Bypass ordinary media-type and ownership access checks."
                },
                "view own unpublished media": {
                    "title": "View own unpublished media",
                    "description": "View unpublished media owned by the acting account."
                }
            },
            "policies": [
                "Waaseyaa\\Media\\MediaAccessPolicy"
            ],
            "providers": [
                "Waaseyaa\\Media\\MediaServiceProvider"
            ],
            "migrations": "migrations"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
