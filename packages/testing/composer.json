{
    "name": "waaseyaa/testing",
    "description": "Typed framework-contract fixtures and compatibility testing utilities for Waaseyaa.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../database-legacy"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../field"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../routing"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.296",
        "waaseyaa/database-legacy": "^0.1.0-alpha.296",
        "waaseyaa/entity": "^0.1.0-alpha.296",
        "waaseyaa/field": "^0.1.0-alpha.296",
        "waaseyaa/foundation": "^0.1.0-alpha.296"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/routing": "^0.1.0-alpha.296"
    },
    "suggest": {
        "fakerphp/faker": "Optional realistic strings and emails for EntityTypeFixtureValues (framework#1186)."
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Testing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
