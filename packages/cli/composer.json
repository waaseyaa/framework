        "symfony/console": "^8.0",
        "waaseyaa/access": "^0.1.0-alpha.300",
        "waaseyaa/admin-surface": "^0.1.0-alpha.300",
        "waaseyaa/ai-tools": "^0.1.0-alpha.300",
        "waaseyaa/audit": "^0.1.0-alpha.300",
        "waaseyaa/auth": "^0.1.0-alpha.300",
        "waaseyaa/cache": "^0.1.0-alpha.300",
        "waaseyaa/config": "^0.1.0-alpha.300",
        "waaseyaa/entity": "^0.1.0-alpha.300",
        "waaseyaa/entity-storage": "^0.1.0-alpha.300",
        "waaseyaa/groups": "^0.1.0-alpha.300",
        "waaseyaa/http-client": "^0.1.0-alpha.300",
        "waaseyaa/listing": "^0.1.0-alpha.300",
        "waaseyaa/mail": "^0.1.0-alpha.300",
        "waaseyaa/migration": "^0.1.0-alpha.300",
        "waaseyaa/page-builder": "^0.1.0-alpha.300",
        "waaseyaa/path": "^0.1.0-alpha.300",
        "waaseyaa/publishing": "^0.1.0-alpha.300",
        "waaseyaa/queue": "^0.1.0-alpha.300",
        "waaseyaa/scheduler": "^0.1.0-alpha.300",
        "waaseyaa/site-contract": "^0.1.0-alpha.300",
        "waaseyaa/user": "^0.1.0-alpha.300",
        "waaseyaa/ai-vector": "^0.1.0-alpha.300",
        "waaseyaa/database-legacy": "^0.1.0-alpha.300",
        "waaseyaa/field": "^0.1.0-alpha.300",
        "waaseyaa/foundation": "^0.1.0-alpha.300",
        "waaseyaa/plugin": "^0.1.0-alpha.300",
        "waaseyaa/routing": "^0.1.0-alpha.300",
        "waaseyaa/search": "^0.1.0-alpha.300",
        "waaseyaa/seo": "^0.1.0-alpha.300",
        "waaseyaa/ssr": "^0.1.0-alpha.300",
        "waaseyaa/workflows": "^0.1.0-alpha.300"
    },
    "suggest": {
        "ext-intl": "For ICU transliteration of diacritic titles to readable Latin ingest keys; a deterministic hash key is used otherwise",
        "ext-pcntl": "Required for clean SIGINT handling in --watch mode",
        "waaseyaa/ai-agent": "Provides the optional ai:* operator commands",
        "waaseyaa/oidc": "Provides the optional oidc:* operator commands"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/ai-agent": "^0.1.0-alpha.300",
        "waaseyaa/node": "^0.1.0-alpha.300",
        "waaseyaa/oidc": "^0.1.0-alpha.300",
        "waaseyaa/relationship": "^0.1.0-alpha.300",
        "waaseyaa/testing": "^0.1.0-alpha.300"
    },
    "bin": [
        "bin/waaseyaa"
    ],
    "autoload": {
        "psr-4": {
            "Waaseyaa\\CLI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\CLI\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        },
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\CLI\\CliServiceProvider",
                "Waaseyaa\\CLI\\Provider\\AiServiceProvider",
                "Waaseyaa\\CLI\\Provider\\AuditServiceProvider",
                "Waaseyaa\\CLI\\Provider\\McpStdioServiceProvider",
                "Waaseyaa\\CLI\\Provider\\BearerTokenServiceProvider",
                "Waaseyaa\\CLI\\Provider\\BundleFixtureServiceProvider",
                "Waaseyaa\\CLI\\Provider\\EntityTypeServiceProvider",
                "Waaseyaa\\CLI\\Provider\\GroupsCliServiceProvider",
                "Waaseyaa\\CLI\\Provider\\HealthSchemaServiceProvider",
                "Waaseyaa\\CLI\\Provider\\ImportServiceProvider",
                "Waaseyaa\\CLI\\Provider\\MaintenanceServiceProvider",
                "Waaseyaa\\CLI\\Provider\\WorkflowsServiceProvider",
                "Waaseyaa\\CLI\\Provider\\MakeServiceProviderA",
                "Waaseyaa\\CLI\\Provider\\MakeServiceProviderB",
                "Waaseyaa\\CLI\\Provider\\MakeStorageMigrationServiceProvider",
                "Waaseyaa\\CLI\\Provider\\MigrateServiceProvider",
                "Waaseyaa\\CLI\\Provider\\OptimizeServiceProvider",
                "Waaseyaa\\CLI\\Provider\\QueueServiceProvider",
                "Waaseyaa\\CLI\\Provider\\SchedulePerfServiceProvider",
                "Waaseyaa\\CLI\\Provider\\SiteServiceProvider",
                "Waaseyaa\\CLI\\Provider\\IngestSearchSemanticServiceProvider",
                "Waaseyaa\\CLI\\Provider\\UserPermissionServiceProvider",
                "Waaseyaa\\CLI\\Provider\\ConfigCacheDbAuditServiceProvider",
                "Waaseyaa\\CLI\\Provider\\MiscAServiceProvider",
                "Waaseyaa\\CLI\\Provider\\MiscBServiceProvider",
                "Waaseyaa\\CLI\\Provider\\OtherScaffoldsServiceProvider",
                "Waaseyaa\\CLI\\Provider\\OidcServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
