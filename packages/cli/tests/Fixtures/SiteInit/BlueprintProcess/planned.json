\":[\"id\",\"kind\",\"role\",\"workflow\",\"transition\",\"expect\"],\"type\":\"object\"}},\"$id\":\"https://waaseyaa.org/schema/site/v1\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"additionalProperties\":false,\"properties\":{\"application\":{\"additionalProperties\":false,\"properties\":{\"canonical_origin\":{\"additionalProperties\":false,\"properties\":{\"config_key\":{\"pattern\":\"^[A-Z][A-Z0-9_]*$\",\"type\":\"string\"}},\"required\":[\"config_key\"],\"type\":\"object\"},\"id\":{\"pattern\":\"^[a-z][a-z0-9_-]*$\",\"type\":\"string\"},\"name\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"name\",\"canonical_origin\"],\"type\":\"object\"},\"application_blueprint\":{\"$ref\":\"#/$defs/applicationBlueprint\"},\"capabilities\":{\"items\":{\"oneOf\":[{\"$ref\":\"#/$defs/activeCapability\"},{\"$ref\":\"#/$defs/plannedCapability\"},{\"$ref\":\"#/$defs/notNeededCapability\"}]},\"minItems\":1,\"type\":\"array\"},\"content_types\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"canonical_route\":{\"pattern\":\"^(?!.*(?:^|/)\\\\.{1,2}(?:/|$))/(?!/)[^\\\\x00-\\\\x20\\\\x7F?#\\\\\\\\%]*$\",\"type\":\"string\"},\"id\":{\"pattern\":\"^[a-z][a-z0-9_-]*$\",\"type\":\"string\"}},\"required\":[\"id\",\"canonical_route\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"},\"framework\":{\"additionalProperties\":false,\"properties\":{\"observed_lock_sha256\":{\"$ref\":\"#/$defs/sha256\"},\"revision_policy\":{\"const\":\"exact-lock\"}},\"required\":[\"revision_policy\",\"observed_lock_sha256\"],\"type\":\"object\"},\"generator_version\":{\"minimum\":1,\"type\":\"integer\"},\"personal_data_stores\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"classification\":{\"minLength\":1,\"type\":\"string\"},\"consent_operation\":{\"minLength\":1,\"type\":\"string\"},\"deletion_operation\":{\"minLength\":1,\"type\":\"string\"},\"export_operation\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"pattern\":\"^[a-z][a-z0-9_-]*$\",\"type\":\"string\"},\"retention\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"id\",\"classification\",\"consent_operation\",\"retention\",\"export_operation\",\"deletion_operation\"],\"type\":\"object\"},\"type\":\"array\"},\"recipes\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"artifact_digest\":{\"$ref\":\"#/$defs/sha256\"},\"capability\":{\"pattern\":\"^[a-z][a-z0-9_-]*$\",\"type\":\"string\"},\"id\":{\"pattern\":\"^[a-z][a-z0-9_-]*$\",\"type\":\"string\"},\"version\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"id\",\"version\",\"capability\",\"artifact_digest\"],\"type\":\"object\"},\"type\":\"array\"},\"schema\":{\"const\":\"waaseyaa.site\"},\"verification\":{\"additionalProperties\":false,\"properties\":{\"command\":{\"const\":\"bin/maintenance/site-verify\"}},\"required\":[\"command\"],\"type\":\"object\"},\"version\":{\"const\":1}},\"required\":[\"schema\",\"version\",\"generator_version\",\"application\",\"framework\",\"content_types\",\"capabilities\",\"personal_data_stores\",\"recipes\",\"verification\"],\"title\":\"Waaseyaa site capability manifest\",\"type\":\"object\"}\n","mode":"0644","path":".waaseyaa/site.schema.json"},{"content":"\"application\":\n  \"canonical_origin\":\n    \"config_key\": \"APP_ORIGIN\"\n  \"id\": \"minimal-blueprint\"\n  \"name\": \"Minimal <info>Blueprint</info> Application\"\n\"application_blueprint\":\n  \"checks\": {  }\n  \"contract_version\": 1\n  \"entities\":\n    -\n      \"fields\":\n        -\n          \"cardinality\": 1\n          \"id\": \"title\"\n          \"indexed\": false\n          \"required\": false\n          \"revisionable\": false\n          \"translatable\": false\n          \"type\": \"string\"\n      \"id\": \"article\"\n      \"keys\":\n        \"id\": \"id\"\n        \"label\": \"title\"\n        \"uuid\": \"uuid\"\n      \"label\": \"Article\"\n      \"revisionable\": false\n      \"storage\": \"sql-blob\"\n      \"translatable\": false\n  \"fixtures\": {  }\n  \"permissions\": {  }\n  \"policies\": {  }\n  \"relationships\": {  }\n  \"roles\": {  }\n  \"workflows\": {  }\n\"capabilities\":\n  -\n    \"id\": \"payments\"\n    \"reason\": \"Payments are outside this application.\"\n    \"state\": \"not_needed\"\n\"content_types\":\n  -\n    \"canonical_route\": \"/articles/{slug}\"\n    \"id\": \"article\"\n\"framework\":\n  \"observed_lock_sha256\": \"ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356\"\n  \"revision_policy\": \"exact-lock\"\n\"generator_version\": 1\n\"personal_data_stores\": {  }\n\"recipes\": {  }\n\"schema\": \"waaseyaa.site\"\n\"verification\":\n  \"command\": \"bin/maintenance/site-verify\"\n\"version\": 1\n","mode":"0644","path":".waaseyaa/site.yaml"},{"content":"# Site contract\n\nThis application is governed by `.waaseyaa/site.yaml`.\n\nBefore changing application behavior:\n\n1. Read the capability manifest and its active, planned, and excluded decisions.\n2. Use the selected first-party Waaseyaa recipes and extension points.\n3. Run `tests/Architecture/SiteContractTest.php`.\n4. Run the strict site diagnostics.\n5. Run `bin/maintenance/site-verify` without network access.\n\nGenerated files are owned by `.waaseyaa/generated.json`. Regeneration refuses edits outside the extension region below.\n\n<!-- waaseyaa:extension:start local-guidance -->\n<!-- waaseyaa:extension:end local-guidance -->","extension_region":"local-guidance","mode":"0644","path":"AGENTS.md"},{"content":"#!/usr/bin/env php\n<?php\n\ndeclare(strict_types=1);\n\n$root = dirname(__DIR__, 2);\nif (!chdir($root)) {\n    fwrite(STDERR, \"site-verify: cannot enter the generated project root\\n\");\n    exit(2);\n}\n$runner = $root . '/vendor/bin/phpunit';\n$waaseyaa = $root . '/vendor/bin/waaseyaa';\nif (!is_file($runner)) {\n    fwrite(STDERR, \"site-verify: dependencies are not installed\\n\");\n    exit(2);\n}\nif (!is_file($waaseyaa)) {\n    fwrite(STDERR, \"site-verify: Waaseyaa CLI is not installed\\n\");\n    exit(2);\n}\n$doctor = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($waaseyaa)\n    . ' site:doctor --strict --format=json --project-root=' . escapeshellarg($root);\npassthru($doctor, $exitCode);\nif ($exitCode !== 0) {\n    exit($exitCode);\n}\n$tests = array (\n  0 => 'tests/Architecture/SiteContractTest.php',\n  1 => 'tests/Acceptance/SiteGoldenPathTest.php',\n);\nforeach ($tests as $test) {\n    $command = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($runner) . ' ' . escapeshellarg($root . '/' . $test) . ' --no-coverage';\n    passthru($command, $exitCode);\n    if ($exitCode !== 0) {\n        exit($exitCode);\n    }\n}\nexit(0);","mode":"0755","path":"bin/maintenance/site-verify"},{"content":"<?php\n\ndeclare(strict_types=1);\n\n// Generated by Waaseyaa\\CLI\\Site\\Blueprint\\ApplicationBlueprintCompiler.\n// One row per blueprint relationship. Consumed by the generated application\n// blueprint provider for referential integrity; do not edit by hand.\nreturn [];\n","mode":"0644","path":"config/waaseyaa-blueprint/relationships.php"},{"content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace App\\Entity;\n\nuse Waaseyaa\\Entity\\Attribute\\ContentEntityKeys;\nuse Waaseyaa\\Entity\\Attribute\\ContentEntityType;\nuse Waaseyaa\\Entity\\Attribute\\Field;\nuse Waaseyaa\\Entity\\ContentEntityBase;\n\n#[ContentEntityType(id: 'article', label: 'Article', storageBackend: 'sql-blob')]\n#[ContentEntityKeys(\n    id: 'id', uuid: 'uuid', label: 'title'\n)]\nfinal class Article extends ContentEntityBase\n{\n    #[Field(type: 'string', label: 'Title', required: false, translatable: false, revisionable: false)]\n    public string $title = '';\n}\n","mode":"0644","path":"src/Entity/Article.php"},{"content":"<?php\n\ndeclare(strict_types=1);\n\nnamespace App\\Provider;\n\nuse Waaseyaa\\Entity\\EntityType;\nuse Waaseyaa\\Foundation\\ServiceProvider\\ServiceProvider;\n\n/**\n * Generated by Waaseyaa\\CLI\\Site\\Blueprint\\ApplicationBlueprintCompiler.\n * Registers every governed application blueprint entity type; do not edit by\n * hand. The relationship registry consumed for referential integrity lives at\n * config/waaseyaa-blueprint/relationships.php.\n */\nfinal class ApplicationBlueprintServiceProvider extends ServiceProvider\n{\n    public function register(): void\n    {\n        $this->entityType(EntityType::fromClass(\n            \\App\\Entity\\Article::class,\n            revisionable: false,\n            translatable: false,\n        ));\n    }\n}\n","mode":"0644","path":"src/Provider/ApplicationBlueprintServiceProvider.php"},{"content":"<?php\n\ndeclare(strict_types=1);\n\nuse PHPUnit\\Framework\\TestCase;\nuse Waaseyaa\\SiteContract\\SiteManifestParser;\n\nfinal class SiteGoldenPathTest extends TestCase\n{\n    public function testProviderNeutralVerificationCommandIsDeclared(): void\n    {\n        $root = dirname(__DIR__, 2);\n        $manifest = new SiteManifestParser()->parse((string) file_get_contents($root . '/.waaseyaa/site.yaml'));\n        self::assertSame('bin/maintenance/site-verify', $manifest->verificationCommand);\n        self::assertFileExists($root . '/' . $manifest->verificationCommand);\n        // The property that matters is that the command is runnable\n        // PHP, which holds on every host. The execute bit is the\n        // POSIX expression of it: the file has no extension, and\n        // Windows resolves executability through PATHEXT, so\n        // is_executable() is false there for a perfectly good file.\n        self::assertStringStartsWith(\n            '#!/usr/bin/env php',\n            (string) file_get_contents($root . '/' . $manifest->verificationCommand),\n        );\n        if (DIRECTORY_SEPARATOR === '/') {\n            self::assertTrue(is_executable($root . '/' . $manifest->verificationCommand));\n        }\n    }\n}","mode":"0644","path":"tests/Acceptance/SiteGoldenPathTest.php"},{"content":"<?php\n\ndeclare(strict_types=1);\n\nuse PHPUnit\\Framework\\TestCase;\nuse Waaseyaa