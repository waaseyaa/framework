{
    "name": "waaseyaa/ai-tools",
    "description": "Shared agent-tool catalogue (#[AsAgentTool] + AttributeToolRegistry) used by AgentExecutor and the MCP endpoint",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "waaseyaa/access": "^0.1.0-alpha.290",
        "waaseyaa/entity": "^0.1.0-alpha.290",
        "waaseyaa/entity-storage": "^0.1.0-alpha.290",
        "waaseyaa/foundation": "^0.1.0-alpha.290",
        "waaseyaa/media": "^0.1.0-alpha.290",
        "waaseyaa/publishing": "^0.1.0-alpha.290"
    },
    "suggest": {
        "waaseyaa/search": "Provides principal-safe ranked CMS search tools and content resources"
    },
    "conflict": {
        "waaseyaa/search": "<0.1.0-alpha.287 || >=0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/search": "^0.1.0-alpha.290",
        "waaseyaa/testing": "^0.1.0-alpha.290"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\AI\\Tools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\AI\\Tools\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        },
        "waaseyaa": {
            "providers": [
                "Waaseyaa\\AI\\Tools\\AiToolsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        },
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../entity-storage"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../testing"
        },
        {
            "type": "path",
            "url": "../media"
        },
        {
            "type": "path",
            "url": "../publishing"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ]
}
