{
    "name": "waaseyaa/access",
    "description": "Access control and permission system for Waaseyaa",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../entity"
        },
        {
            "type": "path",
            "url": "../plugin"
        },
        {
            "type": "path",
            "url": "../foundation"
        },
        {
            "type": "path",
            "url": "../testing"
        },
        {
            "type": "path",
            "url": "../user"
        }
    ],
    "require": {
        "php": ">=8.5",
        "waaseyaa/entity": "^0.1.0-alpha.299",
        "waaseyaa/plugin": "^0.1.0-alpha.299",
        "waaseyaa/foundation": "^0.1.0-alpha.299",
        "symfony/http-foundation": "^7.0",
        "symfony/routing": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "waaseyaa/testing": "^0.1.0-alpha.299",
        "waaseyaa/user": "^0.1.0-alpha.299"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\Access\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\Access\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        },
        "waaseyaa": {
            "policies": [
                "Waaseyaa\\Access\\ConfigEntityAccessPolicy"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
