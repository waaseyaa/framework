{
    "name": "waaseyaa/page-builder",
    "description": "Governed, client-neutral page layout documents and validation for Waaseyaa.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "path",
            "url": "../access"
        }
    ],
    "require": {
        "php": ">=8.5",
        "opis/json-schema": "^2.6",
        "waaseyaa/access": "^0.1.0-alpha.298"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Waaseyaa\\PageBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waaseyaa\\PageBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev",
            "dev-develop/v1.1": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
