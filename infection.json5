{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.34.1/resources/schema.json",
    "source": {
        "directories": [
            "packages/access/src",
            "packages/api/src/Sanitizer",
            "packages/foundation/src/Audit/Approval",
            "packages/workflows/src/Binding",
            "packages/workflows/src/Listener"
        ]
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    },
    "timeout": 15,
    "mutators": {
        "@default": true
    }
}
