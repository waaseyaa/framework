{
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"},
    {"actor_id": 4630287, "actor_type": "Integration", "bypass_mode": "always"}
  ],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": ["refs/heads/main"]
    }
  },
  "rules": [
    {"type": "non_fast_forward"},
    {"type": "deletion"},
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "Frontend build", "integration_id": 15368},
          {"context": "Ingestion defaults", "integration_id": 15368},
          {"context": "Manifest conformance", "integration_id": 15368},
          {"context": "Release publish shape", "integration_id": 15368},
          {"context": "Security defaults", "integration_id": 15368},
          {"context": "check-dead-code", "integration_id": 15368},
          {"context": "ci/core-only-boot", "integration_id": 15368},
          {"context": "ci/coverage", "integration_id": 15368},
          {"context": "ci/lint", "integration_id": 15368},
          {"context": "ci/playwright-smoke", "integration_id": 15368},
          {"context": "ci/random-order", "integration_id": 15368},
          {"context": "ci/skeleton-create-project", "integration_id": 15368},
          {"context": "ci/unit-tests", "integration_id": 15368},
          {"context": "ci/verify-gates", "integration_id": 15368},
          {"context": "composer-policy", "integration_id": 15368},
          {"context": "packaged-form", "integration_id": 15368},
          {"context": "ci/package-isolation", "integration_id": 15368},
          {"context": "ci/mutation-pilot"},
          {"context": "ci/fresh-install-boot", "integration_id": 15368},
          {"context": "ci/frankenphp-worker", "integration_id": 15368},
          {"context": "ci/skeleton-create-project-windows", "integration_id": 15368},
          {"context": "ci/bimaaji-skill-resources", "integration_id": 15368}
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {"enabled": false, "allowed_actors": []},
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    }
  ]
}
