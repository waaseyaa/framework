{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://waaseyaa.org/schemas/delivery-agent-batch-v1.json",
    "title": "Waaseyaa delivery agent event batch v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "batch_id",
        "created_at",
        "producer",
        "events"
    ],
    "properties": {
        "schema_version": {
            "const": "delivery-agent-batch/v1"
        },
        "batch_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "name",
                "model"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "model": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "events": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object"
            }
        }
    }
}
