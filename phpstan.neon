includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - phpstan-baseline.neon
    - packages/entity/phpstan-rules.neon

parameters:
    level: 5
    phpVersion: 80500
    tmpDir: tmp/phpstan
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    paths:
        # Roster-wide coverage: a new package is analysed without a hand-edited
        # list. PHPStan only scans PHP files; tests and the Nuxt source are
        # excluded explicitly below.
        - packages
    excludePaths:
        analyseAndScan:
            - packages/*/tests/*
            - packages/*/testing/*
            - packages/*/migrations/*
            - packages/*/scripts/*
            - packages/*/config/*
            - packages/admin/*
            # Recipe-only package; deployphp's global DSL functions need
            # project-specific stubs and there is no PSR-4 src/ tree.
            - packages/deployer/recipe/*
