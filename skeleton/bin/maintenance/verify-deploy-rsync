#!/usr/bin/env bash
# Fail CI when deploy rsync or export exclusions drift from the canonical policy (#2648).
# See docs/specs/distribution-exclusion-policy.md and docs/specs/per-site-convergence-audit.md.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

FRAMEWORK_ROOT=""
if [[ -f "$ROOT/../bin/check-distribution-exclusion" ]]; then
    FRAMEWORK_ROOT="$(cd "$ROOT/.." && pwd)"
elif [[ -f "$ROOT/vendor/waaseyaa/framework/bin/check-distribution-exclusion" ]]; then
    FRAMEWORK_ROOT="$ROOT/vendor/waaseyaa/framework"
fi

if [[ -n "$FRAMEWORK_ROOT" ]]; then
    php "$FRAMEWORK_ROOT/bin/check-distribution-exclusion" \
        --root="$FRAMEWORK_ROOT" \
        --deploy-only \
        --deploy-root="$ROOT"
    echo "verify-deploy-rsync: OK (policy surfaces)"
    exit 0
fi

# Fallback for a skeleton-only checkout without the framework gate.
if [[ ! -d .github/workflows ]]; then
    echo "verify-deploy-rsync: skip (no .github/workflows)"
    exit 0
fi

bad=0
shopt -s nullglob
for wf in .github/workflows/*.yml .github/workflows/*.yaml; do
    [[ -f "$wf" ]] || continue
    if grep -qE -- "--exclude=['\"]docs/" "$wf"; then
        echo "verify-deploy-rsync: ERROR: $wf uses unanchored --exclude='docs/' (use --exclude='/docs/' for repo-root docs only)." >&2
        bad=1
    fi
done

if [[ $bad -ne 0 ]]; then
    if [[ -d templates/docs ]]; then
        echo "verify-deploy-rsync: This repo has templates/docs/; an unanchored exclude would omit it from deploy artifacts." >&2
    fi
    exit 1
fi

echo "verify-deploy-rsync: OK"
