#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Native-host contract evidence (#2678, FW-2678-NATIVE-HOST-CONTRACT-01).
 *
 *   php bin/native-host-evidence collect --host=<linux|windows> --out=<file>
 *   php bin/native-host-evidence verify-set --dir=<directory> --hosts=linux,windows
 *
 * `collect` runs in each leaf of the `native-host-contract` CI matrix after
 * the contract steps. It reads the governed step results from
 * NATIVE_HOST_STEP_RESULTS, the hosted shell from NATIVE_HOST_SHELL and
 * NATIVE_HOST_SHELL_VERSION, the runner label from NATIVE_HOST_RUNNER_LABEL,
 * the dispatch and pull-request SHAs from NATIVE_HOST_DISPATCH_SHA and
 * NATIVE_HOST_PR_HEAD_SHA, and GitHub's own run variables. It always writes
 * the evidence record, then exits:
 *
 *   0  every contract step, log, identity and rendering check passed
 *   1  a violation: a failed, skipped or unexecuted step, a skipped,
 *      incomplete or missing test, a runtime outside the contract, or a
 *      mismatched subject
 *   2  the harness could not run (bad arguments or contract)
 *   3  incomplete: a runtime, runner, shell or source identity could not be
 *      resolved. Never a pass.
 *
 * `verify-set` runs in the ci/native-host-contract gate and exits 0 only for
 * exactly one passing record per contract host, all bound to the verifier's
 * checkout, contract digest and run.
 *
 * Consumer CLI evidence (FW-2678-NATIVE-HOST-SKELETON-CLI-02):
 *
 *   php bin/native-host-evidence consumer-collect --host=<linux|windows> --out=<file>
 *   php bin/native-host-evidence consumer-verify-set --dir=<directory> --hosts=linux,windows
 *
 * `consumer-collect` runs in site-reference-consumer (Linux) and
 * ci/skeleton-create-project-windows after each lane's consumer completed
 * site:init and install:init and ran the contract's consumer_cli command. It
 * additionally reads WAASEYAA_CONSUMER_ROOT, NATIVE_HOST_CLI_STDOUT and, for
 * the Linux harness, WAASEYAA_CONSUMER_CANDIDATE_REVISION,
 * WAASEYAA_CONSUMER_PROJECT_SOURCE and WAASEYAA_CONSUMER_PROJECT_REVISION, and
 * uses the same exit codes. `consumer-verify-set` runs in the
 * ci/native-host-consumer-cli gate and exits 0 only for exactly one passing
 * Linux and one passing Windows record from this run, bound to one subject,
 * one candidate and an equivalent installed package cohort.
 *
 * This tool validates hosted evidence. It is not a test runner and selects
 * nothing: the workflow executes every command.
 */

require_once __DIR__ . '/lib/native-host-consumer-evidence.php';

$root = dirname(__DIR__);
$arguments = array_slice($argv, 1);
$action = array_shift($arguments);
$options = [];
foreach ($arguments as $argument) {
    if (preg_match('/^--([a-z-]+)=(.+)$/', $argument, $match) !== 1) {
        fwrite(STDERR, "native-host-evidence: options take the form --name=value: {$argument}\n");
        exit(NHE_EXIT_HARNESS);
    }
    $options[$match[1]] = $match[2];
}

$runner = static fn(array $command): ?string => repository_bounded_output($command, 60.0, 65536);
$head = static function () use ($root): ?string {
    $output = repository_bounded_output([...repository_git_command($root), '-C', $root, 'rev-parse', '--verify', 'HEAD^{commit}'], 30.0);

    return is_string($output) && preg_match('/^[0-9a-f]{40}$/D', trim($output)) === 1 ? trim($output) : null;
};

try {
    $contract = nhe_load_contract($options['contract'] ?? $root . '/tools/native-host-contract.json');

    if ($action === 'collect') {
        $host = $options['host'] ?? '';
        $out = $options['out'] ?? '';
        if (!isset($contract['hosts'][$host]) || $out === '') {
            fwrite(STDERR, "native-host-evidence: collect needs --host=<contract host> and --out=<file>\n");
            exit(NHE_EXIT_HARNESS);
        }
        $collected = nhe_collect($contract, $host, $root, getenv(), $runner, $head());
        $directory = dirname($out);
        if (!is_dir($directory) && !mkdir($directory, 0o777, true) && !is_dir($directory)) {
            throw new RuntimeException("cannot create {$directory}");
        }
        file_put_contents($out, json_encode($collected['evidence'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
        fwrite(STDOUT, "native-host evidence for {$host}: {$collected['evidence']['result']} ({$out})\n");
        foreach ($collected['evidence']['violations'] as $violation) {
            fwrite(STDERR, "VIOLATION {$violation}\n");
        }
        foreach ($collected['evidence']['incomplete'] as $missing) {
            fwrite(STDERR, "INCOMPLETE {$missing}\n");
        }
        exit($collected['exit']);
    }

    if ($action === 'verify-set') {
        $directory = $options['dir'] ?? '';
        $hosts = array_values(array_filter(explode(',', $options['hosts'] ?? '')));
        if ($directory === '' || $hosts === []) {
            fwrite(STDERR, "native-host-evidence: verify-set needs --dir=<directory> and --hosts=<h1,h2>\n");
            exit(NHE_EXIT_HARNESS);
        }
        $verified = nhe_verify_set($directory, $hosts, $contract, getenv(), $head());
        foreach ($verified['hosts'] as $host => $result) {
            fwrite(STDOUT, "native-host evidence {$host}: {$result}\n");
        }
        foreach ($verified['violations'] as $violation) {
            fwrite(STDERR, "VIOLATION {$violation}\n");
        }
        fwrite(STDOUT, $verified['exit'] === NHE_EXIT_PASS ? "native-host evidence set verified\n" : "native-host evidence set rejected\n");
        exit($verified['exit']);
    }

    if ($action === 'consumer-collect') {
        $contract = nhc_load_contract($options['contract'] ?? $root . '/tools/native-host-contract.json');
        $host = $options['host'] ?? '';
        $out = $options['out'] ?? '';
        if (!isset($contract['consumer_cli']['lanes'][$host]) || $out === '') {
            fwrite(STDERR, "native-host-evidence: consumer-collect needs --host=<consumer lane> and --out=<file>\n");
            exit(NHE_EXIT_HARNESS);
        }
        $git = static fn(array $arguments): ?string => repository_bounded_output(
            [...repository_git_command($root), '-C', $root, ...$arguments],
            120.0,
            64 * 1024 * 1024,
        );
        $collected = nhc_collect($contract, $host, $root, getenv(), $runner, $git, $head());
        $directory = dirname($out);
        if (!is_dir($directory) && !mkdir($directory, 0o777, true) && !is_dir($directory)) {
            throw new RuntimeException("cannot create {$directory}");
        }
        file_put_contents($out, json_encode($collected['evidence'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
        fwrite(STDOUT, "native-host consumer evidence for {$host}: {$collected['evidence']['result']} ({$out})\n");
        foreach ($collected['evidence']['violations'] as $violation) {
            fwrite(STDERR, "VIOLATION {$violation}\n");
        }
        foreach ($collected['evidence']['incomplete'] as $missing) {
            fwrite(STDERR, "INCOMPLETE {$missing}\n");
        }
        exit($collected['exit']);
    }

    if ($action === 'consumer-verify-set') {
        $contract = nhc_load_contract($options['contract'] ?? $root . '/tools/native-host-contract.json');
        $directory = $options['dir'] ?? '';
        $hosts = array_values(array_filter(explode(',', $options['hosts'] ?? '')));
        if ($directory === '' || $hosts === []) {
            fwrite(STDERR, "native-host-evidence: consumer-verify-set needs --dir=<directory> and --hosts=<h1,h2>\n");
            exit(NHE_EXIT_HARNESS);
        }
        $verified = nhc_verify_set($directory, $hosts, $contract, getenv(), $head());
        foreach ($verified['hosts'] as $host => $result) {
            fwrite(STDOUT, "native-host consumer evidence {$host}: {$result}\n");
        }
        foreach ($verified['violations'] as $violation) {
            fwrite(STDERR, "VIOLATION {$violation}\n");
        }
        fwrite(STDOUT, $verified['exit'] === NHE_EXIT_PASS ? "native-host consumer evidence set verified\n" : "native-host consumer evidence set rejected\n");
        exit($verified['exit']);
    }

    fwrite(STDERR, "native-host-evidence: the action must be collect, verify-set, consumer-collect or consumer-verify-set\n");
    exit(NHE_EXIT_HARNESS);
} catch (Throwable $exception) {
    fwrite(STDERR, 'native-host-evidence: ' . $exception->getMessage() . "\n");
    exit(NHE_EXIT_HARNESS);
}
