#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer policy gate. See CLAUDE.md "CI Gates".

$repoRoot = dirname(__DIR__);
$root = getenv('ROOT_DIR');
$rootDir = is_string($root) && $root !== '' ? $root : $repoRoot;
$rootDir = str_replace('\\', '/', rtrim($rootDir, "\\/"));

if (getenv('WAASEYAA_OUTPUT') === 'json' || in_array('--output=json', array_slice($argv, 1), true)) {
    fwrite(STDERR, "check-composer-policy: --output=json is no longer supported; use the human gate output.\n");
    exit(2);
}

$policyId = [
    'sort_packages' => 'CP001',
    'dev_scope' => 'CP002',
    'no_wildcard_internal' => 'CP003',
    'core_runtime_surface' => 'CP004',
    'tight_internal_floor' => 'CP005',
    'self_version_scope' => 'CP006',
    'path_repository_parity' => 'CP007',
    'path_lock_dependency_keys' => 'CP008',
    'development_plane_containment' => 'CP009',
];

$errors = 0;
$tightFloorPattern = '/-(alpha|beta|rc|dev)\./';

$emit = static function (string $line = ''): void {
    echo $line . PHP_EOL;
};

$emitErr = static function (string $line): void {
    fwrite(STDERR, $line . PHP_EOL);
};

$fail = static function (
    string $ruleKey,
    string $relPath,
    string $current,
    string $expected,
) use (&$errors, $policyId, $emit): void {
    $ruleCode = $policyId[$ruleKey];
    $errors++;
    $emit(sprintf('FAIL [%s] %s', $ruleCode, $relPath));
    $emit(sprintf('  current: %s', $current));
    $emit(sprintf('  expected: %s', $expected));
};

$failCpNew = static function (
    string $relPath,
    string $pkg,
    string $actual,
    string $expected,
) use (&$errors, $emit): void {
    $errors++;
    $emit(sprintf('FAIL [CP-NEW] %s', $relPath));
    $emit(sprintf('  package:  %s', $pkg));
    $emit(sprintf('  actual:   %s', $actual));
    $emit(sprintf('  expected: %s', $expected));
    $emit('  fix:      run bin/sync-internal-versions after tagging, or run WP04 backfill');
};

$expectedVersion = null;
$cpNewWarning = null;
$trackedVersionPath = $rootDir . '/VERSION';
$versionLib = __DIR__ . '/lib/internal-version-sync.php';
if (is_file($versionLib)) {
    require_once $versionLib;
    try {
        $expectedVersion = resolveRepositoryVersion($rootDir);
    } catch (RuntimeException $e) {
        if (is_file($trackedVersionPath)) {
            $errors++;
            $emit('FAIL [CP-NEW] VERSION');
            $emit(sprintf('  current: %s', $e->getMessage()));
            $emit('  expected: a valid tracked semantic version (for example 0.1.0-alpha.293)');
        } else {
            $cpNewWarning = sprintf(
                'CP-NEW skipped: repository version resolution failed (%s). Add a valid VERSION file or run in a repo with at least one vX.Y.Z tag.',
                $e->getMessage(),
            );
        }
    }
} else {
    $cpNewWarning = 'CP-NEW skipped: bin/lib/internal-version-sync.php is missing.';
}

$manifestPaths = [];
$rootIterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($rootDir, FilesystemIterator::SKIP_DOTS),
);

foreach ($rootIterator as $file) {
    if (!$file instanceof SplFileInfo || $file->getFilename() !== 'composer.json') {
        continue;
    }

    $path = str_replace('\\', '/', $file->getPathname());
    $rel = relativePath($rootDir, $path);
    if (isExcluded($rel)) {
        continue;
    }

    if (
        $rel === 'composer.json'
        || str_starts_with($rel, 'packages/')
        || str_starts_with($rel, 'examples/')
        || str_starts_with($rel, 'docs/examples/')
        || $rel === 'skeleton/composer.json'
    ) {
        $manifestPaths[] = $path;
    }
}

sort($manifestPaths);

foreach ($manifestPaths as $path) {
    $rel = relativePath($rootDir, $path);
    $data = readComposerJson($path);

    $config = is_array($data['config'] ?? null) ? $data['config'] : [];
    $sortPackages = $config['sort-packages'] ?? null;
    if ($sortPackages !== true) {
        $fail(
            'sort_packages',
            $rel,
            'config.sort-packages=' . var_export($sortPackages, true),
            'config.sort-packages=true',
        );
    }

    foreach (['require', 'require-dev'] as $sectionName) {
        $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
        foreach ($section as $pkg => $version) {
            if (!is_string($pkg) || !is_string($version) || !str_starts_with($pkg, 'waaseyaa/')) {
                continue;
            }

            if ($version === '@dev' && ($rel === 'composer.json' || str_starts_with($rel, 'packages/'))) {
                $fail(
                    'dev_scope',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    '@dev forbidden - root must use self.version, packages/* must use an explicit semver range',
                );
            }

            if ($version === 'self.version' && $rel !== 'composer.json') {
                $fail(
                    'self_version_scope',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'self.version is only valid in the root composer.json (waaseyaa/framework metapackage); use an explicit semver range here',
                );
            }

            if (str_contains($version, '*')) {
                $fail(
                    'no_wildcard_internal',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'use an explicit pre-release-anchored range (for example ^0.1.0-alpha.150)',
                );
            }

            if (
                $rel !== 'composer.json'
                && $version !== '@dev'
                && $version !== 'self.version'
                && !str_contains($version, '*')
                && preg_match($tightFloorPattern, $version) !== 1
            ) {
                $fail(
                    'tight_internal_floor',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'anchor to a pre-release floor (for example ^0.1.0-alpha.150) so Composer cannot resolve a stale sibling missing required methods',
                );
            }
        }
    }

    if ($rel === 'packages/core/composer.json') {
        $require = is_array($data['require'] ?? null) ? $data['require'] : [];
        foreach (['waaseyaa/debug', 'waaseyaa/telescope', 'waaseyaa/testing'] as $forbiddenPkg) {
            if (array_key_exists($forbiddenPkg, $require)) {
                $fail(
                    'core_runtime_surface',
                    $rel,
                    sprintf('%s in require', $forbiddenPkg),
                    sprintf('move %s to suggest (core runtime must remain install-safe)', $forbiddenPkg),
                );
            }
        }
    }

    if (str_starts_with($rel, 'packages/')) {
        $internalRequirements = [];
        foreach (['require', 'require-dev'] as $sectionName) {
            $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
            foreach (array_keys($section) as $packageName) {
                if (is_string($packageName) && str_starts_with($packageName, 'waaseyaa/')) {
                    $internalRequirements[$packageName] = true;
                }
            }
        }

        $pathRepositories = [];
        $repositories = is_array($data['repositories'] ?? null) ? $data['repositories'] : [];
        foreach ($repositories as $repository) {
            if (!is_array($repository) || ($repository['type'] ?? null) !== 'path') {
                continue;
            }

            $url = $repository['url'] ?? null;
            if (!is_string($url) || $url === '') {
                continue;
            }

            $targetManifest = dirname($path) . '/' . $url . '/composer.json';
            if (!is_file($targetManifest)) {
                $fail(
                    'path_repository_parity',
                    $rel,
                    sprintf('path repository %s has no readable composer.json', $url),
                    'every package path repository must resolve to a first-party package manifest',
                );
                continue;
            }

            $targetData = readComposerJson($targetManifest);
            $targetName = $targetData['name'] ?? null;
            if (!is_string($targetName) || !str_starts_with($targetName, 'waaseyaa/')) {
                $fail(
                    'path_repository_parity',
                    $rel,
                    sprintf('path repository %s does not identify a waaseyaa/* package', $url),
                    'path repository target composer.json must name the corresponding waaseyaa/* package',
                );
                continue;
            }
            $pathRepositories[$targetName] = true;
        }

        foreach (array_keys(array_diff_key($internalRequirements, $pathRepositories)) as $packageName) {
            $fail(
                'path_repository_parity',
                $rel,
                sprintf('%s required without a matching path repository', $packageName),
                sprintf('add a path repository for %s', $packageName),
            );
        }
        foreach (array_keys(array_diff_key($pathRepositories, $internalRequirements)) as $packageName) {
            $fail(
                'path_repository_parity',
                $rel,
                sprintf('%s path repository has no matching requirement', $packageName),
                sprintf('remove the stale path repository or require %s', $packageName),
            );
        }
    }
}

// ---------------------------------------------------------------------------
// CP009 — development-plane containment (ADR-022 D-1.2, D-3.0, D-10).
//
// The local AI-development plane must stay outside every production install.
// Two packages carry that obligation:
//
//   - `waaseyaa/ai-development` is a require-dev metapackage. D-1.2: it MUST
//     NOT appear in the `require` block of waaseyaa/framework, core, cms, or
//     full; consumers opt in by name. D-1.3: the skeleton installs it under
//     require-dev only.
//   - `waaseyaa/ai-agent` homes `LocalOperatorPrincipal` (D-3.0). The ADR is
//     explicit that the package name is "merely today's satisfying answer" and
//     the *invariant* is normative: the homing package must be absent from the
//     production require closure of all four manifests. D-3.0a is equally
//     explicit that packaging is the weaker of the two controls — the runtime
//     refusal is the real one — but D-10 still requires this half to be gated,
//     because "a routine dependency edit is enough to void it silently: the
//     edit would look like adding a require, not like relocating a
//     security-sensitive class into production".
//
// Why this gate is hosted here rather than in `bin/check-package-layers`:
// the invariant is a *manifest closure* property, not a layer property. An
// edge from `waaseyaa/full` to `waaseyaa/ai-agent` breaks no layer rule at
// all, and three of the four production roots are metapackages, which
// check-package-layers deliberately skips before it looks at anything else.
// This script, by contrast, already reads the root manifest and every
// packages/* manifest, and already owns a "this package must not appear in
// that require block" rule (CP004, core's install-safe runtime surface).
// CP009 is that same shape, generalized from one require block to a closure.
//
// The traversal follows `require` only, and only from the four production
// roots. `packages/ai-development/composer.json` is never a traversal root and
// is never reached from one (its own containment is checked below), so the dev
// metapackage's own require of `waaseyaa/ai-agent` is invisible here — the
// gate cannot trip on the very graph it exists to keep separate.
//
// The seeded positive control lives in
// tests/Architecture/DevelopmentPlaneClosureGateTest.php: it plants real
// dependency edges into a disposable fixture root (via ROOT_DIR) and asserts
// CP009 goes red for each one. A closure gate never observed failing proves
// nothing.
$productionRoots = [
    'composer.json',
    'packages/core/composer.json',
    'packages/cms/composer.json',
    'packages/full/composer.json',
];

/** package => why it must stay out of production */
$developmentPlanePackages = [
    'waaseyaa/ai-development' => 'the require-dev development metapackage (ADR-022 D-1.2)',
    'waaseyaa/ai-agent' => 'the package homing LocalOperatorPrincipal (ADR-022 D-3.0)',
];

// Non-vacuity anchor. Every production root that declares any `waaseyaa/*`
// require reaches foundation — `packages/cms` and `packages/full` only
// transitively, which is what makes this bind the *walk* and not just the
// first hop. If such a closure stops reaching it, the traversal is broken and
// a green result would be an artefact rather than a finding.
//
// A manifest with no `waaseyaa/*` require at all is skipped rather than
// failed: its closure is empty because there is genuinely nothing to contain,
// not because the walk broke. That case is real — this script accepts a
// `ROOT_DIR` override, and the fixture roots in
// tests/Integration/Policy/CheckComposerPolicyTest.php and
// tests/Integration/ReleaseTooling/CpNewCheckTest.php are exactly it.
$closureAnchor = 'waaseyaa/foundation';

foreach ($productionRoots as $rootManifest) {
    if (!is_file($rootDir . '/' . $rootManifest)) {
        continue;
    }

    $closure = waaseyaaRequireClosure($rootDir, $rootManifest);

    if ($closure !== [] && !isset($closure[$closureAnchor])) {
        $fail(
            'development_plane_containment',
            $rootManifest,
            sprintf(
                'the production require closure reached %d waaseyaa/* package(s) and not %s',
                count($closure),
                $closureAnchor,
            ),
            'a working closure traversal — a closure that cannot reach foundation cannot prove containment either',
        );
        continue;
    }

    foreach ($developmentPlanePackages as $contained => $why) {
        if (!isset($closure[$contained])) {
            continue;
        }

        $fail(
            'development_plane_containment',
            $rootManifest,
            sprintf('%s reaches %s via %s', $rootManifest, $contained, implode(' -> ', $closure[$contained])),
            sprintf(
                '%s must stay outside every production require closure — %s. Revert the dependency edit, '
                . 'or (ADR-022 D-3.0) relocate the principal to a package that still satisfies the invariant',
                $contained,
                $why,
            ),
        );
    }
}

// D-1.2 / D-1.3, checked directly rather than only through the closure: the
// development metapackage belongs in `require-dev`, in any first-party
// manifest that names it at all.
foreach ($manifestPaths as $path) {
    $rel = relativePath($rootDir, $path);
    $require = readComposerJson($path)['require'] ?? [];
    if (is_array($require) && array_key_exists('waaseyaa/ai-development', $require)) {
        $fail(
            'development_plane_containment',
            $rel,
            'waaseyaa/ai-development in require',
            'move it to require-dev — ADR-022 D-1.3: the development plane is installed as a development '
            . 'dependency only, so `composer install --no-dev` removes it and everything it pulls',
        );
    }
}

if ($cpNewWarning !== null) {
    $emitErr('WARNING [CP-NEW] ' . $cpNewWarning);
} elseif ($expectedVersion !== null) {
    $expectedConstraint = '^' . $expectedVersion;
    foreach ($manifestPaths as $path) {
        $rel = relativePath($rootDir, $path);
        if (!str_starts_with($rel, 'packages/')) {
            continue;
        }

        $data = readComposerJson($path);
        foreach (['require', 'require-dev'] as $sectionName) {
            $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
            foreach ($section as $pkg => $version) {
                if (
                    is_string($pkg)
                    && is_string($version)
                    && str_starts_with($pkg, 'waaseyaa/')
                    && $version !== $expectedConstraint
                    && preg_match($tightFloorPattern, $version) === 1
                ) {
                    $failCpNew($rel, $pkg, $version, $expectedConstraint);
                }
            }
        }
    }
}

// Composer copies each path package's production `require` metadata into the
// root lock. The release constraint sweep refuses structural key drift, so run
// its read-only comparator during ordinary CI instead of discovering drift
// only after a release cut has started.
$rootLockPath = $rootDir . '/composer.lock';
if (is_file($rootLockPath) && function_exists('findRootLockDependencyKeyDrift')) {
    try {
        $dependencyKeyDrift = findRootLockDependencyKeyDrift(
            $rootLockPath,
            discoverSyncManifests($rootDir),
        );
        foreach ($dependencyKeyDrift as $drift) {
            $fail(
                'path_lock_dependency_keys',
                'composer.lock',
                sprintf(
                    '%s missing=[%s] extra=[%s]',
                    $drift['package'],
                    implode(', ', $drift['missing']),
                    implode(', ', $drift['extra']),
                ),
                'production require keys must match the package manifest; regenerate with Composer',
            );
        }
    } catch (RuntimeException $e) {
        $fail(
            'path_lock_dependency_keys',
            'composer.lock',
            $e->getMessage(),
            'a readable root lock with path-package dependency metadata',
        );
    }
}

if ($errors === 0) {
    echo 'OK: Composer policy checks passed' . PHP_EOL;
    exit(0);
}

echo sprintf('Composer policy check failed with %d violation(s)', $errors) . PHP_EOL;
exit(1);

function relativePath(string $rootDir, string $path): string
{
    $root = rtrim(str_replace('\\', '/', $rootDir), '/') . '/';
    $normalized = str_replace('\\', '/', $path);

    if (str_starts_with($normalized, $root)) {
        return substr($normalized, strlen($root));
    }

    return $normalized;
}

function isExcluded(string $rel): bool
{
    $parts = explode('/', $rel);

    return in_array('vendor', $parts, true)
        || in_array('node_modules', $parts, true)
        || str_starts_with($rel, '.worktrees/');
}

/**
 * The transitive `waaseyaa/*` **runtime** require closure of one manifest.
 *
 * `require` only: `require-dev` is not installed by a consumer and is the whole
 * mechanism by which the development plane stays out of production (ADR-022
 * D-1.3). Each entry maps the reached package to the manifest chain that
 * reached it, so a CP009 failure can name the edit that caused it rather than
 * only its consequence.
 *
 * @return array<string, list<string>> package => path from the root manifest
 */
function waaseyaaRequireClosure(string $rootDir, string $manifestRelative): array
{
    $reached = [];
    $queue = [];

    foreach (array_keys(readComposerJson($rootDir . '/' . $manifestRelative)['require'] ?? []) as $dependency) {
        if (is_string($dependency) && str_starts_with($dependency, 'waaseyaa/')) {
            $queue[] = [$dependency, [$manifestRelative, $dependency]];
        }
    }

    while ($queue !== []) {
        /** @var array{0: string, 1: list<string>} $entry */
        $entry = array_shift($queue);
        [$package, $chain] = $entry;
        if (isset($reached[$package])) {
            continue;
        }
        $reached[$package] = $chain;

        $childPath = $rootDir . '/packages/' . substr($package, strlen('waaseyaa/')) . '/composer.json';
        if (!is_file($childPath)) {
            continue;
        }
        foreach (array_keys(readComposerJson($childPath)['require'] ?? []) as $dependency) {
            if (is_string($dependency) && str_starts_with($dependency, 'waaseyaa/') && !isset($reached[$dependency])) {
                $queue[] = [$dependency, [...$chain, $dependency]];
            }
        }
    }

    return $reached;
}

/**
 * @return array<string, mixed>
 */
function readComposerJson(string $path): array
{
    $raw = file_get_contents($path);
    if ($raw === false) {
        throw new RuntimeException(sprintf('Unable to read %s', $path));
    }

    $data = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new RuntimeException(sprintf('%s must decode to a JSON object', $path));
    }

    return $data;
}
