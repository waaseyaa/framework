#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer policy gate. See CLAUDE.md "CI Gates".

$repoRoot = dirname(__DIR__);
$root = getenv('ROOT_DIR');
$rootDir = is_string($root) && $root !== '' ? $root : $repoRoot;
$rootDir = str_replace('\\', '/', rtrim($rootDir, "\\/"));

if (getenv('WAASEYAA_OUTPUT') === 'json' || in_array('--output=json', array_slice($argv, 1), true)) {
    fwrite(STDERR, "check-composer-policy: --output=json is no longer supported; use the human gate output.\n");
    exit(2);
}

$policyId = [
    'sort_packages' => 'CP001',
    'dev_scope' => 'CP002',
    'no_wildcard_internal' => 'CP003',
    'core_runtime_surface' => 'CP004',
    'tight_internal_floor' => 'CP005',
    'self_version_scope' => 'CP006',
    'path_repository_parity' => 'CP007',
];

$errors = 0;
$tightFloorPattern = '/-(alpha|beta|rc|dev)\./';

$emit = static function (string $line = ''): void {
    echo $line . PHP_EOL;
};

$emitErr = static function (string $line): void {
    fwrite(STDERR, $line . PHP_EOL);
};

$fail = static function (
    string $ruleKey,
    string $relPath,
    string $current,
    string $expected,
) use (&$errors, $policyId, $emit): void {
    $ruleCode = $policyId[$ruleKey];
    $errors++;
    $emit(sprintf('FAIL [%s] %s', $ruleCode, $relPath));
    $emit(sprintf('  current: %s', $current));
    $emit(sprintf('  expected: %s', $expected));
};

$failCpNew = static function (
    string $relPath,
    string $pkg,
    string $actual,
    string $expected,
) use (&$errors, $emit): void {
    $errors++;
    $emit(sprintf('FAIL [CP-NEW] %s', $relPath));
    $emit(sprintf('  package:  %s', $pkg));
    $emit(sprintf('  actual:   %s', $actual));
    $emit(sprintf('  expected: %s', $expected));
    $emit('  fix:      run bin/sync-internal-versions after tagging, or run WP04 backfill');
};

$expectedVersion = null;
$cpNewWarning = null;
$versionLib = __DIR__ . '/lib/internal-version-sync.php';
if (is_file($versionLib)) {
    require_once $versionLib;
    try {
        $expectedVersion = resolveCurrentVersion($rootDir);
    } catch (RuntimeException $e) {
        $cpNewWarning = sprintf(
            'CP-NEW skipped: git tag resolution failed (%s). Run in a repo with at least one vX.Y.Z tag to enable this check.',
            $e->getMessage(),
        );
    }
} else {
    $cpNewWarning = 'CP-NEW skipped: bin/lib/internal-version-sync.php is missing.';
}

$manifestPaths = [];
$rootIterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($rootDir, FilesystemIterator::SKIP_DOTS),
);

foreach ($rootIterator as $file) {
    if (!$file instanceof SplFileInfo || $file->getFilename() !== 'composer.json') {
        continue;
    }

    $path = str_replace('\\', '/', $file->getPathname());
    $rel = relativePath($rootDir, $path);
    if (isExcluded($rel)) {
        continue;
    }

    if (
        $rel === 'composer.json'
        || str_starts_with($rel, 'packages/')
        || str_starts_with($rel, 'examples/')
        || str_starts_with($rel, 'docs/examples/')
        || $rel === 'skeleton/composer.json'
    ) {
        $manifestPaths[] = $path;
    }
}

sort($manifestPaths);

foreach ($manifestPaths as $path) {
    $rel = relativePath($rootDir, $path);
    $data = readComposerJson($path);

    $config = is_array($data['config'] ?? null) ? $data['config'] : [];
    $sortPackages = $config['sort-packages'] ?? null;
    if ($sortPackages !== true) {
        $fail(
            'sort_packages',
            $rel,
            'config.sort-packages=' . var_export($sortPackages, true),
            'config.sort-packages=true',
        );
    }

    foreach (['require', 'require-dev'] as $sectionName) {
        $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
        foreach ($section as $pkg => $version) {
            if (!is_string($pkg) || !is_string($version) || !str_starts_with($pkg, 'waaseyaa/')) {
                continue;
            }

            if ($version === '@dev' && ($rel === 'composer.json' || str_starts_with($rel, 'packages/'))) {
                $fail(
                    'dev_scope',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    '@dev forbidden - root must use self.version, packages/* must use an explicit semver range',
                );
            }

            if ($version === 'self.version' && $rel !== 'composer.json') {
                $fail(
                    'self_version_scope',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'self.version is only valid in the root composer.json (waaseyaa/framework metapackage); use an explicit semver range here',
                );
            }

            if (str_contains($version, '*')) {
                $fail(
                    'no_wildcard_internal',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'use an explicit pre-release-anchored range (for example ^0.1.0-alpha.150)',
                );
            }

            if (
                $rel !== 'composer.json'
                && $version !== '@dev'
                && $version !== 'self.version'
                && !str_contains($version, '*')
                && preg_match($tightFloorPattern, $version) !== 1
            ) {
                $fail(
                    'tight_internal_floor',
                    $rel,
                    sprintf('%s=%s', $pkg, $version),
                    'anchor to a pre-release floor (for example ^0.1.0-alpha.150) so Composer cannot resolve a stale sibling missing required methods',
                );
            }
        }
    }

    if ($rel === 'packages/core/composer.json') {
        $require = is_array($data['require'] ?? null) ? $data['require'] : [];
        foreach (['waaseyaa/debug', 'waaseyaa/telescope', 'waaseyaa/testing'] as $forbiddenPkg) {
            if (array_key_exists($forbiddenPkg, $require)) {
                $fail(
                    'core_runtime_surface',
                    $rel,
                    sprintf('%s in require', $forbiddenPkg),
                    sprintf('move %s to suggest (core runtime must remain install-safe)', $forbiddenPkg),
                );
            }
        }
    }

    if (str_starts_with($rel, 'packages/')) {
        $internalRequirements = [];
        foreach (['require', 'require-dev'] as $sectionName) {
            $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
            foreach (array_keys($section) as $packageName) {
                if (is_string($packageName) && str_starts_with($packageName, 'waaseyaa/')) {
                    $internalRequirements[$packageName] = true;
                }
            }
        }

        $pathRepositories = [];
        $repositories = is_array($data['repositories'] ?? null) ? $data['repositories'] : [];
        foreach ($repositories as $repository) {
            if (!is_array($repository) || ($repository['type'] ?? null) !== 'path') {
                continue;
            }

            $url = $repository['url'] ?? null;
            if (!is_string($url) || $url === '') {
                continue;
            }

            $targetManifest = dirname($path) . '/' . $url . '/composer.json';
            if (!is_file($targetManifest)) {
                $fail(
                    'path_repository_parity',
                    $rel,
                    sprintf('path repository %s has no readable composer.json', $url),
                    'every package path repository must resolve to a first-party package manifest',
                );
                continue;
            }

            $targetData = readComposerJson($targetManifest);
            $targetName = $targetData['name'] ?? null;
            if (!is_string($targetName) || !str_starts_with($targetName, 'waaseyaa/')) {
                $fail(
                    'path_repository_parity',
                    $rel,
                    sprintf('path repository %s does not identify a waaseyaa/* package', $url),
                    'path repository target composer.json must name the corresponding waaseyaa/* package',
                );
                continue;
            }
            $pathRepositories[$targetName] = true;
        }

        foreach (array_keys(array_diff_key($internalRequirements, $pathRepositories)) as $packageName) {
            $fail(
                'path_repository_parity',
                $rel,
                sprintf('%s required without a matching path repository', $packageName),
                sprintf('add a path repository for %s', $packageName),
            );
        }
        foreach (array_keys(array_diff_key($pathRepositories, $internalRequirements)) as $packageName) {
            $fail(
                'path_repository_parity',
                $rel,
                sprintf('%s path repository has no matching requirement', $packageName),
                sprintf('remove the stale path repository or require %s', $packageName),
            );
        }
    }
}

if ($cpNewWarning !== null) {
    $emitErr('WARNING [CP-NEW] ' . $cpNewWarning);
} elseif ($expectedVersion !== null) {
    $expectedConstraint = '^' . $expectedVersion;
    foreach ($manifestPaths as $path) {
        $rel = relativePath($rootDir, $path);
        if (!str_starts_with($rel, 'packages/')) {
            continue;
        }

        $data = readComposerJson($path);
        foreach (['require', 'require-dev'] as $sectionName) {
            $section = is_array($data[$sectionName] ?? null) ? $data[$sectionName] : [];
            foreach ($section as $pkg => $version) {
                if (
                    is_string($pkg)
                    && is_string($version)
                    && str_starts_with($pkg, 'waaseyaa/')
                    && $version !== $expectedConstraint
                    && preg_match($tightFloorPattern, $version) === 1
                ) {
                    $failCpNew($rel, $pkg, $version, $expectedConstraint);
                }
            }
        }
    }
}

if ($errors === 0) {
    echo 'OK: Composer policy checks passed' . PHP_EOL;
    exit(0);
}

echo sprintf('Composer policy check failed with %d violation(s)', $errors) . PHP_EOL;
exit(1);

function relativePath(string $rootDir, string $path): string
{
    $root = rtrim(str_replace('\\', '/', $rootDir), '/') . '/';
    $normalized = str_replace('\\', '/', $path);

    if (str_starts_with($normalized, $root)) {
        return substr($normalized, strlen($root));
    }

    return $normalized;
}

function isExcluded(string $rel): bool
{
    $parts = explode('/', $rel);

    return in_array('vendor', $parts, true)
        || in_array('node_modules', $parts, true)
        || str_starts_with($rel, '.worktrees/');
}

/**
 * @return array<string, mixed>
 */
function readComposerJson(string $path): array
{
    $raw = file_get_contents($path);
    if ($raw === false) {
        throw new RuntimeException(sprintf('Unable to read %s', $path));
    }

    $data = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new RuntimeException(sprintf('%s must decode to a JSON object', $path));
    }

    return $data;
}
