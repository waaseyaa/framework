    return $classes[$path] ?? 'unclassified';
}

/** @return array{schema_version:int,query_version:string,patterns:array<string,string>,allowed_classes:list<string>,candidates:list<array<string,int|string>>} */
function s1ActivationBuildRoster(string $root): array
{
    $patterns = s1ActivationPatterns();
    $allowedClasses = [
        'activation-authority', 'activation-contract', 'active-reader', 'authorization-contract',
        'authority-composition', 'command-adapter', 'command-composition', 'compiled-reader',
        'epoch-cache', 'epoch-composition', 'epoch-consumer', 'epoch-contract', 'epoch-provider',
        'failure-contract', 'legacy-mutation-adapter', 'maintenance-contract', 'mutation-orchestrator',
        'refusing-default', 'request-contract', 'result-contract', 'schema-authority',
        'testing-or-static-epoch', 'token-contract',
    ];
    $candidates = [];
    foreach (['packages'] as $base) {
        $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . '/' . $base, FilesystemIterator::SKIP_DOTS));
        foreach ($iterator as $file) {
            if (!$file instanceof SplFileInfo || !$file->isFile() || $file->getExtension() !== 'php') {
                continue;
            }
            $path = str_replace('\\', '/', $file->getPathname());
            $relative = substr($path, strlen(str_replace('\\', '/', $root)) + 1);
            if (!str_contains($relative, '/src/') && !str_contains($relative, '/migrations/')) {
                continue;
            }
            $contents = (string) file_get_contents($path);
            $lines = explode("\n", $contents);
            foreach ($patterns as $patternId => $pattern) {
                preg_match_all($pattern, $contents, $matches, PREG_OFFSET_CAPTURE);
                foreach ($matches[0] as [$matched, $offset]) {
                    $line = substr_count(substr($contents, 0, $offset), "\n") + 1;
                    $candidates[] = [
                        'path' => $relative,
                        'line' => $line,
                        'pattern' => $patternId,
                        'class' => s1ActivationClass($relative),
                        'match_sha256' => hash('sha256', strtolower($matched)),
                        'line_sha256' => hash('sha256', trim($lines[$line - 1] ?? '')),
                        'source_sha256' => hash('sha256', $contents),
                    ];
                }
            }
        }
    }
    usort($candidates, static fn(array $left, array $right): int => [$left['path'], $left['line'], $left['pattern'], $left['match_sha256']] <=> [$right['path'], $right['line'], $right['pattern'], $right['match_sha256']]);

    return [
        'schema_version' => 1,
        'query_version' => 's1-configuration-activation-boundaries-v1',
        'patterns' => $patterns,
        'allowed_classes' => $allowedClasses,
        'candidates' => $candidates,
    ];
}

/** @param array<string,mixed> $actual */
function s1ActivationAssertContract(array $actual): void
{
    $expected = json_decode(<<<'JSON'
{"schema_version":1,"contract_id":"s1-configuration-activation-v1","capability":"configuration.activation.v1","capability_version":1,"predecessor":"s1-configuration-authority-v1","active_token":["activation_sequence","generation_id"],"request_identity":"caller-supplied-id-bound-to-input-hash-and-original-expected-token","generation_identity":"sha256-canonical-complete-manifest","logical_pointer":"highest-committed-activation-sequence","transaction_first_operation":"activation-counter-cas-write","ordinary_absence":"retain","deletion":"explicit-tombstone-with-expected-entry-hash","complete_replacement":"explicit-mode-complete-manifest-and-content-bound-tombstones","blind_force":"unsupported","authorization":"mandatory-before-staging","delete_authorization":"independent-stronger-permission","rollback":"authorized-compatible-cas-new-sequence","candidate_cleanup":"authorized-fenced-supersede-only","legacy_false_result":"typed-failure","reader_epoch":"check-before-and-after-work-unit","compiled_cache":"exact-token-bound-refuse-or-bypass","external_evidence":"post-commit-ledger-rederivable","runtime_lazy_ddl":"forbidden","production_default_authorizer":"refuse","production_default_rollback_validator":"refuse","production_default_sweep_authorizer":"refuse","deferred_to":["S1-FW-CFG-03","S1-FW-CFG-04"]}
JSON, true, flags: JSON_THROW_ON_ERROR);
    if ($actual !== $expected) {
        throw new RuntimeException('S1 configuration activation contract differs from the verifier-owned exact schema and values.');
    }
}

function s1ActivationRequireContains(string $root, string $relative, string $needle): void
{
    $contents = (string) file_get_contents($root . '/' . $relative);
    if (!str_contains($contents, $needle)) {
        throw new RuntimeException(sprintf('%s is missing required CFG-02 semantic anchor: %s', $relative, $needle));
    }
}

function s1ActivationRequireRefusingMethod(string $root, string $relative, string $method): void
{
    $contents = (string) file_get_contents($root . '/' . $relative);
    $pattern = sprintf('/function\s+%s\s*\([^)]*\)\s*:\s*void\s*\{\s*throw\s+new\s+\\\\DomainException\b/s', preg_quote($method, '/'));
    if (preg_match($pattern, $contents) !== 1) {
        throw new RuntimeException(sprintf('%s must implement %s() as an executable refusing default.', $relative, $method));
    }
}

function s1ActivationMethodBody(string $contents, string $method): string
{
    $tokens = token_get_all($contents);
    $count = count($tokens);
    for ($index = 0; $index < $count; ++$index) {
        if (!is_array($tokens[$index]) || $tokens[$index][0] !== T_FUNCTION) {
            continue;
        }
        for ($cursor = $index + 1; $cursor < $count; ++$cursor) {
            $token = $tokens[$cursor];
            if (is_array($token) && $token[0] === T_STRING) {
                if ($token[1] !== $method) {
                    break;
                }
                while ($cursor < $count && $tokens[$cursor] !== '{') {
                    ++$cursor;
                }
                if ($cursor >= $count) {
                    break;
                }
                $body = '';
                $depth = 0;
                for (; $cursor < $count; ++$cursor) {
                    $part = is_array($tokens[$cursor]) ? $tokens[$cursor][1] : $tokens[$cursor];
                    if ($part === '{') {
                        ++$depth;
                    } elseif ($part === '}') {
                        --$depth;
                        if ($depth === 0) {
                            return $body;
                        }
                    } elseif ($depth > 0) {
                        $body .= $part;
                    }
                }
            }
        }
    }
    throw new RuntimeException(sprintf('CFG-02 migration is missing an inspectable %s() method.', $method));
}

try {
    $contract = json_decode((string) file_get_contents($contractPath), true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($contract)) {
        throw new RuntimeException('S1 activation contract must decode to an object.');
    }
    s1ActivationAssertContract($contract);
    $live = s1ActivationBuildRoster($root);
    foreach ($live['candidates'] as $candidate) {
        if ($candidate['class'] === 'unclassified' || !in_array($candidate['class'], $live['allowed_classes'], true)) {
            throw new RuntimeException(sprintf('Unclassified CFG-02 boundary at %s:%d (%s).', $candidate['path'], $candidate['line'], $candidate['pattern']));
        }
    }
    if ($writeRoster) {
        file_put_contents($rosterPath, json_encode($live, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    }
    $recorded = json_decode((string) file_get_contents($rosterPath), true, flags: JSON_THROW_ON_ERROR);
    if ($recorded !== $live) {
        throw new RuntimeException('Recorded CFG-02 boundary roster differs from the verifier-owned live inventory.');
    }

    $anchors = [
        ['packages/entity-storage/src/Config/DatabaseConfigurationActivator.php', 'ConfigurationActivationContentionException'],
        ['packages/entity-storage/src/Config/DatabaseConfigurationActivator.php', 'committedResult'],
        ['packages/config/src/Activation/ConfigurationActivationResult.php', 'evidenceHash'],
        ['packages/config/src/Activation/TransactionalConfigurationStorage.php', 'ConfigurationActivationRequest'],
        ['packages/config/src/Sync/ConfigImporter.php', 'activationRequestId'],
        ['packages/config/src/Sync/ConfigResetter.php', 'ConfigurationActivationRequest'],
        ['packages/entity-storage/migrations/2026_08_12_000003_configuration_activation.php', 'waaseyaa_config_activation_counter'],
        ['packages/foundation/src/Runtime/RuntimeEpochCacheBackend.php', 'epochFingerprint'],
        ['packages/queue/src/Worker/Worker.php', 'hasChanged'],
        ['packages/config/src/Cache/CachedConfigFactory.php', '_waaseyaa_config_cache_v1'],
        ['packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php', 'TransactionalConfigurationStorage'],
    ];
    foreach ($anchors as [$path, $needle]) {
        s1ActivationRequireContains($root, $path, $needle);
    }
    foreach ([
        ['packages/config/src/Activation/RefusingConfigurationActivationAuthorizer.php', 'authorize'],
        ['packages/config/src/Activation/RefusingConfigurationRollbackValidator.php', 'validate'],
        ['packages/config/src/Activation/RefusingConfigurationCandidateSweepAuthorizer.php', 'authorize'],
    ] as [$path, $method]) {
        s1ActivationRequireRefusingMethod($root, $path, $method);
    }
    s1ActivationRequireContains($root, 'packages/entity-storage/src/Config/DatabaseConfigurationActivator.php', 'claimSweepFence($request)');
    s1ActivationRequireContains($root, 'packages/entity-storage/src/Config/DatabaseConfigurationActivator.php', 'ensureInitialCounter()');
    s1ActivationRequireContains($root, 'packages/queue/src/QueueServiceProvider.php', 'Activated queue workers require a runtime epoch authority.');
    $httpKernel = (string) file_get_contents($root . '/packages/foundation/src/Kernel/HttpKernel.php');
    if (!str_contains($httpKernel, '$this->isDevelopmentMode()') || !str_contains($httpKernel, 'requires a composed runtime epoch authority')) {
        throw new RuntimeException('Serving HTTP cache composition must restrict stable epochs to an explicit non-production allowlist.');
    }
    $migration = (string) file_get_contents($migrationPath);
    if (stripos($migration, 'CREATE TABLE') === false || stripos($migration, 'down') === false) {
        throw new RuntimeException('CFG-02 schema authority is incomplete.');
    }
    $downBody = s1ActivationMethodBody($migration, 'down');
    if (preg_match('/\b(?:DROP\s+TABLE|TRUNCATE\s+TABLE|DELETE\s+FROM|ALTER\s+TABLE[\s\S]*?\bDROP\b)/i', $downBody) === 1) {
        throw new RuntimeException('CFG-02 forward-only migration must not delete, truncate, or structurally drop activation authority data.');
    }
    echo sprintf("S1 configuration activation contract passed: %d classified production boundaries, one transactional authority.\n", count($live['candidates']));
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(1);
}
