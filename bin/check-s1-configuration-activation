#!/usr/bin/env php
<?php

declare(strict_types=1);

/** Exact, forge-neutral inventory and semantic gate for S1-FW-CFG-02. */

require_once __DIR__ . '/lib/s1-roster.php';

$root = dirname(__DIR__);
$rosterPath = $root . '/support/s1-configuration-activation-roster.json';
$contractPath = $root . '/support/s1-configuration-activation-v1.json';
$migrationPath = $root . '/packages/entity-storage/migrations/2026_08_12_000003_configuration_activation.php';
$arguments = array_values(array_filter($_SERVER['argv'] ?? [], 'is_string'));
$writeRoster = in_array('--write-roster', $arguments, true);
foreach ($arguments as $argument) {
    if (str_starts_with($argument, '--roster=')) {
        $candidate = substr($argument, strlen('--roster='));
        $rosterPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
    if (str_starts_with($argument, '--contract=')) {
        $candidate = substr($argument, strlen('--contract='));
        $contractPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
    if (str_starts_with($argument, '--migration=')) {
        $candidate = substr($argument, strlen('--migration='));
        $migrationPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
}

/** @return array<string, string> */
function s1ActivationPatterns(): array
{
    return [
        'activator_contract' => '/\bConfigurationActivatorInterface\b/',
        'activation_request' => '/\bConfigurationActivationRequest\b/',
        'rollback_request' => '/\bConfigurationRollbackRequest\b/',
        'active_token' => '/\bConfigurationActiveToken\b/',
        'activation_authorizer' => '/\bConfigurationActivationAuthorizerInterface\b/',
        'rollback_validator' => '/\bConfigurationRollbackValidatorInterface\b/',
        'candidate_sweep' => '/\b(?:ConfigurationCandidateMaintenanceInterface|ConfigurationCandidateSweepRequest|ConfigurationCandidateSweepAuthorizerInterface)\b/',
        'refusing_policy' => '/\b(?:RefusingConfigurationActivationAuthorizer|RefusingConfigurationRollbackValidator|RefusingConfigurationCandidateSweepAuthorizer)\b/',
        'transactional_storage' => '/\bTransactionalConfigurationStorage\b/',
        'runtime_epoch' => '/\bRuntimeEpochInterface\b/',
        'runtime_epoch_cache' => '/\bRuntimeEpochCacheBackend\b/',
        'typed_mutation_failure' => '/\bConfigMutationFailedException\b/',
        'activation_table' => '/\bwaaseyaa_config_(?:activation_counter|generation_v2|entry_v2|candidate|candidate_sweep_fence|activation_v2|manifest_replay|entry_contract|activation_manifest)\b/',
        'activation_command_option' => '/\b(?:activation-request-id|expected-generation|expected-sequence)\b/',
        'sqlite_contention' => '/\b(?:SQLITE_BUSY|database is locked|DeadlockException|LockWaitTimeoutException)\b/i',
    ];
}

