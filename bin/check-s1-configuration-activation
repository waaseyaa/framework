{
    $classes = [
        'packages/cli/src/Command/Config/ConfigImportCommand.php' => 'command-adapter',
        'packages/cli/src/Command/Config/ConfigResetCommand.php' => 'command-adapter',
        'packages/cli/src/Provider/ConfigCacheDbAuditServiceProvider.php' => 'command-composition',
        'packages/config/src/Activation/ConfigurationActivationAuthorizerInterface.php' => 'authorization-contract',
        'packages/config/src/Activation/ConfigurationActivationConflictException.php' => 'failure-contract',
        'packages/config/src/Activation/ConfigurationActivationContentionException.php' => 'failure-contract',
        'packages/config/src/Activation/ConfigurationActivationRequest.php' => 'request-contract',
        'packages/config/src/Activation/ConfigurationActivationRequestReuseException.php' => 'failure-contract',
        'packages/config/src/Activation/ConfigurationActivationResult.php' => 'result-contract',
        'packages/config/src/Activation/ConfigurationActivatorInterface.php' => 'activation-contract',
        'packages/config/src/Activation/ConfigurationCandidateMaintenanceInterface.php' => 'maintenance-contract',
        'packages/config/src/Activation/ConfigurationCandidateSweepAuthorizerInterface.php' => 'authorization-contract',
        'packages/config/src/Activation/ConfigurationCandidateSweepRequest.php' => 'request-contract',
        'packages/config/src/Activation/ConfigurationRollbackRequest.php' => 'request-contract',
        'packages/config/src/Activation/ConfigurationRollbackValidatorInterface.php' => 'authorization-contract',
        'packages/config/src/Activation/RefusingConfigurationActivationAuthorizer.php' => 'refusing-default',
        'packages/config/src/Activation/RefusingConfigurationCandidateSweepAuthorizer.php' => 'refusing-default',
        'packages/config/src/Activation/RefusingConfigurationRollbackValidator.php' => 'refusing-default',
        'packages/config/src/Activation/TransactionalConfigurationStorage.php' => 'legacy-mutation-adapter',
        'packages/config/src/Authority/ConfigurationActiveToken.php' => 'token-contract',
        'packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php' => 'authority-composition',
        'packages/config/src/Cache/CachedConfigFactory.php' => 'compiled-reader',
        'packages/config/src/Config.php' => 'legacy-mutation-adapter',
        'packages/config/src/ConfigFactory.php' => 'legacy-mutation-adapter',
        'packages/config/src/ConfigManager.php' => 'legacy-mutation-adapter',
        'packages/config/src/Exception/ConfigMutationFailedException.php' => 'failure-contract',
        'packages/config/src/Sync/ConfigImporter.php' => 'mutation-orchestrator',
        'packages/config/src/Sync/ConfigResetter.php' => 'mutation-orchestrator',
        'packages/entity-storage/migrations/2026_08_12_000003_configuration_activation.php' => 'schema-authority',
