/**
 * Live scan with transient line numbers (report-time display only — never
 * recorded; roster identity is semantic, see docs/specs/governed-gates.md §6).
 *
 * @return list<array{path: string, pattern: string, class: string, match_sha256: string, occurrence: int, line: int}>
 */
function s1SchemaScan(string $root): array
{
    return s1RosterScan(
        $root,
        [''],
        s1SchemaPatterns(),
        static function (string $relative, string $contents): bool {
            $firstLine = strtok($contents, "\n");
            $phpShebang = is_string($firstLine) && preg_match('/^#!.*\bphp(?:\s|$)/', $firstLine) === 1;

            return str_ends_with($relative, '.php') || $phpShebang;
        },
        static fn(string $relative, string $patternId): string => s1SchemaClass($relative),
    );
}

/**
 * @param list<array<string, int|string>> $transient Entries from s1SchemaScan().
 * @return array<string, mixed>
 */
function s1SchemaBuildRoster(array $transient): array
{
    return s1RosterDocument(
        's1-schema-boundaries-v2',
        s1SchemaPatterns(),
        [
            'coordinator-authority',
            'coordinator-plan-or-executor',
            'authoritative-bypass-remediation-required',
            'projection-authority',
            'etl-boundary',
            'tooling-generator',
            'tooling-query',
            'test-tooling',
            'test-only',
            'read-only-or-declaration',
            'explicit-exclusion',
        ],
        s1RosterCanonicalize($transient),
    );
}

if ($writeRoster) {
    $roster = s1SchemaBuildRoster(s1SchemaScan($root));
    file_put_contents(
        $root . '/support/s1-schema-authority-roster.json',
        json_encode($roster, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n",
    );
    fwrite(STDOUT, sprintf("Wrote %d schema-boundary candidates.\n", count($roster['candidates'])));
    exit(0);
}

$errors = [];
try {
    if (!is_file($rosterPath)) {
        throw new RuntimeException("Required schema-authority roster is missing: {$rosterPath}");
    }
    $recorded = json_decode((string) file_get_contents($rosterPath), true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($recorded) || array_is_list($recorded)) {
        throw new RuntimeException('Schema-authority roster must be a JSON object.');
    }
    $transient = s1SchemaScan($root);
    $live = s1SchemaBuildRoster($transient);
    if ($recorded !== $live) {
        $errors[] = 'Recorded schema-authority roster differs from the live verifier-owned occurrence universe.';
        $diff = s1RosterDiff(
            is_array($recorded['candidates'] ?? null) ? $recorded['candidates'] : [],
            $transient,
            'php bin/check-s1-schema-authority --write-roster',
        );
        if ($diff === []) {
            $diff = ['roster metadata (schema/query/patterns/classes) differs — regenerate with php bin/check-s1-schema-authority --write-roster and commit the roster.'];
        }
        array_push($errors, ...$diff);
    }
    foreach ($transient as $candidate) {
        if ($candidate['class'] === 'unclassified') {
            $errors[] = sprintf('Unclassified production schema boundary: %s:%d (%s).', $candidate['path'], $candidate['line'], $candidate['pattern']);
        }
        if (!in_array($candidate['class'], $live['allowed_classes'], true)) {
            $errors[] = sprintf('Invalid schema-boundary class %s at %s:%d.', $candidate['class'], $candidate['path'], $candidate['line']);
        }
    }

    foreach ([
        'packages/entity-storage/src/EntitySchemaSync.php',
        'packages/entity-storage/src/Schema/TranslationSchemaHandler.php',
        'packages/entity-storage/src/SqlSchemaHandler.php',
    ] as $executorPath) {
        $executorSource = (string) file_get_contents($root . '/' . $executorPath);
        if (!str_contains($executorSource, 'CoordinatedEntitySchemaExecutor')) {
            $errors[] = sprintf('Entity schema executor is not coordinator-bound: %s.', $executorPath);
        }
    }

    $coordinatorAdapter = (string) file_get_contents(
        $root . '/packages/entity-storage/src/CoordinatedEntitySchemaExecutor.php',
    );
    foreach (['SchemaMutationCoordinator', 'MigrationRepository', 'S1-DB107'] as $requiredToken) {
        if (!str_contains($coordinatorAdapter, $requiredToken)) {
            $errors[] = sprintf('Entity schema coordinator adapter is missing %s.', $requiredToken);
        }
    }

    $kernelFactory = (string) file_get_contents($root . '/packages/foundation/src/Kernel/EntityTypeManagerFactory.php');
    if (!str_contains($kernelFactory, 'assertRuntimeSchema()')) {
        $errors[] = 'Kernel repository composition does not validate entity schema read-only.';
    }
    foreach (['->ensureTable()', '->ensureRevisionTable()', '->ensureTranslationTable()', '->sync($definition)'] as $runtimeMutation) {
        if (str_contains($kernelFactory, $runtimeMutation)) {
            $errors[] = sprintf('Kernel repository composition still contains runtime entity DDL: %s.', $runtimeMutation);
        }
    }
} catch (Throwable $exception) {
    $errors[] = $exception->getMessage();
}

if ($errors !== []) {
    foreach (array_values(array_unique($errors)) as $error) {
        fwrite(STDERR, "ERROR: {$error}\n");
    }
    exit(1);
}

$counts = array_count_values(array_column($live['candidates'], 'class'));
ksort($counts);
fwrite(STDOUT, sprintf(
    "S1 schema authority roster passed: %d occurrences across %d files; %s\n",
    count($live['candidates']),
    count(array_unique(array_column($live['candidates'], 'path'))),
    json_encode($counts, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR),
));
