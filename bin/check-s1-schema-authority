#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Exact, forge-neutral inventory gate for executable schema boundaries.
 *
 * The roster is descriptive while DB-02 is active: a reviewed
 * `authoritative-bypass-remediation-required` classification is allowed, but
 * an unclassified production occurrence is not. The DB-02 exit gate later
 * removes every remediation-required class before certification.
 */

require_once __DIR__ . '/lib/s1-roster.php';

$root = dirname(__DIR__);
$rosterPath = $root . '/support/s1-schema-authority-roster.json';
$arguments = array_values(array_filter($_SERVER['argv'] ?? [], 'is_string'));
$writeRoster = in_array('--write-roster', $arguments, true);
foreach ($arguments as $argument) {
    if (str_starts_with($argument, '--roster=')) {
        $candidate = substr($argument, strlen('--roster='));
        $rosterPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
}

/** @return array<string, string> */
function s1SchemaPatterns(): array
{
    return [
        'ddl_sql' => '/\b(?:CREATE\s+(?:VIRTUAL\s+)?TABLE|CREATE\s+(?:UNIQUE\s+)?INDEX|CREATE\s+(?:TRIGGER|VIEW)|ALTER\s+TABLE|DROP\s+(?:TABLE|INDEX|TRIGGER|VIEW))\b/i',
        'schema_method' => '/->\s*(?:createTable|dropTable|renameTable|addColumn|dropColumn|renameColumn|addIndex|dropIndex|addField)\s*\(/',
        'legacy_schema_method' => '/->\s*(?:create|drop|rename)\s*\(/',
    ];
}

