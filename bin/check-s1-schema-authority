/** @return array{schema_version: int, query_version: string, patterns: array<string, string>, allowed_classes: list<string>, candidates: list<array<string, int|string>>} */
function s1SchemaBuildRoster(string $root): array
{
    $patterns = s1SchemaPatterns();
    $allowedClasses = [
        'coordinator-authority',
        'coordinator-plan-or-executor',
        'authoritative-bypass-remediation-required',
        'projection-authority',
        'etl-boundary',
        'tooling-generator',
        'tooling-query',
        'test-tooling',
        'test-only',
        'read-only-or-declaration',
        'explicit-exclusion',
    ];
    $candidates = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }
        $path = str_replace('\\', '/', $file->getPathname());
        $relative = substr($path, strlen(str_replace('\\', '/', $root)) + 1);
        if (str_starts_with($relative, 'vendor/')
            || str_starts_with($relative, '.git/')
            || str_starts_with($relative, 'tmp/')
        ) {
            continue;
        }

        $contents = (string) file_get_contents($path);
        $firstLine = strtok($contents, "\n");
        $phpShebang = is_string($firstLine) && preg_match('/^#!.*\bphp(?:\s|$)/', $firstLine) === 1;
        if (!str_ends_with($relative, '.php') && !$phpShebang) {
            continue;
        }
        $lines = explode("\n", $contents);
        foreach ($patterns as $patternId => $pattern) {
            preg_match_all($pattern, $contents, $matches, PREG_OFFSET_CAPTURE);
            foreach ($matches[0] as [$matched, $offset]) {
                $line = substr_count(substr($contents, 0, $offset), "\n") + 1;
                $candidates[] = [
                    'path' => $relative,
                    'line' => $line,
                    'pattern' => $patternId,
                    'class' => s1SchemaClass($relative),
                    'match_sha256' => hash('sha256', $matched),
                    'line_sha256' => hash('sha256', trim($lines[$line - 1] ?? '')),
                    'source_sha256' => hash('sha256', $contents),
                ];
            }
        }
    }
    usort($candidates, static fn(array $left, array $right): int => [
        $left['path'], $left['line'], $left['pattern'], $left['match_sha256'],
    ] <=> [$right['path'], $right['line'], $right['pattern'], $right['match_sha256']]);

    return [
        'schema_version' => 1,
        'query_version' => 's1-schema-boundaries-v1',
        'patterns' => $patterns,
        'allowed_classes' => $allowedClasses,
        'candidates' => $candidates,
    ];
}

if ($writeRoster) {
    $roster = s1SchemaBuildRoster($root);
    file_put_contents(
        $root . '/support/s1-schema-authority-roster.json',
        json_encode($roster, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n",
    );
    fwrite(STDOUT, sprintf("Wrote %d schema-boundary candidates.\n", count($roster['candidates'])));
    exit(0);
}

$errors = [];
try {
    if (!is_file($rosterPath)) {
        throw new RuntimeException("Required schema-authority roster is missing: {$rosterPath}");
    }
    $recorded = json_decode((string) file_get_contents($rosterPath), true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($recorded) || array_is_list($recorded)) {
        throw new RuntimeException('Schema-authority roster must be a JSON object.');
    }
    $live = s1SchemaBuildRoster($root);
    if ($recorded !== $live) {
        $errors[] = 'Recorded schema-authority roster differs from the live verifier-owned occurrence universe.';
    }
    foreach ($live['candidates'] as $candidate) {
        if ($candidate['class'] === 'unclassified') {
            $errors[] = sprintf('Unclassified production schema boundary: %s:%d (%s).', $candidate['path'], $candidate['line'], $candidate['pattern']);
        }
        if (!in_array($candidate['class'], $live['allowed_classes'], true)) {
            $errors[] = sprintf('Invalid schema-boundary class %s at %s:%d.', $candidate['class'], $candidate['path'], $candidate['line']);
        }
    }
} catch (Throwable $exception) {
    $errors[] = $exception->getMessage();
}

if ($errors !== []) {
    foreach (array_values(array_unique($errors)) as $error) {
        fwrite(STDERR, "ERROR: {$error}\n");
    }
    exit(1);
}

$counts = array_count_values(array_column($live['candidates'], 'class'));
ksort($counts);
fwrite(STDOUT, sprintf(
    "S1 schema authority roster passed: %d occurrences across %d files; %s\n",
    count($live['candidates']),
    count(array_unique(array_column($live['candidates'], 'path'))),
    json_encode($counts, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR),
));
