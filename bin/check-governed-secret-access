#!/usr/bin/env php
<?php

declare(strict_types=1);

$repositoryRoot = dirname(__DIR__);
$scanRoot = $repositoryRoot;
for ($i = 1; $i < $argc; ++$i) {
    if ($argv[$i] === '--root' && isset($argv[$i + 1])) {
        $scanRoot = rtrim($argv[++$i], '/');
        continue;
    }
    fwrite(STDERR, "Usage: bin/check-governed-secret-access [--root <path>]\n");
    exit(2);
}

/** @var array<string, string> $fileReadBaseline */
$fileReadBaseline = require $repositoryRoot . '/tools/governed-secret-access-baseline.php';
$scopes = [
    'packages/ai-agent/src',
    'packages/ai-vector/src',
    'packages/config/src/Schema/Ai',
];
$environmentFunctions = ['getenv' => true, 'putenv' => true];
$fileReadFunctions = [
    'file' => true,
    'file_get_contents' => true,
    'fopen' => true,
    'parse_ini_file' => true,
    'readfile' => true,
];
$observedFileReads = [];
$violations = [];

foreach ($scopes as $scope) {
    $absoluteScope = $scanRoot . '/' . $scope;
    if (!is_dir($absoluteScope)) {
        continue;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($absoluteScope, FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile() || $file->getExtension() !== 'php') {
            continue;
        }
        $absolutePath = $file->getPathname();
        $relativePath = str_replace('\\', '/', substr($absolutePath, strlen($scanRoot) + 1));
        $contents = file_get_contents($absolutePath);
        if (!is_string($contents)) {
            $violations[] = sprintf('GSA003 %s:0 unreadable source', $relativePath);
            continue;
        }
        $tokens = token_get_all($contents);
        foreach ($tokens as $index => $token) {
            if (!is_array($token)) {
                continue;
            }
            [$tokenId, $text, $line] = $token;
            if ($tokenId === T_VARIABLE && ($text === '$_ENV' || $text === '$_SERVER')) {
                $violations[] = sprintf('GSA001 %s:%d direct environment access', $relativePath, $line);
                continue;
            }
            if (!in_array($tokenId, [T_STRING, T_NAME_QUALIFIED, T_NAME_FULLY_QUALIFIED], true)) {
                continue;
            }
            $function = ltrim(strtolower($text), '\\');
            if (!isset($environmentFunctions[$function]) && !isset($fileReadFunctions[$function])) {
                continue;
            }
            if (!nextTokenIsOpeningParenthesis($tokens, $index + 1)) {
                continue;
            }
            if (isset($environmentFunctions[$function])) {
                $violations[] = sprintf('GSA001 %s:%d direct environment access', $relativePath, $line);
                continue;
            }

            $key = $relativePath . ':' . $function;
            $observedFileReads[$key] = true;
            if (!isset($fileReadBaseline[$key])) {
                $violations[] = sprintf('GSA002 %s:%d unreviewed file access', $relativePath, $line);
            }
        }
    }
}

if ($scanRoot === $repositoryRoot) {
    foreach ($fileReadBaseline as $key => $rationale) {
        if (!isset($observedFileReads[$key])) {
            $violations[] = sprintf('GSA003 %s stale file-access baseline', $key);
        }
        if (trim($rationale) === '') {
            $violations[] = sprintf('GSA003 %s missing baseline rationale', $key);
        }
    }
}

if ($violations !== []) {
    sort($violations, SORT_STRING);
    fwrite(STDERR, implode("\n", $violations) . "\n");
    exit(1);
}

fwrite(STDOUT, "OK - governed secret access uses resolver custody; reviewed non-secret file reads only.\n");
exit(0);

/** @param list<array{int, string, int}|string> $tokens */
function nextTokenIsOpeningParenthesis(array $tokens, int $offset): bool
{
    for ($i = $offset, $count = count($tokens); $i < $count; ++$i) {
        $token = $tokens[$i];
        if (is_array($token) && in_array($token[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
            continue;
        }

        return $token === '(';
    }

    return false;
}
