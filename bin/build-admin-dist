#!/usr/bin/env bash
# Rebuild the committed admin SPA dist from packages/admin/app source and refresh
# the freshness signature (D6). This is the single reproducible step that keeps
# the committed packages/admin-surface/dist bundle and its content signature in
# lockstep, so a stale bundle can never be tagged into a release.
#
# Usage:  bin/build-admin-dist   (run from anywhere; resolves the repo root)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SIGNATURE="$(php "$ROOT/bin/check-admin-dist-fresh" --print)"
BUILD_ID_SIGNATURE="$(php "$ROOT/bin/check-admin-dist-fresh" --print-build-id)"
BUILD_ID="waaseyaa-${BUILD_ID_SIGNATURE:0:32}"

echo "==> Installing and generating the static Nuxt SPA in a hermetic child"
WAASEYAA_ADMIN_BUILD_ID="$BUILD_ID" \
WAASEYAA_ADMIN_BUILD_ALLOW_PUBLIC_REGISTRY=1 \
php "$ROOT/bin/run-hermetic-admin-build"

echo "==> Normalizing volatile Nuxt metadata"
php "$ROOT/bin/normalize-admin-dist" "$ROOT/packages/admin/.output/public" "$BUILD_ID_SIGNATURE"

echo "==> Copying build output to packages/admin-surface/dist"
rm -rf "$ROOT/packages/admin-surface/dist"
cp -r "$ROOT/packages/admin/.output/public" "$ROOT/packages/admin-surface/dist"

echo "==> Scanning final publishable and ignored build artifacts"
php "$ROOT/bin/run-hermetic-admin-build" --scan-only

echo "==> Writing admin dist freshness signature"
php "$ROOT/bin/check-admin-dist-fresh" --write

echo "==> Done. Commit packages/admin-surface/dist/ and packages/admin-surface/dist.signature together."
