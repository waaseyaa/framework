#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Enforce the Path R-narrow Symfony-import boundary ratified in mission #1107
 * (C-005 (b)). Fails when a `use Symfony\...` line appears outside the
 * framework allowlist.
 *
 * Usage:
 *   php bin/check-symfony-imports
 *   php bin/check-symfony-imports --list-stale
 */

$root = dirname(__DIR__);
$listStale = ($argv[1] ?? '') === '--list-stale';
$configPath = $root . DIRECTORY_SEPARATOR . '.symfony-import-allowlist.json';

if (!is_file($configPath)) {
    fwrite(STDERR, "ERROR: missing .symfony-import-allowlist.json\n");
    exit(1);
}

$config = json_decode((string) file_get_contents($configPath), true, 512, JSON_THROW_ON_ERROR);
$normalize = static function (string $path) use ($root): string {
    $absolute = str_starts_with($path, $root) ? $path : $root . DIRECTORY_SEPARATOR . $path;
    $real = realpath($absolute);

    return str_replace('\\', '/', $real !== false ? $real : $absolute);
};

$allowedDirectories = array_map($normalize, $config['allowed_directories'] ?? []);
$legacyFiles = array_fill_keys(
    array_map($normalize, $config['legacy_files'] ?? []),
    true,
);

$isInAllowedDirectory = static function (string $file) use ($allowedDirectories): bool {
    foreach ($allowedDirectories as $directory) {
        if (str_starts_with($file . '/', rtrim($directory, '/') . '/')) {
            return true;
        }
    }

    return false;
};

$hasSymfonyImport = static function (string $file): bool {
    $handle = @fopen($file, 'rb');
    if ($handle === false) {
        return false;
    }

    try {
        while (($line = fgets($handle)) !== false) {
            if (preg_match('/^\s*use\s+(?:function\s+|const\s+)?Symfony\\\\/', $line) === 1) {
                return true;
            }
        }
    } finally {
        fclose($handle);
    }

    return false;
};

$packageRoots = glob($root . DIRECTORY_SEPARATOR . 'packages' . DIRECTORY_SEPARATOR . '*' . DIRECTORY_SEPARATOR . 'src', GLOB_ONLYDIR) ?: [];
$violations = [];
$seenLegacyFiles = [];

foreach ($packageRoots as $packageSrc) {
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($packageSrc, FilesystemIterator::SKIP_DOTS),
    );

    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || $file->getExtension() !== 'php') {
            continue;
        }

        $path = str_replace('\\', '/', $file->getPathname());
        if ($isInAllowedDirectory($path)) {
            continue;
        }

        $handle = @fopen($file->getPathname(), 'rb');
        if ($handle === false) {
            continue;
        }

        $match = null;
        $lineNumber = 0;
        try {
            while (($line = fgets($handle)) !== false) {
                ++$lineNumber;
                if (preg_match('/^\s*use\s+(?:function\s+|const\s+)?Symfony\\\\/', $line) === 1) {
                    $match = [$lineNumber, rtrim($line)];
                    break;
                }
            }
        } finally {
            fclose($handle);
        }

        if ($match === null) {
            continue;
        }

        $normalized = $normalize($file->getPathname());
        if (isset($legacyFiles[$normalized])) {
            $seenLegacyFiles[$normalized] = true;
            continue;
        }

        $relative = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));
        $violations[] = [$relative, $match[0], $match[1]];
    }
}

if ($violations !== []) {
    echo "Disallowed Symfony imports outside the allowlist:\n\n";
    foreach ($violations as [$relative, $lineNumber, $line]) {
        echo "  {$relative}:{$lineNumber}: {$line}\n";
    }
    echo "\n" . count($violations) . " violation(s) found.\n\n";
    echo "Resolve by either:\n";
    echo "  - Replacing the import with the equivalent Waaseyaa surface.\n";
    echo "  - Adding the file to `legacy_files` in `.symfony-import-allowlist.json`\n";
    echo "    when the import is genuinely unavoidable.\n";
    exit(1);
}

if ($listStale) {
    $deleted = [];
    $refactored = [];

    foreach (array_keys($legacyFiles) as $legacyFile) {
        if (!is_file($legacyFile)) {
            $deleted[] = $legacyFile;
            continue;
        }

        if (!isset($seenLegacyFiles[$legacyFile]) && !$hasSymfonyImport($legacyFile)) {
            $refactored[] = $legacyFile;
        }
    }

    if ($deleted !== []) {
        echo "Stale legacy_files entries (file no longer exists):\n";
        foreach ($deleted as $file) {
            echo '  ' . str_replace('\\', '/', substr($file, strlen($root) + 1)) . "\n";
        }
        echo "\n";
    }

    if ($refactored !== []) {
        echo "Stale legacy_files entries (file no longer has Symfony imports):\n";
        foreach ($refactored as $file) {
            echo '  ' . str_replace('\\', '/', substr($file, strlen($root) + 1)) . "\n";
        }
        echo "\nRemove these entries from `.symfony-import-allowlist.json`.\n";
    }

    if ($deleted !== [] || $refactored !== []) {
        exit(2);
    }
}

echo "OK - Symfony-import boundary clean.\n";
exit(0);
