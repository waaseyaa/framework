#!/usr/bin/env bash
#
# check-phpstan-paths — enforce roster-wide PHPStan coverage through one
# `packages` root, rather than a duplicated hand-maintained package list.
#
# This guards the class of gap found in audit C-19, where `attachment`, `audit`,
# and `structured-import` shipped real code that PHPStan never analysed simply
# because nobody added them to `paths:` — a silent coverage hole that no other
# gate caught. A package's source is in scope the moment it has a `src/` dir.
#
# Exit codes:
#   0 — every packages/*/src is covered (and no listed path is stale)
#   1 — a packages/*/src is missing from paths:, or a listed path no longer exists

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export ROOT_DIR

python3 - <<'PY'
import os
import pathlib
import re
import sys

root = pathlib.Path(os.environ["ROOT_DIR"])
neon = (root / "phpstan.neon").read_text(encoding="utf-8")

# Extract entries from the `paths:` block only.
listed: list[str] = []
in_paths = False
for line in neon.splitlines():
    if re.match(r"^\s*paths:\s*$", line):
        in_paths = True
        continue
    if in_paths:
        m = re.match(r"^\s*-\s*(packages(?:/[^/]+/src)?)\s*$", line)
        if m:
            listed.append(m.group(1))
            continue
        # A non-list, non-blank, non-comment line ends the paths block.
        if line.strip() and not line.lstrip().startswith(("-", "#")):
            break

if listed != ["packages"]:
    print("PHPStan coverage must use the single `packages` root in phpstan.neon `paths:`.")
    print(f"Found: {listed!r}")
    print("Per-package src entries duplicate the package roster and can drift.")
    sys.exit(1)

count = sum(1 for p in root.glob("packages/*/src") if p.is_dir())
print(f"OK — PHPStan analyses the packages root ({count} current src trees, future trees automatic).")
PY
