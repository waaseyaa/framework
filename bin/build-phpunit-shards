#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$options = getopt('', ['root::', 'timings:', 'shards::', 'pretty', 'only::', 'seed::']);
if (is_string($options['root'] ?? null) && $options['root'] !== '') {
    $root = rtrim((string) $options['root'], '/');
}
$timingsPath = $options['timings'] ?? '';
$shardCount = isset($options['shards']) ? (int) $options['shards'] : 4;
$pretty = array_key_exists('pretty', $options);

if (!is_string($timingsPath) || $timingsPath === '' || $shardCount < 1 || $shardCount > 16) {
    fwrite(STDERR, "Usage: php bin/build-phpunit-shards --timings=<json> [--shards=4] [--root=<repo>] [--pretty]\n");
    exit(2);
}

try {
    $contents = file_get_contents($timingsPath);
    if ($contents === false) {
        throw new RuntimeException('timing file could not be read');
    }
    $timingDocument = json_decode($contents, true, 512, JSON_THROW_ON_ERROR);
} catch (Throwable $exception) {
    fwrite(STDERR, "Unable to read PHPUnit timing evidence: {$exception->getMessage()}\n");
    exit(2);
}

if (!is_array($timingDocument)
    || ($timingDocument['schema_version'] ?? null) !== 1
    || !is_array($timingDocument['files'] ?? null)
) {
    fwrite(STDERR, "PHPUnit timing evidence must use schema_version 1 and contain a files map.\n");
    exit(2);
}

/** @var array<string, float> $timings */
$timings = [];
foreach ($timingDocument['files'] as $path => $seconds) {
    if (!is_string($path)
        || preg_match('#^(packages/[^/]+/|tests/).+\.php$#', $path) !== 1
        || !is_numeric($seconds)
        || (float) $seconds < 0.0
    ) {
        fwrite(STDERR, "Invalid PHPUnit timing entry: " . (is_string($path) ? $path : get_debug_type($path)) . ".\n");
        exit(2);
    }
    $timings[$path] = (float) $seconds;
}

$configPath = $root . '/phpunit.xml.dist';
$previous = libxml_use_internal_errors(true);
$config = simplexml_load_file($configPath, options: LIBXML_NONET | LIBXML_NOBLANKS);
libxml_use_internal_errors($previous);
if (!$config instanceof SimpleXMLElement) {
    fwrite(STDERR, "Unable to parse {$configPath}.\n");
    exit(2);
}

/** @var array<string, true> $files */
$files = [];
foreach ($config->testsuites->testsuite ?? [] as $suite) {
    foreach ($suite->directory as $directory) {
        $pattern = $root . '/' . trim((string) $directory);
        foreach (glob($pattern, GLOB_ONLYDIR) ?: [] as $matchedDirectory) {
            $iterator = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($matchedDirectory, FilesystemIterator::SKIP_DOTS),
            );
            foreach ($iterator as $candidate) {
                if (!$candidate instanceof SplFileInfo || !$candidate->isFile() || $candidate->isLink()) {
                    continue;
                }
                $path = str_replace('\\', '/', $candidate->getPathname());
                if (!str_ends_with($path, 'Test.php')) {
                    continue;
                }
                $files[substr($path, strlen($root) + 1)] = true;
            }
        }
    }
    foreach ($suite->file as $file) {
        $path = $root . '/' . trim((string) $file);
        if (!is_file($path) || is_link($path)) {
            fwrite(STDERR, "Configured PHPUnit test file is unavailable or unsafe: {$path}.\n");
            exit(2);
        }
        $files[substr(str_replace('\\', '/', $path), strlen($root) + 1)] = true;
    }
}

if ($files === []) {
    fwrite(STDERR, "No PHPUnit test files were discovered from phpunit.xml.dist.\n");
    exit(2);
}

require_once __DIR__ . '/lib/random-order-scope.php';

$mode = 'full';
// Synthetic default for the no-`--only` case: there is no real selection
// decision to embed, so this is not a document ros_select() could ever
// produce itself (a genuine full document's fallback_reason is always
// non-null — ros_select() sets mode to 'full' exactly when it has a
// reason). Giving it an explicit reason instead of `null` keeps that
// pairing intact, so a consumer reading `mode`/`fallback_reason` out of
// the plan (spec §9 CI evidence-publishing) can't mistake this for a real
// selector decision with a blank rationale.
$selection = ros_document(
    'full',
    'no selection document supplied to the planner',
    '',
    '',
    ['inventory_files' => count($files)],
);
$onlyPath = $options['only'] ?? '';
if (is_string($onlyPath) && $onlyPath !== '') {
    try {
        $selection = json_decode((string) file_get_contents($onlyPath), true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $exception) {
        fwrite(STDERR, "Unable to read the selection document: {$exception->getMessage()}\n");
        exit(2);
    }
    if (!is_array($selection)
        || ($selection['schema_version'] ?? null) !== 1
        || !is_array($selection['selected_paths'] ?? null)
        || !in_array($selection['mode'] ?? null, ['full', 'targeted'], true)
    ) {
        fwrite(STDERR, "The selection document must use schema_version 1, an array of selected_paths, and mode full or targeted.\n");
        exit(2);
    }
    foreach ($selection['selected_paths'] as $path) {
        if (!isset($files[$path])) {
            fwrite(STDERR, "Selected path is absent from the discovered inventory: {$path}\n");
            exit(2);
        }
    }
    if ($selection['mode'] === 'targeted') {
        $mode = 'targeted';
        // Re-expand to complete groups: the planner owns group membership.
        $selectedGroups = [];
        foreach ($selection['selected_paths'] as $path) {
            $selectedGroups[ros_group_of($path)] = true;
        }
        foreach (array_keys($files) as $path) {
            if (!isset($selectedGroups[ros_group_of($path)])) {
                unset($files[$path]);
            }
        }
    }
}

if ($files === []) {
    fwrite(STDERR, "Selection retained no test files.\n");
    exit(2);
}

// Suite assignment must be total and unique.
try {
    $suiteOf = ros_inventory($root);
} catch (RosScopeFailure $failure) {
    fwrite(STDERR, "Unable to resolve the PHPUnit suite inventory: {$failure->getMessage()}\n");
    exit(2);
}
// Defensive, not reachable: this loop and ros_inventory() parse the same
// phpunit.xml.dist with the same Test.php-suffix/skip-link filters, so their
// key sets are identical by construction. Retained in case the two ever
// diverge.
foreach (array_keys($files) as $path) {
    if (!isset($suiteOf[$path])) {
        fwrite(STDERR, "Test file resolves to no PHPUnit suite: {$path}\n");
        exit(2);
    }
}

ksort($files);
$known = array_values(array_intersect_key($timings, $files));
sort($known, SORT_NUMERIC);
$fallbackSeconds = $known === [] ? 1.0 : max(0.001, $known[intdiv(count($known), 2)]);

/** @var array<string, array{paths: list<string>, seconds: float, fallback_files: int}> $groups */
$groups = [];
foreach (array_keys($files) as $path) {
    if (preg_match('#^packages/([^/]+)/#', $path, $matches) === 1) {
        $group = 'packages/' . $matches[1];
    } elseif (preg_match('#^tests/([^/]+)/#', $path, $matches) === 1) {
        $group = 'tests/' . $matches[1];
    } else {
        $group = 'tests';
    }
    $groups[$group] ??= ['paths' => [], 'seconds' => 0.0, 'fallback_files' => 0];
    $groups[$group]['paths'][] = $path;
    $groups[$group]['seconds'] += $timings[$path] ?? $fallbackSeconds;
    $groups[$group]['fallback_files'] += isset($timings[$path]) ? 0 : 1;
}
uksort($groups, static fn(string $left, string $right): int => ($groups[$right]['seconds'] <=> $groups[$left]['seconds']) ?: ($left <=> $right));

$actualShardCount = $shardCount;
/** @var list<array{id: int, paths: list<string>, expected_seconds: float, fallback_files: int}> $shards */
$shards = [];
for ($id = 1; $id <= $actualShardCount; ++$id) {
    $shards[] = ['id' => $id, 'paths' => [], 'expected_seconds' => 0.0, 'fallback_files' => 0];
}
foreach ($groups as $group) {
    usort($shards, static fn(array $left, array $right): int => ($left['expected_seconds'] <=> $right['expected_seconds']) ?: ($left['id'] <=> $right['id']));
    array_push($shards[0]['paths'], ...$group['paths']);
    $shards[0]['expected_seconds'] += $group['seconds'];
    $shards[0]['fallback_files'] += $group['fallback_files'];
}
usort($shards, static fn(array $left, array $right): int => $left['id'] <=> $right['id']);

$matrix = [];
foreach ($shards as $shard) {
    sort($shard['paths'], SORT_STRING);

    $suites = [];
    foreach ($shard['paths'] as $path) {
        $suites[$suiteOf[$path]][] = $path;
    }
    ksort($suites);

    $matrix[] = [
        'id' => $shard['id'],
        'paths' => implode("\n", $shard['paths']),
        'suites' => $suites,
        'empty' => $shard['paths'] === [],
        'test_files' => count($shard['paths']),
        'expected_seconds' => round($shard['expected_seconds'], 6),
        'fallback_files' => $shard['fallback_files'],
    ];
}

$phpunitVersionOutput = trim((string) shell_exec(
    escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($root . '/vendor/bin/phpunit') . ' --version 2>/dev/null',
));
$phpunitVersion = 'unknown';
if ($phpunitVersionOutput !== '' && preg_match('/PHPUnit\s+(\S+)/', $phpunitVersionOutput, $versionMatches) === 1) {
    $phpunitVersion = $versionMatches[1];
}

$document = [
    'schema_version' => 1,
    'mode' => $mode,
    'source' => $timingDocument['source'] ?? null,
    'fallback_seconds' => round($fallbackSeconds, 6),
    'test_files' => count($files),
    'test_groups' => count($groups),
    'timed_files' => count($known),
    'fallback_files' => count($files) - count($known),
    'selection' => $selection,
    'seed' => isset($options['seed']) ? (int) $options['seed'] : null,
    'phpunit_version' => $phpunitVersion,
    'include' => $matrix,
];

echo json_encode(
    $document,
    JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR | ($pretty ? JSON_PRETTY_PRINT : 0),
), "\n";
