#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Sentinel-secret regression proof for #2647.
 *
 * `skeleton/bin/post-create-setup.php` writes `.env` at create-project time
 * with a freshly generated `WAASEYAA_JWT_SECRET` and `WAASEYAA_APP_SECRET`.
 * `skeleton/Dockerfile`'s production stage runs `COPY . /app`, so until
 * `skeleton/.dockerignore` excluded `.env`, both secrets were baked into a
 * distributable image layer.
 *
 * What this gate proves, on a real Docker daemon:
 *
 *   1. build-context inventory — the file list the daemon actually received
 *      for the skeleton context, after `.dockerignore` filtering;
 *   2. image filesystem — the flattened rootfs of an image built from that
 *      context (`docker export`);
 *   3. every saved layer — each blob inside `docker save`, scanned raw and
 *      gzip-decoded.
 *
 * None of the three may contain a generated secret. `.env.example` must
 * survive all three, because it is the placeholder template create-project
 * reads and the negation in `.dockerignore` is deliberate.
 *
 * Why a `FROM scratch` probe rather than `skeleton/Dockerfile` itself:
 * `.dockerignore` is applied by the client to the context *before* any
 * instruction runs, so the context inventory is the hard upper bound on what
 * any `COPY`/`ADD` from the context can place in any layer. The probe copies
 * the whole context — strictly more than the real Dockerfile's `COPY . /app`
 * — so a clean probe implies a clean production image. The probe needs no base
 * image, no network and no Composer resolution, which keeps it runnable in the
 * Architecture suite in seconds. `dockerfileContextEscapes()` closes the one
 * remaining hole by rejecting a Dockerfile that reaches outside the context
 * (remote `ADD`, or a `COPY`/`ADD` naming a dotenv source).
 *
 * A positive control runs first: the same three inspections are performed
 * against a context with `.dockerignore` removed, and MUST observe the leak on
 * all three surfaces. Without it, a broken matcher would pass vacuously.
 *
 * Platform notes (#2647 review). One genuine POSIX assumption was found and
 * fixed: the null device in the proc_open() descriptor spec, which was the
 * literal "/dev/null" and made proc_open() return false on native Windows --
 * where a false return was then read as "docker is missing". See nullDevice()
 * and launcherFailureReason(). The rest of the file was audited in the same
 * pass and these are deliberately left as they are:
 *
 * - Forward slashes in path concatenation. PHP's file APIs accept "/" on
 *   Windows; DIRECTORY_SEPARATOR would add noise without adding correctness.
 * - mkdir() modes (0o700 / 0o777) and the chmod() in copyDirectory(). Both are
 *   no-ops on Windows. They apply to a throwaway temp copy whose POSIX modes
 *   cannot affect what this gate measures -- which files reach the context, and
 *   their bytes.
 * - basename() on tar entries and Dockerfile sources. Windows also splits on
 *   "\", but Docker emits forward slashes in tar and Dockerfiles use them, so
 *   the extra separator is unreachable here. A pathological filename containing
 *   a literal backslash would over-match, i.e. fail the gate, which is the safe
 *   direction.
 * - The `tar` dependency. Windows 10 1803+ ships bsdtar as tar.exe. If it is
 *   absent, run() reports launched=false and tarEntries()/extractTar() raise a
 *   loud harness error naming `tar` -- never a verdict about Docker.
 * - runDocker($args, mustSucceed: false). The best-effort cleanup calls
 *   (`rm -f`, `image rm -f`) ignore both `launched` and `code` by design: they
 *   run from the shutdown handler, they cannot report anything, and a failure
 *   to remove a throwaway image must not mask the verdict already reached.
 *   Every mustSucceed call site branches on `launched` before `code`.
 * - Container-side paths ("/context", "/waaseyaa-noop"). Those are Linux paths
 *   inside the image, independent of the host.
 *
 * preg_split('/\R/') is already used for every parsed file, so a CRLF checkout
 * of .dockerignore or Dockerfile parses identically.
 *
 * Exit codes:
 *   0  every inspection passed
 *   1  a secret reached the context, the image filesystem, or a layer
 *   2  the harness itself could not run (bad inputs, Docker error)
 *   3  Docker is unavailable and --allow-missing-docker was passed
 *
 * Usage:
 *   php bin/check-skeleton-docker-secret-exclusion
 *   php bin/check-skeleton-docker-secret-exclusion --allow-missing-docker
 *   php bin/check-skeleton-docker-secret-exclusion --keep   # retain artifacts
 *   php bin/check-skeleton-docker-secret-exclusion --self-test  # runner only, no Docker
 */

const EXIT_PASS = 0;
const EXIT_LEAK = 1;
const EXIT_HARNESS = 2;
const EXIT_NO_DOCKER = 3;

/** Longest sentinel we search for; bounds the streaming-scan overlap window. */
const SENTINEL_WINDOW = 512;

// Deliberately dependency-free: no vendor/autoload.php. ci/skeleton-create-project
// is the hosted job with a Docker daemon and it never installs this repo's own
// vendor tree, so the gate must run before (and without) `composer install`.
// Subprocesses therefore use proc_open() with FILE descriptors rather than pipes,
// which cannot deadlock on a full buffer (the hazard #2491 governs for pipes).

$flags = array_slice($argv, 1);
$allowMissingDocker = in_array('--allow-missing-docker', $flags, true);
$keepArtifacts = in_array('--keep', $flags, true);

// Platform correctness of the subprocess runner, proven without Docker, without
// a daemon, and without the platform under test. Deliberately reachable before
// any Docker probe so it can be asserted on every runner, Linux CI included.
if (in_array('--self-test', $flags, true)) {
    exit(selfTest());
}

$root = dirname(__DIR__);
$skeleton = $root . '/skeleton';
if (!is_dir($skeleton)) {
    fwrite(STDERR, "Skeleton Docker secret gate: {$skeleton} is missing.\n");
    exit(EXIT_HARNESS);
}

// Before anything may conclude that Docker is absent, prove the launcher works.
// A launcher fault otherwise impersonates a missing daemon, and that verdict is
// exactly what makes a run eligible for the --allow-missing-docker skip path --
// so the proof would appear to skip honestly while Docker was in fact present.
// This is a harness error (exit 2) and is NOT skippable, whatever flags say.
$launcherBroken = launcherFailureReason();
if ($launcherBroken !== null) {
    fwrite(STDERR, <<<TEXT
        Skeleton Docker secret gate: the subprocess launcher is broken.

          {$launcherBroken}

        This is NOT a statement about Docker, and --allow-missing-docker does not
        apply to it: the gate cannot tell whether Docker is present while it
        cannot start a process at all. Fix the runner, then re-run.

        TEXT);
    exit(EXIT_HARNESS);
}

$docker = classifyDocker();

// A Docker probe that could not be STARTED -- after the launcher was proven good
// and after this same binary already launched -- is a harness fault. It shares
// the launcher fault's disposition exactly: exit 2, and --allow-missing-docker
// does not apply. Routing it to the unavailable branch below would hand the flag
// a pass-shaped skip over a broken harness.
if ($docker['kind'] === 'harness') {
    $reason = $docker['reason'];
    fwrite(STDERR, <<<TEXT
        Skeleton Docker secret gate: a Docker probe could not be started.

          {$reason}

        This is NOT a verdict that Docker is unavailable, and --allow-missing-docker
        does not apply to it. Fix the harness, then re-run.

        TEXT);
    exit(EXIT_HARNESS);
}

if ($docker['kind'] === 'unavailable') {
    $unavailable = $docker['reason'];
    if ($allowMissingDocker) {
        fwrite(STDERR, "Skeleton Docker secret gate: SKIPPED — {$unavailable}\n");
        exit(EXIT_NO_DOCKER);
    }

    fwrite(STDERR, <<<TEXT
        Skeleton Docker secret gate: Docker is REQUIRED and unavailable.

          {$unavailable}

        This gate is the only proof that a generated .env secret stays out of the
        skeleton image. Reading skeleton/.dockerignore as text does not satisfy it.
        Install or start Docker, or pass --allow-missing-docker to exit 3 instead
        of failing. Hosted CI must never pass that flag.

        TEXT);
    exit(EXIT_HARNESS);
}

$workspace = makeTempDir('waaseyaa-2647-');
// Image tags carry this run's random token so two concurrent runs on one
// daemon cannot build over, or clean up, each other's images.
$run = basename($workspace);
$tags = [];
$containers = [];

register_shutdown_function(static function () use (&$workspace, &$tags, &$containers, $keepArtifacts): void {
    foreach ($containers as $container) {
        runDocker(['rm', '-f', $container], false);
    }
    foreach ($tags as $tag) {
        runDocker(['image', 'rm', '-f', $tag], false);
    }
    if ($keepArtifacts) {
        fwrite(STDERR, "Skeleton Docker secret gate: artifacts kept in {$workspace}\n");

        return;
    }
    removeDirectory($workspace);
});

try {
    $failures = [];

    $project = $workspace . '/project';
    copyDirectory($skeleton, $project);

    // Generate .env exactly the way a consumer's create-project does, so the
    // sentinels below are the real generator's output, not a stand-in.
    $setup = run([PHP_BINARY, $project . '/bin/post-create-setup.php'], $project);
    if (!$setup['launched']) {
        throw new RuntimeException('post-create-setup.php could not be started.');
    }
    if ($setup['code'] !== 0 || !is_file($project . '/.env')) {
        throw new RuntimeException(
            "post-create-setup.php did not write .env:\n" . $setup['stderr'] . $setup['stdout'],
        );
    }

    $generated = (string) file_get_contents($project . '/.env');
    $sentinels = [
        '.env WAASEYAA_JWT_SECRET' => requireGeneratedValue($generated, 'WAASEYAA_JWT_SECRET'),
        '.env WAASEYAA_APP_SECRET' => requireGeneratedValue($generated, 'WAASEYAA_APP_SECRET'),
    ];

    // Additional dotenv shapes a real project accumulates. Each carries its own
    // sentinel, so a pattern that catches `.env` but not `.env.local` is caught.
    $variants = [
        '.env.local' => 'WAASEYAA_SENTINEL_LOCAL_' . bin2hex(random_bytes(8)),
        '.env.production' => 'WAASEYAA_SENTINEL_PRODUCTION_' . bin2hex(random_bytes(8)),
        '.env.local.php' => 'WAASEYAA_SENTINEL_LOCAL_PHP_' . bin2hex(random_bytes(8)),
        'config/.env' => 'WAASEYAA_SENTINEL_NESTED_' . bin2hex(random_bytes(8)),
        'config/.env.staging' => 'WAASEYAA_SENTINEL_NESTED_STAGING_' . bin2hex(random_bytes(8)),
    ];
    foreach ($variants as $relative => $sentinel) {
        $target = $project . '/' . $relative;
        if (!is_dir(dirname($target)) && !mkdir(dirname($target), 0o777, true) && !is_dir(dirname($target))) {
            throw new RuntimeException('Unable to create ' . dirname($target) . '.');
        }
        file_put_contents($target, "SECRET={$sentinel}\n");
        $sentinels[$relative] = $sentinel;
    }

    if (!is_file($project . '/.env.example')) {
        throw new RuntimeException('skeleton/.env.example is missing; the negation cannot be proven.');
    }

    printf(
        "Skeleton Docker secret gate\n  context copy: %s\n  sentinels: %d (2 generated by post-create-setup.php, %d seeded dotenv variants)\n\n",
        $project,
        count($sentinels),
        count($variants),
    );

    // ------------------------------------------------------------------
    // Positive control. With .dockerignore removed, every sentinel MUST be
    // observed on all three surfaces; otherwise the subject PASS below would
    // be the harness failing to look, not the leak being closed.
    // ------------------------------------------------------------------
    $control = $workspace . '/control';
    copyDirectory($project, $control);
    unlink($control . '/.dockerignore');

    $controlReport = inspectContext(
        $control,
        $run . '-control',
        $workspace . '/control-artifacts',
        $sentinels,
        $tags,
        $containers,
    );

    if ($controlReport['dotenvPaths'] === []) {
        $failures[] = 'positive control: no dotenv file appeared in the build-context inventory even '
            . 'with .dockerignore removed. The inventory reader is broken and a PASS would be meaningless.';
    }
    foreach ($sentinels as $label => $sentinel) {
        if (!in_array($sentinel, $controlReport['rootfsHits'], true)) {
            $failures[] = "positive control: {$label} was not observed in the image filesystem with "
                . '.dockerignore removed; the filesystem scan cannot detect a leak.';
        }
        if (($controlReport['layerHits'][$sentinel] ?? []) === []) {
            $failures[] = "positive control: {$label} was not observed in any saved layer with "
                . '.dockerignore removed; the layer scan cannot detect a leak.';
        }
    }

    printf(
        "  positive control (.dockerignore removed): %d context entries, %d dotenv files, leak observed on all three surfaces\n",
        count($controlReport['inventoryPaths']),
        count($controlReport['dotenvPaths']),
    );

    // ------------------------------------------------------------------
    // The real assertion: the skeleton context exactly as shipped.
    // ------------------------------------------------------------------
    $report = inspectContext(
        $project,
        $run . '-subject',
        $workspace . '/subject-artifacts',
        $sentinels,
        $tags,
        $containers,
    );

    printf(
        "  subject context: %d entries received by the daemon; %d saved blob(s) scanned raw and gzip-decoded\n\n",
        count($report['inventoryPaths']),
        $report['layerCount'],
    );

    foreach ($report['dotenvPaths'] as $entry) {
        if (basename($entry) === '.env.example') {
            continue;
        }
        $failures[] = "build-context inventory: dotenv file reached the build context ({$entry}).";
    }

    foreach ($sentinels as $label => $sentinel) {
        if (in_array($sentinel, $report['rootfsHits'], true)) {
            $failures[] = "image filesystem: {$label} is readable in the image rootfs.";
        }
        foreach ($report['layerHits'][$sentinel] ?? [] as $blob) {
            $failures[] = "saved layers: {$label} is readable in layer blob {$blob}.";
        }
    }

    if (!in_array('.env.example', $report['inventoryPaths'], true)) {
        $failures[] = '.env.example did not reach the build context; the intentional `!.env.example` '
            . 'negation in skeleton/.dockerignore has regressed.';
    }

    foreach (dockerfileContextEscapes($skeleton . '/Dockerfile') as $problem) {
        $failures[] = $problem;
    }

    if ($failures !== []) {
        fwrite(STDERR, "FAIL — a generated skeleton secret can reach a distributable image:\n");
        foreach ($failures as $failure) {
            fwrite(STDERR, "  - {$failure}\n");
        }
        fwrite(
            STDERR,
            "\nFix skeleton/.dockerignore; see docs/upgrade-notes/skeleton-docker-env-exclusion.md.\n",
        );
        exit(EXIT_LEAK);
    }

    echo "PASS — no generated secret reached the build context, the image filesystem, or any saved layer.\n";
    echo "PASS — .env.example survived the exclusion, as intended.\n";
    exit(EXIT_PASS);
} catch (Throwable $error) {
    fwrite(STDERR, 'Skeleton Docker secret gate: harness error — ' . $error->getMessage() . "\n");
    exit(EXIT_HARNESS);
}

/**
 * Build a `FROM scratch` image from $context and read back the three surfaces
 * #2647 cares about.
 *
 * @param array<string, string> $sentinels
 * @param list<string>          $tags
 * @param list<string>          $containers
 *
 * @return array{
 *     inventoryPaths: list<string>,
 *     dotenvPaths: list<string>,
 *     rootfsHits: list<string>,
 *     layerHits: array<string, list<string>>,
 *     layerCount: int
 * }
 */
function inspectContext(
    string $context,
    string $tag,
    string $artifacts,
    array $sentinels,
    array &$tags,
    array &$containers,
): array {
    if (!mkdir($artifacts, 0o777, true) && !is_dir($artifacts)) {
        throw new RuntimeException("Unable to create {$artifacts}.");
    }

    // Kept outside $context so the probe never becomes part of the inventory it
    // is measuring.
    $dockerfile = $artifacts . '/probe.Dockerfile';
    file_put_contents($dockerfile, "FROM scratch\nCOPY . /context\n");

    runDocker(['build', '--no-cache', '-f', $dockerfile, '-t', $tag, $context]);
    $tags[] = $tag;

    $container = $tag . '-export';
    runDocker(['create', '--name', $container, $tag, '/waaseyaa-noop']);
    $containers[] = $container;

    $rootfs = $artifacts . '/rootfs.tar';
    runDocker(['export', $container, '-o', $rootfs]);

    $saved = $artifacts . '/image.tar';
    runDocker(['save', $tag, '-o', $saved]);

    $inventory = [];
    foreach (tarEntries($rootfs) as $entry) {
        // `docker export` adds daemon-owned entries (.dockerenv, /dev, resolver
        // files) that were never part of the build context.
        if (!str_starts_with($entry, 'context/')) {
            continue;
        }
        $relative = rtrim(substr($entry, strlen('context/')), '/');
        if ($relative !== '') {
            $inventory[] = $relative;
        }
    }
    sort($inventory);

    $dotenv = array_values(array_filter($inventory, static function (string $entry): bool {
        $base = basename($entry);

        return $base === '.env' || str_starts_with($base, '.env.');
    }));

    $sentinelValues = array_values($sentinels);
    $rootfsHits = scanFile($rootfs, $sentinelValues);

    $savedRoot = $artifacts . '/saved';
    if (!mkdir($savedRoot, 0o777, true) && !is_dir($savedRoot)) {
        throw new RuntimeException("Unable to create {$savedRoot}.");
    }
    extractTar($saved, $savedRoot);

    /** @var array<string, list<string>> $layerHits */
    $layerHits = array_fill_keys($sentinelValues, []);
    $layerCount = 0;
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($savedRoot, FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || !$file->isFile()) {
            continue;
        }
        ++$layerCount;
        foreach (scanFile($file->getPathname(), $sentinelValues) as $hit) {
            $layerHits[$hit][] = $file->getBasename();
        }
    }

    return [
        'inventoryPaths' => $inventory,
        'dotenvPaths' => $dotenv,
        'rootfsHits' => $rootfsHits,
        'layerHits' => $layerHits,
        'layerCount' => $layerCount,
    ];
}

/**
 * Search a file for any of $needles, both as stored and gzip-decoded, so a
 * compressed layer blob cannot hide a secret from the scan.
 *
 * @param list<string> $needles
 *
 * @return list<string> the needles that were found
 */
function scanFile(string $path, array $needles): array
{
    if ($needles === []) {
        return [];
    }

    $found = streamContains($path, $needles);

    $handle = fopen($path, 'rb');
    if ($handle === false) {
        return $found;
    }
    $magic = (string) fread($handle, 2);
    fclose($handle);

    if ($magic === "\x1f\x8b") {
        $gz = gzopen($path, 'rb');
        if ($gz !== false) {
            $found = array_values(array_unique(array_merge($found, streamContains($path, $needles, $gz))));
            gzclose($gz);
        }
    }

    return $found;
}

/**
 * @param list<string>  $needles
 * @param resource|null $stream an already-open (possibly decompressing) handle
 *
 * @return list<string>
 */
function streamContains(string $path, array $needles, $stream = null): array
{
    $handle = $stream ?? fopen($path, 'rb');
    if ($handle === false) {
        return [];
    }

    $found = [];
    $carry = '';
    while (!feof($handle)) {
        $chunk = fread($handle, 1 << 20);
        if ($chunk === false || $chunk === '') {
            break;
        }
        $buffer = $carry . $chunk;
        foreach ($needles as $needle) {
            if (!in_array($needle, $found, true) && str_contains($buffer, $needle)) {
                $found[] = $needle;
            }
        }
        $carry = substr($buffer, -SENTINEL_WINDOW);
    }

    if ($stream === null) {
        fclose($handle);
    }

    return $found;
}

/**
 * Reject a Dockerfile that could place content in a layer without it passing
 * through the (proven clean) build context.
 *
 * @return list<string>
 */
function dockerfileContextEscapes(string $dockerfilePath): array
{
    if (!is_file($dockerfilePath)) {
        return ['skeleton/Dockerfile is missing; the build-context bound cannot be argued.'];
    }

    $problems = [];
    $lines = preg_split('/\R/', (string) file_get_contents($dockerfilePath)) ?: [];
    $continued = '';
    $continuedFrom = 0;

    foreach ($lines as $index => $raw) {
        $line = trim($raw);
        if ($continued === '' && ($line === '' || str_starts_with($line, '#'))) {
            continue;
        }
        if (str_ends_with($line, '\\')) {
            if ($continued === '') {
                $continuedFrom = $index + 1;
            }
            $continued .= rtrim(substr($line, 0, -1)) . ' ';
            continue;
        }
        $number = $continued === '' ? $index + 1 : $continuedFrom;
        $line = trim($continued . $line);
        $continued = '';

        if (preg_match('/^(COPY|ADD)\s+(.*)$/i', $line, $match) !== 1) {
            continue;
        }

        $instruction = strtoupper($match[1]);
        $arguments = preg_split('/\s+/', trim($match[2])) ?: [];
        $fromAnotherStage = false;
        while ($arguments !== [] && str_starts_with($arguments[0], '--')) {
            $flag = strtolower((string) array_shift($arguments));
            if (str_starts_with($flag, '--from=')) {
                $fromAnotherStage = true;
            }
        }
        // The destination is the final argument; everything before it is a source.
        array_pop($arguments);

        foreach ($arguments as $source) {
            if (preg_match('#^[a-z][a-z0-9+.-]*://#i', $source) === 1) {
                $problems[] = sprintf(
                    'skeleton/Dockerfile line %d: %s fetches %s from outside the build context, so the '
                    . 'context inventory no longer bounds what can land in a layer.',
                    $number,
                    $instruction,
                    $source,
                );
                continue;
            }
            if ($fromAnotherStage) {
                continue;
            }
            $base = basename(rtrim($source, '/'));
            if ($base === '.env' || (str_starts_with($base, '.env.') && $base !== '.env.example')) {
                $problems[] = sprintf(
                    'skeleton/Dockerfile line %d: %s names %s explicitly, which would defeat the '
                    . '.dockerignore exclusion.',
                    $number,
                    $instruction,
                    $source,
                );
            }
        }
    }

    return $problems;
}

function requireGeneratedValue(string $env, string $key): string
{
    if (preg_match('/^' . preg_quote($key, '/') . '=(.+)$/m', $env, $match) !== 1) {
        throw new RuntimeException("post-create-setup.php did not populate {$key} in .env.");
    }
    $value = trim($match[1]);
    if (strlen($value) < 16) {
        throw new RuntimeException(
            "{$key} does not look like generated material (got " . var_export($value, true) . ').',
        );
    }

    return $value;
}

/**
 * Classify Docker into exactly one of three states. The kinds are kept distinct
 * because only one of them may ever reach the skippable exit-3 path.
 *
 * The invariant strengthens as this function proceeds, and the classification
 * has to strengthen with it:
 *
 * - On entry, launcherFailureReason() has returned null, so the launcher works.
 *   A `docker --version` that fails to START is therefore a `docker` that is not
 *   on PATH: genuinely 'unavailable'.
 * - Past that point a second fact holds -- this exact binary launched moments
 *   ago from this exact PATH. So a `docker info` that fails to START cannot be
 *   an absent daemon: an absent daemon still lets the CLI start, it just answers
 *   with an error. It is a harness or launcher fault, and folding it in with a
 *   non-zero exit would route it to 'unavailable' and hand --allow-missing-docker
 *   a pass-shaped skip over a broken harness. That is the launcher defect again,
 *   one call site later.
 *
 * Only a `docker info` that actually RAN and exited non-zero is an unavailable
 * daemon.
 *
 * @return array{kind: 'ok'|'unavailable'|'harness', reason: string}
 */
function classifyDocker(): array
{
    $version = run(['docker', '--version']);
    if (!$version['launched']) {
        return [
            'kind' => 'unavailable',
            'reason' => 'the `docker` CLI is not on PATH (the launcher is known-good; `docker` itself did not start).',
        ];
    }
    if ($version['code'] !== 0) {
        return [
            'kind' => 'unavailable',
            'reason' => 'the `docker` CLI is on PATH but did not answer --version.',
        ];
    }

    $info = run(['docker', 'info', '--format', '{{.ServerVersion}}']);
    if (!$info['launched']) {
        return [
            'kind' => 'harness',
            'reason' => '`docker info` could not be started, even though `docker --version` launched from the '
                . 'same PATH moments earlier. An absent daemon still lets the CLI start, so this is a harness '
                . 'or launcher fault, not an unavailable daemon.',
        ];
    }
    if ($info['code'] !== 0) {
        return [
            'kind' => 'unavailable',
            'reason' => 'the `docker` CLI is present but no daemon answered `docker info`.',
        ];
    }

    return ['kind' => 'ok', 'reason' => ''];
}

/**
 * The platform's null device, derived from the runtime rather than guessed from
 * the environment. Hard-coding "/dev/null" made proc_open() return false on
 * native Windows, and a false return is indistinguishable from a missing binary
 * -- so a working Docker install was reported as absent, which is the one
 * verdict this gate must never produce. launcherFailureReason() is the belt to
 * this braces: it proves the launcher works before any Docker conclusion.
 */
function nullDevice(?string $osFamily = null): string
{
    return ($osFamily ?? PHP_OS_FAMILY) === 'Windows' ? 'NUL' : '/dev/null';
}

/**
 * Run a command, capturing stdout and stderr into temporary FILES rather than
 * pipes. File descriptors cannot fill and wedge the child, so there is no
 * sequential-drain deadlock to avoid and no dependency on symfony/process.
 *
 * `launched` distinguishes "the process never started" from "the process ran
 * and exited non-zero". Callers must not collapse the two: only a command that
 * actually ran can justify a verdict about what that command reported.
 *
 * @param list<string> $command
 * @param string|null  $nullDevice override for stdin; the self-test only
 *
 * @return array{launched: bool, code: int, stdout: string, stderr: string}
 */
function run(array $command, ?string $cwd = null, ?string $nullDevice = null): array
{
    $stdout = tempnam(sys_get_temp_dir(), 'waaseyaa-2647-out-');
    $stderr = tempnam(sys_get_temp_dir(), 'waaseyaa-2647-err-');
    if ($stdout === false || $stderr === false) {
        throw new RuntimeException('Unable to allocate subprocess capture files.');
    }

    $process = @proc_open(
        $command,
        [
            0 => ['file', $nullDevice ?? nullDevice(), 'r'],
            1 => ['file', $stdout, 'w'],
            2 => ['file', $stderr, 'w'],
        ],
        $pipes,
        $cwd,
    );
    if (!is_resource($process)) {
        unlink($stdout);
        unlink($stderr);

        // The process never started. That is EITHER a missing binary OR a
        // launcher/descriptor fault, and this function cannot tell them apart,
        // so it reports neither. The distinction is left to callers that have
        // already proven the launcher itself works.
        return [
            'launched' => false,
            'code' => -1,
            'stdout' => '',
            'stderr' => 'unable to start ' . implode(' ', $command),
        ];
    }

    $code = proc_close($process);
    $result = [
        'launched' => true,
        'code' => $code,
        'stdout' => (string) file_get_contents($stdout),
        'stderr' => (string) file_get_contents($stderr),
    ];
    unlink($stdout);
    unlink($stderr);

    return $result;
}

/**
 * Prove the subprocess launcher itself works, before anything concludes
 * anything about Docker. Without this, a launcher fault -- the Windows
 * "/dev/null" defect, a descriptor-spec regression, an exhausted process table
 * -- looks exactly like "docker is not installed", and silently becomes
 * eligible for the --allow-missing-docker skip path.
 *
 * Requires no Docker and no daemon: it round-trips this very PHP binary.
 */
function launcherFailureReason(): ?string
{
    $marker = 'waaseyaa-2647-launcher-ok';
    $probe = run([PHP_BINARY, '-r', 'echo "' . $marker . '";']);

    if (!$probe['launched']) {
        return sprintf(
            'proc_open() could not start this PHP binary (%s) with null device %s.',
            PHP_BINARY,
            nullDevice(),
        );
    }
    if ($probe['code'] !== 0 || !str_contains($probe['stdout'], $marker)) {
        return sprintf(
            'the launcher started this PHP binary but the round-trip failed (exit %d, stdout %s).',
            $probe['code'],
            var_export($probe['stdout'], true),
        );
    }

    return null;
}

/**
 * Exercise the platform-sensitive parts of the runner without Docker, a daemon,
 * or the platform under test. Three checks:
 *
 *   1. nullDevice() maps every OS family correctly, including Windows;
 *   2. the launcher round-trips a known-good command on THIS platform;
 *   3. the OTHER platform's null device makes proc_open() fail here, which is
 *      what proves the descriptor spec is genuinely platform-sensitive and
 *      reproduces, from any host, the exact failure shape Windows hit.
 */
function selfTest(): int
{
    $failures = [];

    $expected = [
        'Windows' => 'NUL',
        'Linux' => '/dev/null',
        'Darwin' => '/dev/null',
        'BSD' => '/dev/null',
        'Solaris' => '/dev/null',
        'Unknown' => '/dev/null',
    ];
    foreach ($expected as $family => $device) {
        $actual = nullDevice($family);
        if ($actual !== $device) {
            $failures[] = "nullDevice('{$family}') returned '{$actual}', expected '{$device}'.";
        }
    }

    $launcher = launcherFailureReason();
    if ($launcher !== null) {
        $failures[] = "the launcher does not work on this platform: {$launcher}";
    }

    // A scratch cwd, so a stray file named NUL (or a dev/ directory) cannot make
    // the wrong-device probe accidentally succeed.
    $scratch = makeTempDir('waaseyaa-2647-selftest-');

    try {
        $foreign = PHP_OS_FAMILY === 'Windows' ? '/dev/null' : 'NUL';
        $wrong = run([PHP_BINARY, '-r', 'echo "unreachable";'], $scratch, $foreign);
        if ($wrong['launched']) {
            $failures[] = sprintf(
                "the foreign null device '%s' opened on %s, so this probe cannot demonstrate that the "
                . 'descriptor spec is platform-sensitive.',
                $foreign,
                PHP_OS_FAMILY,
            );
        }
    } finally {
        removeDirectory($scratch);
    }

    if ($failures !== []) {
        fwrite(STDERR, "SELF-TEST FAIL - the subprocess runner is not platform-correct:\n");
        foreach ($failures as $failure) {
            fwrite(STDERR, "  - {$failure}\n");
        }

        return EXIT_LEAK;
    }

    printf(
        "SELF-TEST PASS - null device is platform-derived (Windows NUL, POSIX /dev/null); "
        . "launcher round-trips on %s; the foreign null device fails here as it must.\n",
        PHP_OS_FAMILY,
    );

    return EXIT_PASS;
}

/**
 * @param list<string> $arguments
 */
function runDocker(array $arguments, bool $mustSucceed = true): string
{
    $result = run(array_merge(['docker'], $arguments));

    if (!$result['launched'] && $mustSucceed) {
        throw new RuntimeException('docker ' . implode(' ', $arguments) . ' could not be started.');
    }
    if ($mustSucceed && $result['code'] !== 0) {
        throw new RuntimeException(
            'docker ' . implode(' ', $arguments) . " failed:\n" . $result['stderr'] . $result['stdout'],
        );
    }

    return $result['stdout'];
}

/**
 * @return list<string>
 */
function tarEntries(string $archive): array
{
    $result = run(['tar', '-tf', $archive]);
    if (!$result['launched']) {
        throw new RuntimeException('`tar` could not be started; it is required to read the image archives.');
    }
    if ($result['code'] !== 0) {
        throw new RuntimeException("tar -tf {$archive} failed:\n" . $result['stderr']);
    }

    return array_values(array_filter(
        preg_split('/\R/', $result['stdout']) ?: [],
        static fn (string $line): bool => $line !== '',
    ));
}

function extractTar(string $archive, string $destination): void
{
    $result = run(['tar', '-xf', $archive, '-C', $destination]);
    if (!$result['launched']) {
        throw new RuntimeException('`tar` could not be started; it is required to read the image archives.');
    }
    if ($result['code'] !== 0) {
        throw new RuntimeException("tar -xf {$archive} failed:\n" . $result['stderr']);
    }
}

function makeTempDir(string $prefix): string
{
    $directory = sys_get_temp_dir() . '/' . $prefix . bin2hex(random_bytes(6));
    if (!mkdir($directory, 0o700, true) && !is_dir($directory)) {
        throw new RuntimeException("Unable to create {$directory}.");
    }

    return $directory;
}

function copyDirectory(string $source, string $destination): void
{
    if (!is_dir($destination) && !mkdir($destination, 0o777, true) && !is_dir($destination)) {
        throw new RuntimeException("Unable to create {$destination}.");
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST,
    );
    foreach ($iterator as $item) {
        if (!$item instanceof SplFileInfo) {
            continue;
        }
        $target = $destination . '/' . $iterator->getSubPathname();
        if ($item->isDir()) {
            if (!is_dir($target) && !mkdir($target, 0o777, true) && !is_dir($target)) {
                throw new RuntimeException("Unable to create {$target}.");
            }
            continue;
        }
        copy($item->getPathname(), $target);
        chmod($target, $item->isExecutable() ? 0o755 : 0o644);
    }
}

function removeDirectory(string $directory): void
{
    if (!is_dir($directory)) {
        return;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );
    foreach ($iterator as $item) {
        if (!$item instanceof SplFileInfo) {
            continue;
        }
        if ($item->isDir()) {
            rmdir($item->getPathname());
        } else {
            unlink($item->getPathname());
        }
    }
    rmdir($directory);
}
