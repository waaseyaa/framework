/**
 * Live scan with transient line numbers (report-time display only — never
 * recorded; roster identity is semantic, see docs/specs/governed-gates.md §6).
 *
 * @return list<array{path: string, pattern: string, class: string, match_sha256: string, occurrence: int, line: int}>
 */
function s1ConfigScan(string $root): array
{
    return s1RosterScan(
        $root,
        ['packages'],
        s1ConfigPatterns(),
        static fn(string $relative, string $contents): bool => str_ends_with($relative, '.php')
            && (str_contains($relative, '/src/')
                || str_contains($relative, '/migrations/')
                || in_array($relative, ['config/waaseyaa.php', 'skeleton/config/waaseyaa.php'], true)),
        static fn(string $relative, string $patternId): string => s1ConfigClass($relative),
        extraFiles: ['config/waaseyaa.php', 'skeleton/config/waaseyaa.php'],
    );
}

/**
 * @param list<array<string, int|string>> $transient Entries from s1ConfigScan().
 * @return array<string, mixed>
 */
function s1ConfigBuildRoster(array $transient): array
{
    return s1RosterDocument(
        's1-configuration-boundaries-v2',
        s1ConfigPatterns(),
        [
            'authority-root',
            'authority-contract',
            'higher-layer-bridge',
            'command-composition',
            'command-adapter',
            'command-orchestrator',
            'sync-adapter',
            'diagnostic-composition',
            'diagnostic-consumer',
            'optional-consumer',
            'derived-consumer',
            'legacy-compatibility',
            'excluded-runtime-overlay',
            'explicit-testing-profile',
            'bootstrap-declaration',
        ],
        s1RosterCanonicalize($transient),
    );
}

/** @param array<string, mixed> $actual */
function s1ConfigAssertContract(array $actual): void
{
    $expected = [
        'schema_version' => 1,
        'contract_id' => 's1-configuration-authority-v1',
        'capability' => 'configuration.authority.v1',
        'capability_version' => 1,
        'authority_provider' => 'Waaseyaa\\Config\\Authority\\ConfigurationAuthorityServiceProvider',
        'active_bridge' => 'Waaseyaa\\EntityStorage\\Config\\DatabaseActiveConfigurationBridge',
        'commands' => ['config:export', 'config:import', 'config:manifest:sign', 'config:diff', 'config:status', 'config:validate', 'config:reset'],
        'canonical_sync_setting' => 'config.sync_path',
        'canonical_sync_environment' => 'WAASEYAA_CONFIG_SYNC_PATH',
        'canonical_sync_default' => 'storage/config-sync',
        'sync_path_revalidation' => 'anchor-device-inode-before-and-after-use',
        'legacy_aliases' => ['config_dir', 'WAASEYAA_CONFIG_DIR'],
        'testing_profile' => 'testing',
        'production_missing_activation' => 'refuse',
        'production_missing_import_gates' => 'refuse',
        'bootstrap_active_collision' => 'refuse',
        'secret_export_policy' => 'references-only',
        'read_only_proof' => 'byte-for-byte',
        'packaged_proofs' => ['path-repository-core-only', 'exact-head-local-archives'],
        'deferred_to' => ['S1-FW-CFG-02', 'S1-FW-CFG-03', 'S1-FW-CFG-04'],
    ];
    if ($actual !== $expected) {
        throw new RuntimeException('S1 configuration machine contract differs from the verifier-owned exact schema and values.');
    }
}

function s1ConfigRequireContains(string $root, string $relative, string $needle): void
{
    $contents = (string) file_get_contents($root . '/' . $relative);
    if (!str_contains($contents, $needle)) {
        throw new RuntimeException(sprintf('%s is missing required CFG-01 semantic anchor: %s', $relative, $needle));
    }
}

try {
    $contract = json_decode(
        (string) file_get_contents($contractPath),
        true,
        flags: JSON_THROW_ON_ERROR,
    );
    if (!is_array($contract)) {
        throw new RuntimeException('S1 configuration contract must decode to an object.');
    }
    s1ConfigAssertContract($contract);

    $transient = s1ConfigScan($root);
    $live = s1ConfigBuildRoster($transient);
    foreach ($transient as $candidate) {
        if ($candidate['class'] === 'unclassified' || !in_array($candidate['class'], $live['allowed_classes'], true)) {
            throw new RuntimeException(sprintf('Unclassified configuration boundary: %s:%d', $candidate['path'], $candidate['line']));
        }
        if ($candidate['pattern'] === 'testing_import_preflight'
            && $candidate['path'] !== 'packages/config/src/Testing/AllowingConfigImportPreflight.php'
        ) {
            throw new RuntimeException(sprintf(
                'AllowingConfigImportPreflight is a testing fixture and cannot be referenced by production source: %s:%d',
                $candidate['path'],
                $candidate['line'],
            ));
        }
    }
    if ($writeRoster) {
        file_put_contents($rosterPath, json_encode($live, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
        fwrite(STDOUT, sprintf("Wrote %d configuration boundary occurrences.\n", count($live['candidates'])));
        exit(0);
    }
    $recorded = json_decode((string) file_get_contents($rosterPath), true, flags: JSON_THROW_ON_ERROR);
    if ($recorded !== $live) {
        $diff = s1RosterDiff(
            is_array($recorded['candidates'] ?? null) ? $recorded['candidates'] : [],
            $transient,
            'php bin/check-s1-configuration-authority --write-roster',
        );
        if ($diff === []) {
            $diff = ['roster metadata (schema/query/patterns/classes) differs — regenerate with php bin/check-s1-configuration-authority --write-roster and commit the roster.'];
        }
        fwrite(STDERR, implode("\n", $diff) . "\n");
        throw new RuntimeException('Configuration authority roster differs from the verifier-owned live occurrence set.');
    }

    $provider = (string) file_get_contents($root . '/packages/cli/src/Provider/ConfigCacheDbAuditServiceProvider.php');
    foreach ($contract['commands'] as $command) {
        if (substr_count($provider, "name: '" . $command . "'") !== 1) {
            throw new RuntimeException(sprintf('Expected exactly one modern adapter for %s.', $command));
        }
    }
    foreach (['config/active', 'config/sync'] as $forbidden) {
        foreach ($live['candidates'] as $candidate) {
            if ($candidate['pattern'] !== 'file_storage_construction') {
                continue;
            }
            $source = (string) file_get_contents($root . '/' . $candidate['path']);
            if (str_contains($source, $forbidden)) {
                throw new RuntimeException(sprintf('Production FileStorage fallback remains for %s in %s.', $forbidden, $candidate['path']));
            }
        }
    }
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ActiveConfigurationBridgeInterface.php', 'extends ConfigSyncFileSourceInterface, ConfigImportApplyHookInterface');
    s1ConfigRequireContains($root, 'packages/entity-storage/src/Config/ConfigurationStorageServiceProvider.php', "=== 'testing'");
    s1ConfigRequireContains($root, 'packages/entity-storage/src/Config/DatabaseActiveConfigurationStorage.php', 'requireActiveGenerationId()');
    s1ConfigRequireContains($root, 'packages/config/src/Sync/RefusingConfigImportPreflight.php', 'CFG-03 schema, manifest, and drift gates are bound');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/DeployableConfigurationPolicy.php', 'immutable bootstrap authority');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/DeployableConfigurationPolicy.php', 'opaque reference field');
    s1ConfigRequireContains($root, 'packages/entity-storage/src/Config/DatabaseConfigurationGenerationResolver.php', 'DeployableConfigurationPolicy::assertDeployableName');
    s1ConfigRequireContains($root, 'packages/entity-storage/migrations/2026_08_12_000002_configuration_authority.php', 'waaseyaa_config_activation');
    s1ConfigRequireContains($root, 'packages/cli/src/Handler/AboutHandler.php', 'Config Selectors');
    s1ConfigRequireContains($root, 'packages/cli/src/Handler/HealthCheckHandler.php', 'selector_provenance');
    s1ConfigRequireContains($root, 'packages/cli/src/Handler/HealthReportHandler.php', 'Config Sync Path');
    s1ConfigRequireContains($root, 'packages/ai-agent/src/Mcp/McpServiceProvider.php', 'NullConfigStorage is permitted only in explicit local/test profiles');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php', 'ConfigSchemaValidator::class');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php', 'RuntimePolicy::isExplicitDevelopment($this->config)');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php', 'requireActiveGenerationId()');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityServiceProvider.php', 'dispatch(new ConfigurationSelectorDeprecationEvent');
    s1ConfigRequireContains($root, 'packages/config/src/Event/ConfigurationSelectorDeprecationEvent.php', "NAME = 'configuration.selector.deprecated'");
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityContext.php', 'assertSyncPathIdentity');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/ConfigurationAuthorityContext.php', "\$stat['ino'] !== \$this->syncPathAnchorInode");
    s1ConfigRequireContains($root, 'packages/config/src/Sync/ConfigSyncRepository.php', "fopen(\$temp, 'x+b')");
    s1ConfigRequireContains($root, 'packages/config/src/Sync/ConfigSyncRepository.php', 'assertRegularMember(basename($temp))');
    s1ConfigRequireContains($root, 'packages/config/src/Sync/ConfigSyncRepository.php', 'identity changed after its first authorized use');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/SyncArtifactStorageAdapter.php', 'openedSyncDirectoryIdentity');
    s1ConfigRequireContains($root, 'packages/config/src/Authority/SyncArtifactStorageAdapter.php', 'assertAllMembers');

    foreach ([
        'packages/ai-agent/src/Mcp/McpServiceProvider.php',
        'packages/cli/src/Provider/ConfigCacheDbAuditServiceProvider.php',
        'packages/cli/src/Provider/HealthSchemaServiceProvider.php',
        'packages/cli/src/Provider/MiscAServiceProvider.php',
        'packages/cli/src/Provider/OptimizeServiceProvider.php',
        'packages/entity-storage/src/Config/ConfigurationStorageServiceProvider.php',
    ] as $consumer) {
        s1ConfigRequireContains($root, $consumer, "CapabilityRequirement::exact('configuration.authority.v1', 1)");
    }

    fwrite(STDOUT, sprintf("S1 configuration authority contract passed: %d classified boundaries, %d commands, one authority.\n", count($live['candidates']), count($contract['commands'])));
} catch (Throwable $exception) {
    fwrite(STDERR, 'S1 configuration authority contract failed: ' . $exception->getMessage() . "\n");
    exit(1);
}
