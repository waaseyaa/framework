#!/usr/bin/env php
<?php

declare(strict_types=1);

/** Exact, forge-neutral inventory and semantic gate for S1-FW-CFG-01. */

require_once __DIR__ . '/lib/s1-roster.php';

$root = dirname(__DIR__);
$rosterPath = $root . '/support/s1-configuration-authority-roster.json';
$contractPath = $root . '/support/s1-configuration-authority-v1.json';
$arguments = array_values(array_filter($_SERVER['argv'] ?? [], 'is_string'));
$writeRoster = in_array('--write-roster', $arguments, true);
foreach ($arguments as $argument) {
    if (str_starts_with($argument, '--roster=')) {
        $candidate = substr($argument, strlen('--roster='));
        $rosterPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
    if (str_starts_with($argument, '--contract=')) {
        $candidate = substr($argument, strlen('--contract='));
        $contractPath = str_starts_with($candidate, '/') ? $candidate : $root . '/' . $candidate;
    }
}

/** @return array<string, string> */
function s1ConfigPatterns(): array
{
    return [
        'active_bridge' => '/\bActiveConfigurationBridgeInterface\b/',
        'active_source' => '/\bConfigSyncFileSourceInterface\b/',
        'apply_hook' => '/\bConfigImportApplyHookInterface\b/',
        'import_preflight' => '/\bConfigImportPreflightInterface\b/',
        'testing_import_preflight' => '/\bAllowingConfigImportPreflight\b/',
        'authority_context' => '/\bConfigurationAuthorityContext\b/',
        'deployable_policy' => '/\bDeployableConfigurationPolicy\b/',
        'factory_compatibility' => '/\bConfigFactoryInterface\b/',
        'manager_compatibility' => '/\bConfigManagerInterface\b/',
        'file_storage_construction' => '/new\s+FileStorage\s*\(/',
        'environment_factory_construction' => '/new\s+EnvironmentConfigFactory\s*\(/',
        'null_config_construction' => '/new\s+NullConfigStorage\s*\(/',
        'canonical_selector' => '/\b(?:config\.sync_path|WAASEYAA_CONFIG_SYNC_PATH)\b/',
        'legacy_selector' => '/\b(?:config_dir|WAASEYAA_CONFIG_DIR)\b/',
        'selector_deprecation' => '/\bConfigurationSelectorDeprecationEvent\b/',
        'sync_path_identity' => '/\b(?:assertSyncPathIdentity|syncPathAnchor(?:Device|Inode)?|openedSyncDirectoryIdentity)\b/',
    ];
}

