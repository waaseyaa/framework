#!/usr/bin/env php
<?php

declare(strict_types=1);

use Opis\JsonSchema\Validator;

// Precondition (#2926): a stale local vendor/ must surface as one actionable
// line with its own exit code, never as `Class "Opis\JsonSchema\Validator"
// not found` (exit 255). The library is dependency-free by design and runs
// before the autoloader is even required, so a missing vendor/ cannot fatal.
require dirname(__DIR__) . '/bin/lib/vendor-freshness.php';
$vendorProblem = vendor_freshness_problem(dirname(__DIR__));
if ($vendorProblem !== null) {
    fwrite(STDERR, vendor_freshness_message($vendorProblem, 'delivery agent event contract'));
    exit(VENDOR_FRESHNESS_EXIT_CODE);
}

require dirname(__DIR__) . '/vendor/autoload.php';
require dirname(__DIR__) . '/bin/lib/delivery-agent-event-set.php';

// Defence in depth: metadata can agree with the lock while the package bytes
// are gone (a hand-deleted vendor/opis). Every mode below — including
// --self-test — dereferences the validator, so refuse here, once, with the
// same precondition code rather than letting PHP fatal later.
if (!class_exists(Validator::class)) {
    fwrite(STDERR, vendor_freshness_message(
        [
            'what' => 'opis/json-schema is locked but its validator class cannot be autoloaded',
            'detail' => Validator::class . ' is not loadable from vendor/ even though vendor/composer/installed.json lists opis/json-schema.',
            'fix' => 'composer install',
        ],
        'delivery agent event contract',
    ));
    exit(VENDOR_FRESHNESS_EXIT_CODE);
}

const LEDGER_SCHEMA = 'ops/observability/delivery-agent-event-v1.schema.json';
const LEDGER_PATH = 'ops/observability/delivery-agent-events-v1.jsonl';
const BATCH_SCHEMA = DELIVERY_AGENT_BATCH_SCHEMA;
const BATCH_DIR = DELIVERY_AGENT_BATCH_DIR;
const V1_FREEZE = DELIVERY_AGENT_V1_FREEZE;

/** @return list<string> */
function validateLedger(string $contents, object $schema): array
{
    $errors = [];
    if ($contents === '') {
        return ['ledger must contain at least one event'];
    }
    if (!str_ends_with($contents, "\n")) {
        $errors[] = 'ledger must be newline-terminated';
    }
    $events = [];
    $eventLines = [];
    $lastRecordedAt = null;
    foreach (preg_split('/\R/', $contents) ?: [] as $index => $line) {
        if ($line === '') {
            continue;
        }
        if (trim($line) === '') {
            $errors[] = sprintf('line %d is blank or whitespace-only', $index + 1);
            continue;
        }
        try {
            $document = json_decode($line, flags: JSON_THROW_ON_ERROR);
            $event = json_decode($line, true, flags: JSON_THROW_ON_ERROR);
        } catch (JsonException $exception) {
            $errors[] = sprintf('line %d is not valid JSON: %s', $index + 1, $exception->getMessage());
            continue;
        }
        if (!is_object($document) || !is_array($event) || array_is_list($event)) {
            $errors[] = sprintf('line %d must be a JSON object', $index + 1);
            continue;
        }
        if (!new Validator()->validate($document, $schema)->isValid()) {
            $errors[] = sprintf('line %d does not conform to %s', $index + 1, LEDGER_SCHEMA);
            continue;
        }
        $recordedAt = new DateTimeImmutable($event['recorded_at']);
        if (is_string($event['occurred_at']) && new DateTimeImmutable($event['occurred_at']) > $recordedAt) {
            $errors[] = sprintf('line %d has an occurrence time after its custody time', $index + 1);
        }
        if ($lastRecordedAt !== null && $recordedAt < $lastRecordedAt) {
            $errors[] = sprintf('line %d has a custody timestamp earlier than the preceding event', $index + 1);
        }
        $lastRecordedAt = $recordedAt;
        $eventId = $event['event_id'];
        if (isset($events[$eventId])) {
            $errors[] = sprintf('line %d duplicates event_id %s first seen on line %d', $index + 1, $eventId, $eventLines[$eventId]);
            continue;
        }
        $events[$eventId] = $event;
        $eventLines[$eventId] = $index + 1;
        validateEventSemantics($event, $events, $eventLines, $index + 1, $errors);
    }
    return $errors;
}

/**
 * @param array<string, mixed> $event
 * @param array<string, array<string, mixed>> $events
 * @param array<string, int> $eventLines
 * @param list<string> $errors
 */
function validateEventSemantics(array $event, array $events, array $eventLines, int $line, array &$errors): void
{
    $type = $event['event_type'];
    $adjudication = $event['adjudication'];
    $causeId = $event['causation_event_id'];

    $cause = null;
    if (is_string($causeId)) {
        $cause = $events[$causeId] ?? null;
        if ($cause === null || ($eventLines[$causeId] ?? PHP_INT_MAX) >= $line) {
            $errors[] = "line {$line}: causation_event_id must name an earlier event";
            return;
        }
        foreach (['repository', 'pull_request'] as $key) {
            if ($cause[$key] !== $event[$key]) {
                $errors[] = "line {$line}: causal event {$key} differs from its predecessor";
            }
        }
        if (new DateTimeImmutable($event['recorded_at']) < new DateTimeImmutable($cause['recorded_at'])) {
            $errors[] = "line {$line}: custody time precedes its causal event";
        }
        if (is_string($event['occurred_at']) && is_string($cause['occurred_at']) && new DateTimeImmutable($event['occurred_at']) < new DateTimeImmutable($cause['occurred_at'])) {
            $errors[] = "line {$line}: occurrence time precedes its causal event";
        }
    }

    if ($type !== 'verification_finding_adjudicated' || !is_string($causeId) || $cause === null) {
        return;
    }
    if ($cause['event_type'] !== 'verification_finding_issued') {
        $errors[] = "line {$line}: an adjudication must cause from a verification finding";
    }
    if ($cause['head_sha'] !== $event['head_sha']) {
        $errors[] = "line {$line}: adjudication head_sha differs from its finding";
    }
    foreach ($events as $priorId => $prior) {
        if ($priorId !== $event['event_id'] && $prior['event_type'] === 'verification_finding_adjudicated' && $prior['causation_event_id'] === $causeId) {
            $errors[] = "line {$line}: finding {$causeId} already has an adjudication";
            break;
        }
    }
    if (is_array($adjudication) && is_array($cause['verification'] ?? null)) {
        $classification = $adjudication['classification'];
        $claimed = $cause['verification']['candidate_defect_claimed'];
        $confirmed = $adjudication['candidate_defect_confirmed'];
        $coherent = match ($classification) {
            'true_positive' => $claimed === true && $confirmed === true,
            'false_positive' => $claimed === true && $confirmed === false,
            'false_negative' => $claimed === false && $confirmed === true,
            'unresolved' => $confirmed === null,
            default => false,
        };
        if (!$coherent) {
            $errors[] = "line {$line}: adjudication classification contradicts claimed and confirmed defect state";
        }
        if ($adjudication['adjudicated_by'] !== $event['actor']['name']) {
            $errors[] = "line {$line}: adjudicated_by differs from the event actor name";
        }
    }
}

/** @return list<string> */
function validateAppendOnly(string $prior, string $current): array
{
    if ($prior === '') {
        return [];
    }
    if (!str_ends_with($prior, "\n")) {
        return ['the base ledger is not newline-terminated'];
    }
    return str_starts_with($current, $prior) ? [] : ['the ledger is not an exact byte-prefix extension of the base ledger'];
}

/** @param list<string> $arguments @return array{exit: int, output: string} */
function gitRun(string $root, array $arguments): array
{
    $pipes = [];
    $process = proc_open(
        [$root . '/bin/git', '-C', $root, ...$arguments],
        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes,
    );
    if (!is_resource($process)) {
        return ['exit' => 1, 'output' => 'could not start git'];
    }
    $output = stream_get_contents($pipes[1]);
    $error = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exit = proc_close($process);
    return ['exit' => $exit, 'output' => $exit === 0 ? $output : $error];
}

/** @return array{exit: int, output: string} */
function gitShow(string $root, string $commit, string $path): array
{
    return gitRun($root, ['show', $commit . ':' . $path]);
}

/** @return array{exit: int, output: string} */
function gitLsTree(string $root, string $commit, string $path): array
{
    return gitRun($root, ['ls-tree', '-r', '--name-only', $commit, '--', $path]);
}

function resolveCommit(string $root, string $ref): ?string
{
    $result = gitRun($root, ['rev-parse', '--verify', '--end-of-options', $ref . '^{commit}']);
    if ($result['exit'] !== 0) {
        return null;
    }
    $lines = array_values(array_filter(preg_split('/\R/', trim($result['output'])) ?: [], static fn(string $line): bool => $line !== ''));

    return count($lines) === 1 && preg_match('/^[0-9a-f]{40}$/D', $lines[0]) === 1 ? $lines[0] : null;
}

/** @return list<string>|null */
function mergeBases(string $root, string $left, string $right): ?array
{
    $result = gitRun($root, ['merge-base', '--all', $left, $right]);
    if ($result['exit'] !== 0) {
        return [];
    }
    $lines = array_values(array_filter(preg_split('/\R/', trim($result['output'])) ?: [], static fn(string $line): bool => $line !== ''));
    foreach ($lines as $line) {
        if (preg_match('/^[0-9a-f]{40}$/D', $line) !== 1) {
            return null;
        }
    }

    return $lines;
}

/** @return list<string>|null */
function commitParents(string $root, string $commit): ?array
{
    $result = gitRun($root, ['rev-list', '--parents', '-n', '1', $commit]);
    if ($result['exit'] !== 0) {
        return null;
    }
    $parts = preg_split('/\s+/', trim($result['output'])) ?: [];
    if (array_shift($parts) !== $commit) {
        return null;
    }

    return array_values($parts);
}

function isStrictAncestor(string $root, string $ancestor, string $descendant): bool
{
    if ($ancestor === $descendant) {
        return false;
    }

    return gitRun($root, ['merge-base', '--is-ancestor', $ancestor, $descendant])['exit'] === 0;
}

function refuseShallowHistory(string $root): void
{
    $result = gitRun($root, ['rev-parse', '--is-shallow-repository']);
    if ($result['exit'] !== 0 || !in_array(trim($result['output']), ['true', 'false'], true)) {
        fwrite(STDERR, "delivery agent event contract: could not determine whether repository history is complete\n");
        exit(2);
    }
    if (trim($result['output']) === 'true') {
        fwrite(STDERR, "delivery agent event contract: branch and candidate modes refuse a shallow repository\n");
        exit(1);
    }
}

/** @param array{exit: int, output: string} $result */
function missingAtCommit(array $result): bool
{
    return $result['exit'] !== 0
        && (str_contains($result['output'], 'exists on disk, but not in')
            || str_contains($result['output'], 'does not exist in'));
}

/** @return array<string, mixed> */
function validEvent(string $id, string $type = 'review_started'): array
{
    return [
        'schema_version' => 'delivery-agent-event/v1', 'event_id' => $id, 'event_type' => $type,
        'recorded_at' => '2026-09-03T20:00:00Z', 'occurred_at' => null,
        'repository' => 'waaseyaa/framework', 'pull_request' => 2869, 'head_sha' => str_repeat('a', 40),
        'actor' => ['kind' => 'codex', 'name' => 'Codex', 'model' => null], 'evidence_kind' => 'observed',
        'causation_event_id' => null, 'review_depth' => null, 'outcome' => null, 'finding_count' => null,
        'token_count' => null, 'elapsed_ms' => null, 'source_url' => null, 'notes' => null,
        'verification' => null, 'adjudication' => null,
    ];
}

function encodeEvent(array $event): string
{
    return json_encode($event, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
}

function readRequiredFile(string $path, string $label): string
{
    if (!is_file($path) || !is_readable($path)) {
        fwrite(STDERR, "delivery agent event contract: {$label} is missing or unreadable: {$path}\n");
        exit(2);
    }
    $contents = file_get_contents($path);
    if (!is_string($contents)) {
        fwrite(STDERR, "delivery agent event contract: could not read {$label}: {$path}\n");
        exit(2);
    }
    return $contents;
}

function selfTest(object $schema): int
{
    $firstId = '11111111-1111-4111-8111-111111111111';
    $finding = validEvent($firstId, 'verification_finding_issued');
    $finding['verification'] = ['verifier_id' => 'probe-1', 'check_type' => 'review_probe', 'claim' => 'the guard refuses malformed input', 'observed' => 'the guard exited non-zero', 'candidate_defect_claimed' => true, 'safety_effect' => 'fail_closed'];
    $adjudication = validEvent('22222222-2222-4222-8222-222222222222', 'verification_finding_adjudicated');
    $adjudication['causation_event_id'] = $firstId;
    $adjudication['adjudication'] = ['classification' => 'false_positive', 'candidate_defect_confirmed' => false, 'rationale' => 'the verifier failed closed without a product defect', 'adjudicated_by' => 'Codex'];
    $valid = encodeEvent($finding) . encodeEvent($adjudication);
    if (validateLedger($valid, $schema) !== []) {
        fwrite(STDERR, "self-test failed: valid causal ledger was refused\n");
        return 1;
    }
    $unknown = $finding;
    $unknown['unexpected'] = true;
    $unknownNested = $finding;
    $unknownNested['actor']['unexpected'] = true;
    $negative = $finding;
    $negative['elapsed_ms'] = -1;
    $badTimestamp = $finding;
    $badTimestamp['recorded_at'] = 'not-a-timestamp';
    $badSha = $finding;
    $badSha['head_sha'] = 'abc123';
    $orphan = $adjudication;
    $orphan['causation_event_id'] = '33333333-3333-4333-8333-333333333333';
    $wrongSha = $adjudication;
    $wrongSha['head_sha'] = str_repeat('b', 40);
    $third = $adjudication;
    $third['event_id'] = '33333333-3333-4333-8333-333333333333';
    $inverted = $adjudication;
    $inverted['recorded_at'] = '2026-09-03T19:59:59Z';
    $incoherent = $adjudication;
    $incoherent['adjudication']['candidate_defect_confirmed'] = true;
    $actorMismatch = $adjudication;
    $actorMismatch['adjudication']['adjudicated_by'] = 'Someone else';
    $futureOccurrence = $finding;
    $futureOccurrence['occurred_at'] = '2026-09-03T20:00:01Z';
    $sourceWithoutUrl = $finding;
    $sourceWithoutUrl['evidence_kind'] = 'source_event';
    $sourceWithInvalidUrl = $finding;
    $sourceWithInvalidUrl['evidence_kind'] = 'source_event';
    $sourceWithInvalidUrl['source_url'] = 'https://';
    $wrongOutcome = $finding;
    $wrongOutcome['outcome'] = 'passed';
    $mutations = [
        'unknown top-level member' => encodeEvent($unknown),
        'unknown nested member' => encodeEvent($unknownNested),
        'negative measurement' => encodeEvent($negative),
        'malformed timestamp' => encodeEvent($badTimestamp),
        'malformed SHA' => encodeEvent($badSha),
        'duplicate event id' => encodeEvent($finding) . encodeEvent($finding),
        'orphan adjudication' => encodeEvent($orphan),
        'cross-SHA adjudication' => encodeEvent($finding) . encodeEvent($wrongSha),
        'duplicate adjudication' => $valid . encodeEvent($third),
        'inverted custody time' => encodeEvent($finding) . encodeEvent($inverted),
        'incoherent adjudication' => encodeEvent($finding) . encodeEvent($incoherent),
        'adjudicator identity mismatch' => encodeEvent($finding) . encodeEvent($actorMismatch),
        'occurrence after custody' => encodeEvent($futureOccurrence),
        'source event without provenance' => encodeEvent($sourceWithoutUrl),
        'source event with malformed provenance' => encodeEvent($sourceWithInvalidUrl),
        'outcome on the wrong event type' => encodeEvent($wrongOutcome),
    ];
    foreach ($mutations as $name => $contents) {
        if (validateLedger($contents, $schema) === []) {
            fwrite(STDERR, "self-test failed: {$name} was accepted\n");
            return 1;
        }
    }
    if (validateAppendOnly(encodeEvent($finding), $valid) !== [] || validateAppendOnly(encodeEvent($finding), encodeEvent($adjudication)) === []) {
        fwrite(STDERR, "self-test failed: append-only guard did not distinguish append from mutation\n");
        return 1;
    }
    fwrite(STDOUT, "delivery agent event self-test: PASS\n");
    return 0;
}

$root = dirname(__DIR__);
$schemaPath = $root . '/' . LEDGER_SCHEMA;
$ledgerPath = $root . '/' . LEDGER_PATH;
$base = null;
$branchBase = null;
$candidate = null;
$head = null;
$priorLedgerPath = null;
$priorSchemaPath = null;
$selfTest = false;
$seen = [];
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--self-test') {
        if (isset($seen['self-test'])) {
            fwrite(STDERR, "delivery agent event contract: duplicate --self-test option\n");
            exit(2);
        }
        $seen['self-test'] = true;
        $selfTest = true;
        continue;
    }
    if (preg_match('/^--(base|branch-base|candidate|head|ledger|prior-ledger|schema|prior-schema)=(.*)$/D', $argument, $matches) !== 1) {
        fwrite(STDERR, "delivery agent event contract: unknown or malformed option {$argument}\n");
        exit(2);
    }
    [, $name, $value] = $matches;
    if ($value === '' || isset($seen[$name])) {
        fwrite(STDERR, "delivery agent event contract: --{$name} must appear once with a non-empty value\n");
        exit(2);
    }
    $seen[$name] = true;
    if ($name === 'base' && $value === str_repeat('0', 40)) {
        fwrite(STDERR, "delivery agent event contract: an all-zero base is not a custody boundary\n");
        exit(2);
    }
    match ($name) {
        'base' => $base = $value,
        'branch-base' => $branchBase = $value,
        'candidate' => $candidate = $value,
        'head' => $head = $value,
        'ledger' => $ledgerPath = $value,
        'prior-ledger' => $priorLedgerPath = $value,
        'schema' => $schemaPath = $value,
        'prior-schema' => $priorSchemaPath = $value,
    };
}
if ($selfTest) {
    if (count($seen) !== 1) {
        fwrite(STDERR, "delivery agent event contract: --self-test cannot be combined with other options\n");
        exit(2);
    }
    $schemaBytes = readRequiredFile($schemaPath, 'schema');
    $schema = json_decode($schemaBytes, flags: JSON_THROW_ON_ERROR);
    exit(selfTest($schema));
}
if ($base !== null && ($priorLedgerPath !== null || $priorSchemaPath !== null)) {
    fwrite(STDERR, "delivery agent event contract: --base and explicit prior files are mutually exclusive\n");
    exit(2);
}

$fixtureOptions = array_intersect(array_keys($seen), ['ledger', 'prior-ledger', 'schema', 'prior-schema']);
if ($branchBase !== null) {
    if ($base !== null || $candidate !== null || $head !== null || $fixtureOptions !== []) {
        fwrite(STDERR, "delivery agent event contract: --branch-base is a canonical-worktree mode and cannot be combined with other custody or fixture options\n");
        exit(2);
    }
    if ($branchBase === str_repeat('0', 40)) {
        fwrite(STDERR, "delivery agent event contract: an all-zero branch base is not a custody boundary\n");
        exit(2);
    }
}
if ($candidate !== null || $head !== null) {
    if ($candidate === null || $base === null) {
        fwrite(STDERR, "delivery agent event contract: --candidate requires --base, and --head requires --candidate\n");
        exit(2);
    }
    if ($branchBase !== null || $fixtureOptions !== []) {
        fwrite(STDERR, "delivery agent event contract: immutable candidate mode cannot use branch or fixture path options\n");
        exit(2);
    }
    foreach (['candidate' => $candidate, 'base' => $base, 'head' => $head] as $label => $sha) {
        if ($sha !== null && preg_match('/^[0-9a-f]{40}$/D', $sha) !== 1) {
            fwrite(STDERR, "delivery agent event contract: --{$label} must be an immutable 40-character commit SHA\n");
            exit(2);
        }
    }
}
if ($branchBase !== null || $candidate !== null) {
    refuseShallowHistory($root);
}

$identity = null;
$priorCommit = null;
if ($candidate !== null) {
    foreach (['candidate' => $candidate, 'base' => $base, 'head' => $head] as $label => $sha) {
        if ($sha !== null && resolveCommit($root, $sha) !== $sha) {
            fwrite(STDERR, "delivery agent event contract: could not resolve immutable {$label} commit {$sha}\n");
            exit(2);
        }
    }
    $topologyErrors = [];
    if ($head !== null) {
        if (commitParents($root, $candidate) !== [$base, $head]) {
            $topologyErrors[] = 'the candidate must have exactly the declared base and head as its two parents, in that order';
        }
    } elseif (!isStrictAncestor($root, $base, $candidate)) {
        $topologyErrors[] = 'the declared base must be a strict ancestor of the candidate';
    }
    refuseShallowHistory($root);
    $candidateLedger = gitShow($root, $candidate, LEDGER_PATH);
    $candidateSchema = gitShow($root, $candidate, LEDGER_SCHEMA);
    if ($candidateLedger['exit'] !== 0 || $candidateSchema['exit'] !== 0) {
        fwrite(STDERR, "delivery agent event contract: candidate must track the canonical ledger and schema\n");
        exit(2);
    }
    $contents = $candidateLedger['output'];
    $schemaBytes = $candidateSchema['output'];
    $priorCommit = $base;
    $identity = sprintf(
        'mode=candidate candidate=%s base=%s head=%s',
        $candidate,
        $base,
        $head ?? 'none',
    );
    $errors = $topologyErrors;
} else {
    $schemaBytes = readRequiredFile($schemaPath, 'schema');
    $contents = readRequiredFile($ledgerPath, 'ledger');
    $errors = [];
    if ($branchBase !== null) {
        $resolvedBranchBase = resolveCommit($root, $branchBase);
        $resolvedHead = resolveCommit($root, 'HEAD');
        if ($resolvedBranchBase === null) {
            fwrite(STDERR, "delivery agent event contract: could not resolve branch base {$branchBase}\n");
            exit(2);
        }
        if ($resolvedHead === null) {
            fwrite(STDERR, "delivery agent event contract: could not resolve worktree HEAD\n");
            exit(2);
        }
        $bases = mergeBases($root, $resolvedBranchBase, $resolvedHead);
        if ($bases === null || count($bases) !== 1) {
            fwrite(STDERR, "delivery agent event contract: branch history must have exactly one merge base\n");
            exit(1);
        }
        refuseShallowHistory($root);
        $priorCommit = $bases[0];
        $identity = sprintf(
            'mode=branch branch_base=%s head=%s merge_base=%s',
            $resolvedBranchBase,
            $resolvedHead,
            $priorCommit,
        );
    } elseif ($base !== null) {
        $priorCommit = $base;
    }
}

try {
    $schema = json_decode($schemaBytes, flags: JSON_THROW_ON_ERROR);
} catch (JsonException $exception) {
    fwrite(STDERR, "delivery agent event contract: schema is not valid JSON: {$exception->getMessage()}\n");
    exit(1);
}
if (!is_object($schema)) {
    fwrite(STDERR, "delivery agent event contract: schema must be a JSON object\n");
    exit(1);
}
array_push($errors, ...validateLedger($contents, $schema));

$freezeBytes = null;
$usingFixtures = $fixtureOptions !== [];
if (!$usingFixtures) {
    if ($candidate !== null) {
        $freezeAtCandidate = gitShow($root, $candidate, V1_FREEZE);
        if ($freezeAtCandidate['exit'] === 0) {
            $freezeBytes = $freezeAtCandidate['output'];
        }
    } elseif (is_file($root . '/' . V1_FREEZE)) {
        $freezeBytes = readRequiredFile($root . '/' . V1_FREEZE, 'v1 freeze');
    }
    array_push($errors, ...delivery_agent_v1_freeze_errors($contents, $freezeBytes));
}

$batchSchemaBytes = null;
$batchFiles = [];
if (!$usingFixtures) {
    if ($candidate !== null) {
        $batchSchemaAtCandidate = gitShow($root, $candidate, BATCH_SCHEMA);
        if ($batchSchemaAtCandidate['exit'] === 0) {
            $batchSchemaBytes = $batchSchemaAtCandidate['output'];
        }
        $loaded = delivery_agent_load_batch_files_from_commit(
            static fn(string $path): array => gitShow($root, $candidate, $path),
            static fn(string $path): array => gitLsTree($root, $candidate, $path),
        );
        array_push($errors, ...$loaded['errors']);
        $batchFiles = $loaded['batches'];
    } else {
        if (is_file($root . '/' . BATCH_SCHEMA)) {
            $batchSchemaBytes = readRequiredFile($root . '/' . BATCH_SCHEMA, 'batch schema');
        }
        $loaded = delivery_agent_load_batch_files_from_directory($root . '/' . BATCH_DIR);
        array_push($errors, ...$loaded['errors']);
        $batchFiles = $loaded['batches'];
    }
}

$batchEvents = [];
if (!$usingFixtures && ($batchFiles !== [] || $batchSchemaBytes !== null)) {
    if ($batchSchemaBytes === null) {
        $errors[] = 'batch authority requires ' . BATCH_SCHEMA;
    } else {
        try {
            $batchSchema = json_decode($batchSchemaBytes, flags: JSON_THROW_ON_ERROR);
        } catch (JsonException $exception) {
            $errors[] = 'batch schema is not valid JSON: ' . $exception->getMessage();
            $batchSchema = null;
        }
        if ($batchSchema !== null && !is_object($batchSchema)) {
            $errors[] = 'batch schema must be a JSON object';
            $batchSchema = null;
        }
        if ($batchSchema !== null) {
            $parsedBatches = delivery_agent_parse_batch_files($batchFiles, $batchSchema, $schema);
            array_push($errors, ...$parsedBatches['errors']);
            $batchEvents = $parsedBatches['events'];
        }
    }

    $v1Events = [];
    try {
        $v1Events = delivery_agent_parse_v1_ledger_events($contents);
    } catch (JsonException $exception) {
        $errors[] = 'could not parse v1 ledger events: ' . $exception->getMessage();
    }

    $union = [...$v1Events, ...$batchEvents];
    array_push($errors, ...delivery_agent_event_set_errors($union));

    $replay = delivery_agent_replay_events($v1Events, $batchEvents);
    array_push($errors, ...$replay['errors']);
    /** @var array<string, array<string, mixed>> $eventsById */
    $eventsById = [];
    /** @var array<string, int> $replayLines */
    $replayLines = [];
    foreach ($replay['events'] as $index => $event) {
        $eventId = $event['event_id'] ?? null;
        if (!is_string($eventId)) {
            continue;
        }
        $eventsById[$eventId] = $event;
        $replayLines[$eventId] = $index + 1;
    }
    foreach ($batchEvents as $batchEvent) {
        $eventId = $batchEvent['event_id'] ?? null;
        if (!is_string($eventId) || !isset($replayLines[$eventId])) {
            continue;
        }
        validateEventSemantics($batchEvent, $eventsById, $replayLines, $replayLines[$eventId], $errors);
        array_push($errors, ...delivery_agent_elapsed_ms_errors($batchEvent, $eventsById));
    }
}

if ($priorLedgerPath !== null) {
    array_push($errors, ...validateAppendOnly(readRequiredFile($priorLedgerPath, 'prior ledger'), $contents));
}
if ($priorSchemaPath !== null && readRequiredFile($priorSchemaPath, 'prior schema') !== $schemaBytes) {
    $errors[] = 'the published v1 schema is immutable; create a new schema version';
}
if ($priorCommit !== null) {
    $prior = gitShow($root, $priorCommit, LEDGER_PATH);
    if ($prior['exit'] === 0) {
        array_push($errors, ...validateAppendOnly($prior['output'], $contents));
    } elseif ($candidate !== null && missingAtCommit($prior)) {
        $errors[] = 'the declared base must track the canonical ledger';
    } elseif (!missingAtCommit($prior)) {
        $errors[] = "could not read the base ledger at {$priorCommit}";
    }
    $priorSchema = gitShow($root, $priorCommit, LEDGER_SCHEMA);
    if ($priorSchema['exit'] === 0 && $priorSchema['output'] !== $schemaBytes) {
        $errors[] = 'the published v1 schema is immutable; create a new schema version';
    } elseif ($candidate !== null && missingAtCommit($priorSchema)) {
        $errors[] = 'the declared base must track the canonical schema';
    } elseif ($priorSchema['exit'] !== 0 && !missingAtCommit($priorSchema)) {
        $errors[] = "could not read the base schema at {$priorCommit}";
    }

    $priorBatches = delivery_agent_load_batch_files_from_commit(
        static fn(string $path): array => gitShow($root, $priorCommit, $path),
        static fn(string $path): array => gitLsTree($root, $priorCommit, $path),
    );
    array_push($errors, ...$priorBatches['errors']);
    array_push($errors, ...delivery_agent_batch_immutability_errors($priorBatches['batches'], $batchFiles));

    $priorFreeze = gitShow($root, $priorCommit, V1_FREEZE);
    $priorFreezeBytes = $priorFreeze['exit'] === 0 ? $priorFreeze['output'] : null;
    array_push(
        $errors,
        ...delivery_agent_authority_blob_immutability_errors('v1 freeze manifest', $priorFreezeBytes, $freezeBytes),
    );

    $priorBatchSchema = gitShow($root, $priorCommit, BATCH_SCHEMA);
    $priorBatchSchemaBytes = $priorBatchSchema['exit'] === 0 ? $priorBatchSchema['output'] : null;
    array_push(
        $errors,
        ...delivery_agent_authority_blob_immutability_errors('batch schema', $priorBatchSchemaBytes, $batchSchemaBytes),
    );
}
if ($errors !== []) {
    if ($identity !== null) {
        fwrite(STDERR, "delivery agent event contract: {$identity}\n");
    }
    foreach ($errors as $error) {
        fwrite(STDERR, "delivery agent event contract: {$error}\n");
    }
    exit(1);
}
if ($identity !== null) {
    fwrite(STDOUT, "delivery agent event contract: {$identity}\n");
}
fwrite(STDOUT, "delivery agent event contract: PASS\n");
