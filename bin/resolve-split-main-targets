#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Resolve a reviewed comma-separated package selection into a GitHub matrix.
 *
 * This deliberately carries a narrow allowlist. Expanding pre-release fan-out
 * authority requires a reviewed source change; workflow input can never become
 * a repository name, path, or URL by interpolation alone.
 */

$allowlist = [
    'ai-agent' => ['local' => 'packages/ai-agent', 'remote' => 'ai-agent'],
    'ai-development' => ['local' => 'packages/ai-development', 'remote' => 'ai-development'],
    'ai-tools' => ['local' => 'packages/ai-tools', 'remote' => 'ai-tools'],
    'ai-vector' => ['local' => 'packages/ai-vector', 'remote' => 'ai-vector'],
    'attachment' => ['local' => 'packages/attachment', 'remote' => 'attachment'],
    'auth' => ['local' => 'packages/auth', 'remote' => 'auth'],
    'bimaaji' => ['local' => 'packages/bimaaji', 'remote' => 'bimaaji'],
    'user' => ['local' => 'packages/user', 'remote' => 'user'],
    'mcp' => ['local' => 'packages/mcp', 'remote' => 'mcp'],
    'relationship' => ['local' => 'packages/relationship', 'remote' => 'relationship'],
    'foundation' => ['local' => 'packages/foundation', 'remote' => 'foundation'],
    'database-legacy' => ['local' => 'packages/database-legacy', 'remote' => 'database-legacy'],
    'deployer' => ['local' => 'packages/deployer', 'remote' => 'deployer'],
    'config' => ['local' => 'packages/config', 'remote' => 'config'],
    'cli' => ['local' => 'packages/cli', 'remote' => 'cli'],
    'site-contract' => ['local' => 'packages/site-contract', 'remote' => 'site-contract'],
    'migration' => ['local' => 'packages/migration', 'remote' => 'migration'],
    'workflows' => ['local' => 'packages/workflows', 'remote' => 'workflows'],
    'access' => ['local' => 'packages/access', 'remote' => 'access'],
    'media' => ['local' => 'packages/media', 'remote' => 'media'],
    'entity' => ['local' => 'packages/entity', 'remote' => 'entity'],
    'entity-storage' => ['local' => 'packages/entity-storage', 'remote' => 'entity-storage'],
    'field' => ['local' => 'packages/field', 'remote' => 'field'],
    'geo' => ['local' => 'packages/geo', 'remote' => 'geo'],
    'graphql' => ['local' => 'packages/graphql', 'remote' => 'graphql'],
    'menu' => ['local' => 'packages/menu', 'remote' => 'menu'],
    'node' => ['local' => 'packages/node', 'remote' => 'node'],
    'note' => ['local' => 'packages/note', 'remote' => 'note'],
    'path' => ['local' => 'packages/path', 'remote' => 'path'],
    'routing' => ['local' => 'packages/routing', 'remote' => 'routing'],
    'scheduler' => ['local' => 'packages/scheduler', 'remote' => 'scheduler'],
    'search' => ['local' => 'packages/search', 'remote' => 'search'],
    'taxonomy' => ['local' => 'packages/taxonomy', 'remote' => 'taxonomy'],
    'api' => ['local' => 'packages/api', 'remote' => 'api'],
    'audit' => ['local' => 'packages/audit', 'remote' => 'audit'],
    'page-builder' => ['local' => 'packages/page-builder', 'remote' => 'page-builder'],
    'publishing' => ['local' => 'packages/publishing', 'remote' => 'publishing'],
    'admin-surface' => ['local' => 'packages/admin-surface', 'remote' => 'admin-surface'],
];

$selection = $argv[1] ?? '';
$names = [];
foreach (explode(',', $selection) as $candidate) {
    $name = trim($candidate);
    if ($name === '') {
        continue;
    }
    if (!isset($allowlist[$name])) {
        fwrite(STDERR, sprintf("Split-main target '%s' is not allowlisted.\n", $name));
        exit(2);
    }
    $names[$name] = true;
}

if ($names === []) {
    fwrite(STDERR, "Select at least one allowlisted split-main package.\n");
    exit(2);
}

$include = [];
foreach (array_keys($names) as $name) {
    $include[] = $allowlist[$name];
}

echo json_encode(['include' => $include], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . PHP_EOL;
