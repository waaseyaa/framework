#!/usr/bin/env php
<?php

declare(strict_types=1);

use Waaseyaa\Tooling\DevRuntimeConsumer;

require_once dirname(__DIR__) . '/tools/lib/DevRuntimeConsumer.php';

$consumerRoot = dirname(__DIR__);

/** @return string */
function consumerCacheRoot(): string
{
    $xdg = getenv('XDG_CACHE_HOME');
    if (is_string($xdg) && str_starts_with($xdg, '/')) {
        return rtrim($xdg, '/');
    }
    $userHome = getenv('HOME');
    if (!is_string($userHome) || !str_starts_with($userHome, '/')) {
        throw new RuntimeException('HOME or XDG_CACHE_HOME must resolve an absolute user cache root');
    }

    return rtrim($userHome, '/') . '/.cache';
}

function downloadConsumerSource(string $url, string $sha256, string $destination): void
{
    $context = stream_context_create([
        'http' => ['timeout' => 60, 'follow_location' => 1, 'max_redirects' => 3],
        'ssl' => ['verify_peer' => true, 'verify_peer_name' => true],
    ]);
    $input = @fopen($url, 'rb', false, $context);
    if (!is_resource($input)) {
        throw new RuntimeException("cannot download canonical dev runtime source: {$url}");
    }
    $output = @fopen($destination, 'xb');
    if (!is_resource($output)) {
        fclose($input);
        throw new RuntimeException("cannot create canonical dev runtime source: {$destination}");
    }
    $copied = stream_copy_to_stream($input, $output);
    fclose($input);
    fclose($output);
    if ($copied === false || !hash_equals($sha256, (string) hash_file('sha256', $destination))) {
        @unlink($destination);
        throw new RuntimeException("canonical dev runtime source checksum mismatch: {$url}");
    }
}

function removeConsumerStage(string $stage, string $parent): void
{
    if (!str_starts_with($stage, rtrim($parent, '/') . '/.tmp-') || !is_dir($stage)) {
        return;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($stage, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );
    foreach ($iterator as $entry) {
        $entry->isDir() && !$entry->isLink() ? rmdir($entry->getPathname()) : unlink($entry->getPathname());
    }
    rmdir($stage);
}

/** @param array<string, mixed> $record */
function materializeConsumerSource(string $cache, array $record): void
{
    $parent = dirname($cache);
    if (!is_dir($parent) && !mkdir($parent, 0o700, true) && !is_dir($parent)) {
        throw new RuntimeException("cannot create dev runtime source cache parent: {$parent}");
    }
    $lock = fopen($parent . '/.' . basename($cache) . '.lock', 'c+');
    if (!is_resource($lock) || !flock($lock, LOCK_EX)) {
        throw new RuntimeException('cannot acquire dev runtime source cache lock');
    }
    try {
        if (is_dir($cache)) {
            $errors = DevRuntimeConsumer::sourceErrors($cache, $record['authority_files']);
            if ($errors !== []) {
                throw new RuntimeException(implode("\n", $errors));
            }

            return;
        }
        $stage = $parent . '/.tmp-' . basename($cache) . '-' . getmypid() . '-' . bin2hex(random_bytes(4));
        if (!mkdir($stage, 0o700, true)) {
            throw new RuntimeException("cannot create dev runtime source staging directory: {$stage}");
        }
        try {
            foreach ($record['authority_files'] as $relative => $sha256) {
                $destination = $stage . '/' . $relative;
                if (!is_dir(dirname($destination)) && !mkdir(dirname($destination), 0o700, true) && !is_dir(dirname($destination))) {
                    throw new RuntimeException("cannot create canonical source directory for {$relative}");
                }
                downloadConsumerSource(
                    DevRuntimeConsumer::sourceUrl($record['repository'], $record['commit'], $relative),
                    $sha256,
                    $destination,
                );
                if (str_starts_with($relative, 'bin/')) {
                    chmod($destination, 0o755);
                }
            }
            $errors = DevRuntimeConsumer::sourceErrors($stage, $record['authority_files']);
            if ($errors !== []) {
                throw new RuntimeException(implode("\n", $errors));
            }
            if (!rename($stage, $cache)) {
                throw new RuntimeException("cannot publish dev runtime source cache: {$cache}");
            }
        } catch (Throwable $exception) {
            removeConsumerStage($stage, $parent);
            throw $exception;
        }
    } finally {
        flock($lock, LOCK_UN);
        fclose($lock);
    }
}

try {
    $record = DevRuntimeConsumer::loadSourceRecord(
        $consumerRoot . '/tools/dev-runtime-source.json',
        $consumerRoot,
    );
    $cache = DevRuntimeConsumer::cachePath(consumerCacheRoot(), $record);
    materializeConsumerSource($cache, $record);
    $command = DevRuntimeConsumer::delegationCommand($cache, $consumerRoot, array_slice($argv, 1));
    $process = proc_open($command, [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes, $consumerRoot);
    if (!is_resource($process)) {
        throw new RuntimeException('cannot delegate to canonical dev runtime');
    }
    exit(proc_close($process));
} catch (Throwable $exception) {
    foreach (explode("\n", $exception->getMessage()) as $line) {
        fwrite(STDERR, "dev-runtime-consumer: ERROR: {$line}\n");
    }
    exit(1);
}
