#!/usr/bin/env bash
# Wrapper around `vendor/bin/phpstan analyse` using the framework's standard
# memory limit. The retired agent-output JSON envelope is deliberately rejected.
#
# Any extra args are forwarded to phpstan (e.g. a path filter or
# `--memory-limit=4G`).
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export ROOT_DIR
cd "$ROOT_DIR"

PHPSTAN_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --output=json)
            echo "check-phpstan: --output=json is no longer supported; use PHPStan's native --error-format=json when needed." >&2
            exit 2
            ;;
        *) PHPSTAN_ARGS+=("$arg") ;;
    esac
done
if [[ "${WAASEYAA_OUTPUT:-}" == "json" ]]; then
    echo "check-phpstan: --output=json is no longer supported; use PHPStan's native --error-format=json when needed." >&2
    exit 2
fi

if [[ ! -x vendor/bin/phpstan ]]; then
    echo "WARN: vendor/bin/phpstan not found; run 'composer install' before check-phpstan." >&2
    exit 0
fi
exec vendor/bin/phpstan analyse --memory-limit=512M "${PHPSTAN_ARGS[@]}"
