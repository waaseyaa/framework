#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Hard-gate dead-code check. Exits non-zero on any finding not already in
 * phpstan-dead-code-baseline.neon.
 *
 * Output modes:
 *   --output=json
 *   WAASEYAA_OUTPUT=json
 */

$root = dirname(__DIR__);
$outputMode = getenv('WAASEYAA_OUTPUT') === 'json' ? 'json' : 'human';
$phpstanArgs = [];

foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--output=json') {
        $outputMode = 'json';
        continue;
    }

    $phpstanArgs[] = $arg;
}

$phpstan = $root . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . 'phpstan';
if (!is_file($phpstan)) {
    if ($outputMode === 'json') {
        echo json_encode([
            'tool' => 'check-dead-code',
            'result' => 'pass',
            'baseline_count' => 0,
            'new_count' => 0,
            'findings' => [],
            'skipped' => 'vendor-missing',
        ], JSON_THROW_ON_ERROR) . PHP_EOL;
        exit(0);
    }

    fwrite(STDERR, "WARN: vendor/bin/phpstan not found; run 'composer install' before check-dead-code.\n");
    exit(0);
}

@mkdir($root . DIRECTORY_SEPARATOR . 'tmp' . DIRECTORY_SEPARATOR . 'phpstan-dead-code', 0777, true);

$baseArgs = [
    PHP_BINARY,
    $phpstan,
    'analyse',
    '--configuration=phpstan-dead-code.neon',
    '--no-progress',
    '--memory-limit=2G',
];

if ($outputMode === 'json') {
    $command = array_merge($baseArgs, ['--error-format=json'], $phpstanArgs);
    [$exitCode, $stdout] = runCommand($command, $root, capture: true);
    $decoded = json_decode($stdout, true);
    $findings = [];
    $newCount = 0;

    if (is_array($decoded) && isset($decoded['files']) && is_array($decoded['files'])) {
        foreach ($decoded['files'] as $file => $entry) {
            $messages = is_array($entry) ? ($entry['messages'] ?? []) : [];
            if (!is_array($messages)) {
                continue;
            }

            foreach ($messages as $message) {
                if (!is_array($message)) {
                    continue;
                }

                $findings[] = [
                    'file' => (string) $file,
                    'line' => isset($message['line']) && is_int($message['line']) ? $message['line'] : 0,
                    'kind' => (string) ($message['identifier'] ?? 'unused'),
                    'message' => (string) ($message['message'] ?? ''),
                ];
            }
        }

        $newCount = isset($decoded['totals']['file_errors']) && is_int($decoded['totals']['file_errors'])
            ? $decoded['totals']['file_errors']
            : count($findings);
    }

    echo json_encode([
        'baseline_count' => 0,
        'new_count' => $newCount,
        'findings' => $findings,
    ], JSON_THROW_ON_ERROR) . PHP_EOL;
    exit($exitCode);
}

echo "Running dead-code check via phpstan-dead-code.neon...\n\n";
[$exitCode] = runCommand(array_merge($baseArgs, $phpstanArgs), $root, capture: false);

echo "\n";
if ($exitCode === 0) {
    echo "OK - dead-code check found no new unused members beyond the baseline.\n";
} else {
    echo "Dead-code check FAILED (exit={$exitCode}).\n\n";
    echo "If this finding is intentional (e.g. a forthcoming extension point), add\n";
    echo "a class-level '@api' PHPDoc tag. If you must accept it as known-dead,\n";
    echo "regenerate the baseline:\n";
    echo "  vendor/bin/phpstan analyse -c phpstan-dead-code.neon \\\n";
    echo "    --generate-baseline=phpstan-dead-code-baseline.neon --allow-empty-baseline\n";
    echo "and explain in the PR description why.\n";
}

exit($exitCode);

/**
 * @param list<string> $command
 *
 * @return array{0:int,1:string}
 */
function runCommand(array $command, string $cwd, bool $capture): array
{
    $descriptorSpec = [
        0 => ['file', 'php://stdin', 'r'],
        1 => $capture ? ['pipe', 'w'] : ['file', 'php://stdout', 'w'],
        2 => ['file', 'php://stderr', 'w'],
    ];

    $process = proc_open($command, $descriptorSpec, $pipes, $cwd);
    if (!is_resource($process)) {
        fwrite(STDERR, "ERROR: failed to start phpstan.\n");

        return [127, ''];
    }

    $stdout = '';
    if ($capture && isset($pipes[1]) && is_resource($pipes[1])) {
        $stdout = stream_get_contents($pipes[1]) ?: '';
        fclose($pipes[1]);
    }

    $exitCode = proc_close($process);

    return [is_int($exitCode) ? $exitCode : 1, $stdout];
}
