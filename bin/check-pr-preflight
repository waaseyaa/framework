#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * One local preflight mirroring every fast repo-state gate hosted CI blocks
 * merge on (docs/specs/governed-gates.md §1).
 *
 * Gates come from tools/preflight-gates.json — data, not prose — and
 * tests/Architecture/PreflightParityTest.php binds that manifest to
 * composer.json and the workflow files so this command cannot drift from CI.
 * Every gate runs (run_gate accumulator semantics: no fail-fast), every
 * failure prints the gate's captured output plus its exact repair command,
 * and the exit code is non-zero if anything failed.
 *
 * Before any gate runs, the shared vendor/ freshness precondition
 * (bin/lib/vendor-freshness.php, #2926) must pass; a stale local vendor/
 * short-circuits with VENDOR_FRESHNESS_EXIT_CODE and an actionable message
 * instead of running gates whose failures would be environment faults. On
 * native Windows, a selected gate that starts `bash` also needs Git for
 * Windows Bash (#2679); without it the run stops the same way.
 *
 * Usage:
 *   bin/check-pr-preflight            # default profile (fast repo-state gates)
 *   bin/check-pr-preflight --full     # adds the phpstan-engine gates (phpstan, dead-code)
 *   bin/check-pr-preflight --list     # print the gate roster without running
 *   bin/check-pr-preflight --base=REF # diff base for the committed-state gates
 *                                     # (default: WAASEYAA_DRIFT_BASE, then
 *                                     #  git config waaseyaa.driftBase, then origin/main)
 *   bin/check-pr-preflight --no-reuse # execute instead of reading exact-identity receipts
 *   bin/check-pr-preflight --evidence-dir=DIR # override the Git-private receipt store
 *   bin/check-pr-preflight --report-json=FILE # write the machine-readable run report
 */

$root = dirname(__DIR__);
$manifestPath = $root . '/tools/preflight-gates.json';
$full = false;
$list = false;
$base = null;
$reuse = true;
$evidenceDir = null;
$reportJson = null;
$allowHostedRequired = false;

foreach (array_slice($_SERVER['argv'] ?? [], 1) as $argument) {
    if ($argument === '--full') {
        $full = true;
    } elseif ($argument === '--list') {
        $list = true;
    } elseif (str_starts_with($argument, '--base=')) {
        $base = substr($argument, strlen('--base='));
    } elseif (str_starts_with($argument, '--manifest=')) {
        $manifestPath = substr($argument, strlen('--manifest='));
    } elseif ($argument === '--no-reuse') {
        $reuse = false;
    } elseif ($argument === '--allow-hosted-required') {
        $allowHostedRequired = true;
    } elseif (str_starts_with($argument, '--evidence-dir=')) {
        $evidenceDir = substr($argument, strlen('--evidence-dir='));
    } elseif (str_starts_with($argument, '--report-json=')) {
        $reportJson = substr($argument, strlen('--report-json='));
    } else {
        fwrite(STDERR, "check-pr-preflight: unknown argument {$argument}\n");
        exit(2);
    }
}

try {
    $manifest = json_decode((string) file_get_contents($manifestPath), true, flags: JSON_THROW_ON_ERROR);
} catch (Throwable $exception) {
    fwrite(STDERR, "check-pr-preflight: cannot read manifest {$manifestPath}: {$exception->getMessage()}\n");
    exit(2);
}
$gates = $manifest['gates'] ?? null;
if (!is_array($gates) || $gates === []) {
    fwrite(STDERR, "check-pr-preflight: manifest has no gates.\n");
    exit(2);
}

require $root . '/bin/lib/repository-git.php';
require $root . '/bin/lib/repository-bash.php';
require $root . '/bin/lib/preflight-evidence.php';

$manifestSchema = $manifest['schema_version'] ?? null;
if (!in_array($manifestSchema, [1, 2], true)) {
    fwrite(STDERR, "check-pr-preflight: unsupported manifest schema.\n");
    exit(2);
}
$effectiveGates = [];
foreach ($gates as $gate) {
    if (!is_array($gate)) {
        fwrite(STDERR, "check-pr-preflight: malformed gate entry.\n");
        exit(2);
    }
    if ($manifestSchema === 1) {
        $gate += [
            'supported_hosts' => ['windows', 'linux', 'darwin'],
            'required_capabilities' => ['php', 'git'],
            'relevant_paths' => ['**'],
            'cost' => 'fast',
            'evidence_inputs' => ['candidate_tree', 'tracked_worktree', 'composer_lock', 'toolchain', 'gate_definition'],
        ];
    }
    $effective = preflight_effective_gate($manifest, $gate);
    $problems = preflight_gate_metadata_problems($effective);
    if ($problems !== []) {
        fwrite(STDERR, sprintf("check-pr-preflight: gate %s metadata: %s.\n", (string) ($gate['id'] ?? '?'), implode('; ', $problems)));
        exit(2);
    }
    $effectiveGates[] = $effective;
}
$gates = $effectiveGates;

if ($list) {
    foreach ($gates as $gate) {
        fwrite(STDOUT, sprintf(
            "%-40s %-8s %-6s hosts=%-22s capabilities=%-18s %s\n",
            (string) $gate['id'],
            (string) $gate['profile'],
            (string) $gate['cost'],
            implode(',', $gate['supported_hosts']),
            implode(',', $gate['required_capabilities']),
            (string) $gate['run'],
        ));
    }
    exit(0);
}

/**
 * Resolve the diff base: --base, then WAASEYAA_DRIFT_BASE, then
 * `git config waaseyaa.driftBase`, then origin/main.
 *
 * The git lookup starts the host's repository Git entrypoint
 * (repository_git_command(): bin/git on POSIX, the Windows Git executable on
 * native Windows) from an argument array with a null stderr descriptor, not a
 * shell string: under cmd.exe a `2>/dev/null` redirect cannot open, so git
 * never ran and a configured base was silently replaced (#3096).
 */
function preflightResolveBase(string $root, ?string $explicit): string
{
    if ($explicit !== null && $explicit !== '') {
        return $explicit;
    }
    $env = getenv('WAASEYAA_DRIFT_BASE');
    if (is_string($env) && $env !== '') {
        return $env;
    }
    $pipes = [];
    $process = @proc_open(
        [...repository_git_command($root), '-C', $root, 'config', '--get', 'waaseyaa.driftBase'],
        [1 => ['pipe', 'w'], 2 => ['null']],
        $pipes,
    );
    if (is_resource($process)) {
        $configured = trim((string) stream_get_contents($pipes[1]));
        fclose($pipes[1]);
        if (proc_close($process) === 0 && $configured !== '') {
            return $configured;
        }
    }

    return 'origin/main';
}

// Precondition (#2926): a stale local vendor/ makes every gate below lie —
// opis/json-schema absent reads as a fatal in the delivery-ledger gate, a
// never-dumped autoload-dev mapping reads as an "orphaned" public-surface
// declaration whose repair is a CHANGELOG directive. Check once, up front,
// and short-circuit with the shared precondition exit code so nothing here
// is ever reported as a repository defect. Not a manifest gate: hosted CI
// installs fresh and never observes this state (docs/specs/governed-gates.md §1).
require $root . '/bin/lib/vendor-freshness.php';
$vendorProblem = vendor_freshness_problem($root);
if ($vendorProblem !== null) {
    fwrite(STDERR, vendor_freshness_message($vendorProblem, 'check-pr-preflight'));
    fwrite(STDERR, "check-pr-preflight: no gate was run — their results against a stale vendor/ would misreport environment faults as repository defects.\n");
    exit(VENDOR_FRESHNESS_EXIT_CODE);
}

$selectedGates = array_values(array_filter(
    $gates,
    static fn(array $gate): bool => (string) $gate['profile'] !== 'full' || $full,
));

// Host Bash (#2679): every gate runs through the host shell, and from
// PowerShell or cmd a bare `bash` is C:\Windows\System32\bash.exe, the WSL
// launcher, whose Linux Git cannot read a Windows linked worktree. On native
// Windows a gate whose command begins with exactly `bash` therefore starts
// Git for Windows Bash (repository_bash_command()), resolved once per run.
// Without it Bash gates are hosted-required while supported gates continue.
// POSIX command strings are never rewritten.
$hostBashExecutable = null;
$hostBash = null;
if (PHP_OS_FAMILY === 'Windows') {
    $hostBashExecutable = repository_bash_command($root)[0] ?? null;
    if ($hostBashExecutable !== null) {
        $quoted = escapeshellarg($hostBashExecutable);
        if ($quoted === '"' . $hostBashExecutable . '"') {
            $hostBash = $quoted;
        } else {
            $hostBashExecutable = null;
        }
    }
} else {
    $bashCapability = preflight_command_capability('bash');
    if ($bashCapability['available']) {
        $hostBashExecutable = $bashCapability['detail'];
    }
}

$resolvedBase = preflightResolveBase($root, $base);
$host = preflight_host_id();
$capabilities = preflight_capabilities($root, $hostBashExecutable);
$changedPaths = preflight_changed_paths($root, $resolvedBase);
$source = preflight_source_identity($root);
if ($source === null) {
    fwrite(STDERR, "check-pr-preflight: cannot bind the repository source identity.\n");
    exit(2);
}
if ($manifestPath === $root . '/tools/preflight-gates.json' && $evidenceDir === null) {
    $evidenceDir = preflight_default_evidence_dir($root);
}
$reuse = $reuse && is_string($evidenceDir) && $evidenceDir !== '';

$failures = [];
$hostedRequired = [];
$notApplicable = [];
$results = [];
$ran = 0;
$reused = 0;
$startedAll = microtime(true);

foreach ($selectedGates as $gate) {
    $id = (string) $gate['id'];
    $owner = (string) $gate['owning_hosted_check'];
    if (!in_array($host, $gate['supported_hosts'], true)) {
        $reason = "host {$host} is not in supported_hosts";
        $hostedRequired[] = $id;
        $results[] = ['id' => $id, 'status' => 'hosted-required', 'reason' => $reason, 'owning_hosted_check' => $owner, 'source' => 'not-run'];
        fwrite(STDOUT, sprintf("HOST %-40s (%s; owner: %s)\n", $id, $reason, $owner));
        continue;
    }
    $missing = preflight_missing_capabilities($gate, $capabilities);
    if ($missing !== []) {
        $reason = 'missing capabilities: ' . implode(',', $missing);
        $hostedRequired[] = $id;
        $results[] = ['id' => $id, 'status' => 'hosted-required', 'reason' => $reason, 'owning_hosted_check' => $owner, 'source' => 'not-run'];
        fwrite(STDOUT, sprintf("HOST %-40s (%s; owner: %s)\n", $id, $reason, $owner));
        continue;
    }
    if (!preflight_gate_is_applicable($gate, $changedPaths)) {
        $reason = 'no changed path matched the gate selectors';
        $notApplicable[] = $id;
        $results[] = ['id' => $id, 'status' => 'not-applicable', 'reason' => $reason, 'owning_hosted_check' => $owner, 'source' => 'not-run'];
        fwrite(STDOUT, sprintf("N/A  %-40s (%s)\n", $id, $reason));
        continue;
    }

    $command = (string) $gate['run'];
    if ($hostBash !== null && preg_match('/^bash(?=\s)/', $command) === 1) {
        $command = $hostBash . substr($command, 4);
    }
    if (($gate['base'] ?? false) === true) {
        $command = str_replace('{base}', escapeshellarg($resolvedBase), $command);
    }

    $evidence = preflight_evidence_identity($root, $gate, $source, $resolvedBase, $capabilities);
    if ($reuse && $evidence !== null && preflight_read_passed_evidence($evidenceDir, $evidence['key']) !== null) {
        ++$reused;
        $results[] = ['id' => $id, 'status' => 'passed', 'elapsed_s' => 0.0, 'owning_hosted_check' => $owner, 'source' => 'reused', 'evidence_key' => $evidence['key']];
        fwrite(STDOUT, sprintf("ok   %-40s (reused exact identity)\n", $id));
        continue;
    }

    ++$ran;
    $started = microtime(true);
    $output = [];
    $exitCode = 0;
    exec(sprintf('cd %s && (%s) 2>&1', escapeshellarg($root), $command), $output, $exitCode);
    $elapsed = microtime(true) - $started;

    if ($exitCode === 0) {
        $result = ['id' => $id, 'status' => 'passed', 'elapsed_s' => round($elapsed, 3), 'owning_hosted_check' => $owner, 'source' => 'executed'];
        if ($reuse && $evidence !== null) {
            if (preflight_write_passed_evidence($evidenceDir, $evidence['key'], $evidence['identity'], $elapsed)) {
                $result['evidence_key'] = $evidence['key'];
            } else {
                fwrite(STDERR, "check-pr-preflight: warning: could not write evidence for {$id}; the pass is not reusable.\n");
            }
        }
        $results[] = $result;
        fwrite(STDOUT, sprintf("ok   %-40s (%.1fs)\n", $id, $elapsed));
        continue;
    }

    $failures[] = $gate;
    $results[] = ['id' => $id, 'status' => 'failed', 'elapsed_s' => round($elapsed, 3), 'exit_code' => $exitCode, 'owning_hosted_check' => $owner, 'source' => 'executed'];
    fwrite(STDOUT, sprintf("FAIL %-40s (%.1fs, exit %d)\n", $id, $elapsed, $exitCode));
    foreach ($output as $line) {
        fwrite(STDOUT, '     ' . $line . "\n");
    }
    fwrite(STDOUT, '     repair: ' . (string) $gate['repair'] . "\n");
}

fwrite(STDOUT, sprintf(
    "\n%d gate(s) executed and %d reused in %.1fs; %d failed, %d hosted-required, %d not-applicable.%s\n",
    $ran,
    $reused,
    microtime(true) - $startedAll,
    count($failures),
    count($hostedRequired),
    count($notApplicable),
    $full ? '' : ' (phpstan-engine gates run with --full and in CI.)',
));

$report = [
    'schema_version' => 1,
    'candidate' => $source,
    'base' => $resolvedBase,
    'host' => ['id' => $host, 'capabilities' => $capabilities],
    'profile' => $full ? 'full' : 'default',
    'results' => $results,
    'summary' => ['executed' => $ran, 'reused' => $reused, 'failed' => count($failures), 'hosted_required' => count($hostedRequired), 'not_applicable' => count($notApplicable)],
];
if ($reportJson !== null && !preflight_write_report($reportJson, $report)) {
    fwrite(STDERR, "check-pr-preflight: could not write report {$reportJson}.\n");
    exit(2);
}

if ($failures !== []) {
    fwrite(STDOUT, "failed: " . implode(', ', array_map(static fn(array $gate): string => (string) $gate['id'], $failures)) . "\n");
    exit(1);
}

if ($hostedRequired !== []) {
    fwrite(STDOUT, "hosted-required: " . implode(', ', $hostedRequired) . "\n");
    fwrite(STDOUT, "This local run is incomplete; the owning hosted checks remain required.\n");
    exit($allowHostedRequired ? 0 : 3);
}

exit(0);
