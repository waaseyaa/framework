    'workspace' => 6,
];

$metapackages = ['cms' => true, 'core' => true, 'full' => true];

// Each entry carries a one-line rationale (per CLAUDE.md "Layer Architecture":
// "each entry carries a one-line rationale"). Exempt files may import upward
// because they are entry-point orchestrators (kernel/boot), the L0-owned HTTP
// substrate, or event-decoupled listeners that subscribe by string event name
// and only `use` the higher-layer event TYPE they consume.
$kernelExemptFiles = array_fill_keys([
    // Foundation kernel/diagnostic + HTTP-substrate routers — wired only by HttpKernel,
    // no external importers; intentionally reach across layers (see CLAUDE.md exemption note).
    'foundation/src/Diagnostic/HealthChecker.php',
    'foundation/src/Diagnostic/BootDiagnosticReport.php',
    'foundation/src/Http/Router/BroadcastRouter.php',
    'foundation/src/Http/Router/CodifiedContextApiRouter.php',
    'foundation/src/Http/Router/EntityTypeLifecycleRouter.php',
    'foundation/src/Http/Router/JsonApiRouter.php',
    'foundation/src/Http/Router/SchemaRouter.php',
    'foundation/src/Http/Router/SearchRouter.php',
    'foundation/src/Http/Router/TranslationRouter.php',
    'foundation/src/Http/Router/WorkflowDefinitionsApiRouter.php',
    'foundation/src/Http/Router/WaaseyaaContext.php',
    'foundation/src/Http/Inbound/ChannelInspector.php',
    'foundation/src/Http/Inbound/EventStreamReadModel.php',
    'foundation/src/Http/Inbound/SubscriberObserver.php',
    'foundation/src/MercureMonitorServiceProvider.php',
    'foundation/src/Kernel/EventListenerRegistrar.php',
    'foundation/src/ServiceProvider/Capability/HasCommandsInterface.php',
    'foundation/src/ServiceProvider/Capability/HasMiddlewareInterface.php',
    'foundation/src/ServiceProvider/Capability/HasGraphqlMutationOverridesInterface.php',
    // cache (L0) event-decoupled cache-invalidation listeners — subscribe by string
    // event name and import only the L1 event TYPE they consume (CLAUDE.md blesses this
    // pattern explicitly). Behaviour stays decoupled; no L1 require edge is created.
    'cache/src/Listener/ConfigCacheInvalidator.php',     // uses Waaseyaa\Config\Event\ConfigEvent
    'cache/src/Listener/EntityCacheInvalidator.php',     // uses Waaseyaa\Entity\Event\EntityEvent
    'cache/src/Listener/EntityCacheSubscriber.php',      // subscribes to L1 entity lifecycle events
], true);

$namespacePrefixToShort = [
    'Foundation' => 'foundation',
    'AgentOutput' => 'agent-output',
    'Cache' => 'cache',
    'Plugin' => 'plugin',
    'TypedData' => 'typed-data',
    'Database' => 'database-legacy',
    'I18n' => 'i18n',
