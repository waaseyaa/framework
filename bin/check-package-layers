#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Hard-gate package-layers check. See CLAUDE.md "Layer Architecture".
 *
 * Output modes:
 *   --output=json
 *   WAASEYAA_OUTPUT=json
 *
 * Rules:
 *   PL001 – package name does not match directory
 *   PL002 – package missing from layer index
 *   PL003 – required dependency not in layer index
 *   PL004 – composer.json require edge violates layer order (upward)
 *   PL005 – PHP file-level `use Waaseyaa\…` import violates layer order (upward)
 *   PL006 – same-layer dependency cycle (WARN only)
 *   PL007 – undeclared same-or-lower-layer dependency (fail-on-new, baselined)
 *   PL008 – Layer-0 src/ file contains a string-literal FQCN for a higher-layer
 *            package (catches routing/bootstrapping coupling hidden from PL005
 *            because string literals bypass `use` statement analysis). Only
 *            non-kernel-exempt Layer-0 files are scanned; kernel/boot files are
 *            already trusted to wire all layers. New violations fail; pre-existing
 *            legitimate ones are baselined in tools/package-layers-string-literal-baseline.txt.
 *            Two sub-patterns are matched under the same PL008 rule ID (same
 *            finding/baseline/emit path — a file with either pattern needs the
 *            same fix: move the reference to the owning higher-layer package or
 *            switch to the string-constant mechanism, then baseline if intentional):
 *              (a) quoted string literals, e.g. 'Waaseyaa\\Node\\Foo' (two
 *                  backslashes per separator in raw file text — the original PL008
 *                  pattern, WP5).
 *              (b) inline fully-qualified `::class` tokens with no `use` import,
 *                  e.g. \Waaseyaa\Node\Foo::class (one backslash per separator in
 *                  raw file text — added audit-remediation WP7 after this shape was
 *                  found invisible to both PL005 (no `use` statement to scan) and the
 *                  original PL008 regex (requires a leading quote character).
 */

$rootEnv = getenv('WAASEYAA_LAYER_ROOT');
$root = is_string($rootEnv) && $rootEnv !== '' ? $rootEnv : dirname(__DIR__);
$outputMode = getenv('WAASEYAA_OUTPUT') === 'json' ? 'json' : 'human';
$generateBaseline = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--output=json') {
        $outputMode = 'json';
    }
    if ($arg === '--generate-baseline') {
        $generateBaseline = true;
    }
}

