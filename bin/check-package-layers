$aiSubToShort = [
    'Schema' => 'ai-schema',
    'Agent' => 'ai-agent',
    'Pipeline' => 'ai-pipeline',
    'Tools' => 'ai-tools',
    'Vector' => 'ai-vector',
    'Observability' => 'ai-observability',
];

$emit = static function (string $line = '') use ($outputMode): void {
    if ($outputMode === 'human') {
        echo $line . PHP_EOL;
    }
};

$emitError = static function (string $line = '') use ($outputMode): void {
    if ($outputMode === 'human') {
        fwrite(STDERR, $line . PHP_EOL);
    }
};

$shortFromPackageName = static function (string $name): ?string {
    return preg_match('/^waaseyaa\/([a-z0-9-]+)$/i', trim($name), $matches) === 1
        ? strtolower($matches[1])
        : null;
};

$isKernelExempt = static function (string $relativeToPackages) use ($kernelExemptFiles): bool {
    return str_contains('/' . $relativeToPackages, '/src/Kernel/')
        || isset($kernelExemptFiles[$relativeToPackages]);
};

$shortForNamespace = static function (string $first, ?string $second) use ($namespacePrefixToShort, $aiSubToShort): ?string {
    if ($first === 'AI') {
        return $aiSubToShort[$second ?? ''] ?? null;
    }

    return $namespacePrefixToShort[$first] ?? null;
};

// Undeclared-dependency baseline (PL007, fail-on-new). Mirrors the dead-code /
// getquery-bindings baselines: existing same-or-lower-layer use-edges that are not
// declared in composer.json require are listed here so CI stays green while they are
// driven to zero; any NEW such edge fails. Regenerate with --generate-baseline.
$undeclaredBaselineEnv = getenv('WAASEYAA_LAYER_UNDECLARED_BASELINE');
$undeclaredBaselinePath = is_string($undeclaredBaselineEnv) && $undeclaredBaselineEnv !== ''
    ? $undeclaredBaselineEnv
    : $root . DIRECTORY_SEPARATOR . 'tools' . DIRECTORY_SEPARATOR . 'package-layers-undeclared-baseline.txt';

/** @return array<string, array<string, true>> source-short => dep-short => true */
$loadUndeclaredBaseline = static function (string $path): array {
    $baseline = [];
    if (!is_file($path)) {
        return $baseline;
    }
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $rawLine) {
        $line = trim($rawLine);
        if ($line === '' || str_starts_with($line, '#')) {
            continue;
        }
        // Format: "<source> <dep>  # optional example/comment"
        $parts = preg_split('/\s+/', $line) ?: [];
        if (count($parts) < 2) {
            continue;
        }
        $baseline[$parts[0]][$parts[1]] = true;
    }
    return $baseline;
};
$undeclaredBaseline = $loadUndeclaredBaseline($undeclaredBaselinePath);

// PL008 string-literal FQCN baseline. Mirrors the PL007 baseline pattern.
// Format: one line per allowlisted relative file path (packages/<pkg>/src/…),
// followed by "  # <mandatory-rationale>".
$stringLiteralBaselineEnv = getenv('WAASEYAA_LAYER_STRING_LITERAL_BASELINE');
$stringLiteralBaselinePath = is_string($stringLiteralBaselineEnv) && $stringLiteralBaselineEnv !== ''
    ? $stringLiteralBaselineEnv
    : $root . DIRECTORY_SEPARATOR . 'tools' . DIRECTORY_SEPARATOR . 'package-layers-string-literal-baseline.txt';

/** @return array<string, true>  relative-path => true */
$loadStringLiteralBaseline = static function (string $baselinePath): array {
    $baseline = [];
    if (!is_file($baselinePath)) {
        return $baseline;
    }
    foreach (file($baselinePath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $rawLine) {
        $line = trim($rawLine);
        if ($line === '' || str_starts_with($line, '#')) {
            continue;
        }
        // Strip trailing comment ("  # reason") to get the file path.
        $path = preg_replace('/\s{2,}#.*$/', '', $line);
        if (is_string($path) && $path !== '') {
            $baseline[trim($path)] = true;
        }
    }
    return $baseline;
};
$stringLiteralBaseline = $loadStringLiteralBaseline($stringLiteralBaselinePath);

/**
 * Scan a Layer-0 package's src/ for FQCNs referencing packages at higher
 * layers, hidden from both PL005 (no `use` import to scan) and ordinary
 * grep-for-`use` review (PL008). Kernel-exempt files are skipped (they are
 * trusted bootstrapping orchestrators, same as for PL005). Multi-line block
 * comments and single-line comments are stripped before matching to avoid
 * false positives.
 *
 * Two sub-patterns are matched (both raised as PL008 — see rule-ID doc at
 * the top of this file):
 *
 *   (a) A single- or double-quoted literal that starts with
 *       `Waaseyaa\<NamespaceSegment>\` (encoded in the file as two
 *       backslashes per separator: `Waaseyaa\\<NS>\\`). WP5 original pattern.
 *
 *   (b) An inline, unquoted, fully-qualified `::class` token with no `use`
 *       import — `\Waaseyaa\<NamespaceSegment>\...::class` (encoded in the
 *       file as ONE backslash per separator, since this is real PHP syntax,
 *       not a string literal). Added audit-remediation WP7: the sibling string-constant
 *       convention (CLAUDE.md "Layer discipline for imports") already covers
 *       quoted FQCNs; this closes the gap for the `::class` form, which is
 *       invisible to both PL005 (no `use` statement) and pattern (a) (no
 *       leading quote character, and only one backslash per separator).
 *
 * @return list<array{relative: string, dep: string, depLayer: int}>
 */
$scanStringLiteralFqcns = static function (string $packageDirectory, int $selfLayer, string $selfShort) use (
    $root,
    $layerByShort,
    $isKernelExempt,
    $shortForNamespace,
    $stringLiteralBaseline,
): array {
    // PL008 only checks Layer-0 packages — they must never hard-code higher-layer
    // controller FQCNs as string literals (the exact pattern WP5 fixed).
    if ($selfLayer !== 0) {
        return [];
    }

    $src = $packageDirectory . DIRECTORY_SEPARATOR . 'src';
    if (!is_dir($src)) {
        return [];
    }

    $findings = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
    );

    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || $file->getExtension() !== 'php') {
            continue;
        }

        $relative = str_replace('\\', '/', substr($file->getPathname(), strlen($root . DIRECTORY_SEPARATOR . 'packages' . DIRECTORY_SEPARATOR)));
        // Skip kernel-exempt files: they are bootstrapping orchestrators and
        // are trusted to contain cross-layer wiring (same exemption as PL005).
        if ($isKernelExempt($relative)) {
            continue;
        }
        // Skip files allowlisted in the PL008 baseline.
        if (isset($stringLiteralBaseline[$relative])) {
            continue;
        }

        $rawText = @file_get_contents($file->getPathname());
        if (!is_string($rawText)) {
            continue;
        }

        // Strip comments conservatively to avoid false positives. We process
        // line-by-line: skip pure-comment lines (// …, # …, * … for block
        // comment bodies) and track /* … */ block comment regions.
        $filteredLines = [];
        $inBlock = false;
        foreach (explode("\n", $rawText) as $line) {
            $trimmed = ltrim($line);
            if ($inBlock) {
                if (str_contains($line, '*/')) {
                    $inBlock = false;
                }
                continue;
            }
            // Block comment open (/** or /* without closing */ on same line).
            if (str_starts_with($trimmed, '/*') || str_starts_with($trimmed, '/**')) {
                if (!str_contains($line, '*/')) {
                    $inBlock = true;
                }
                continue;
            }
            // Single-line comment or block comment continuation line.
            if (str_starts_with($trimmed, '//') || str_starts_with($trimmed, '#') || str_starts_with($trimmed, '*')) {
                continue;
            }
            $filteredLines[] = $line;
        }
        $text = implode("\n", $filteredLines);

        // Sub-pattern (a): quoted string literals containing Waaseyaa\\<Ns>\\ patterns.
        // In raw PHP file text, namespace separators appear as \\ (two backslashes),
        // so the regex matches the literal byte sequence `Waaseyaa` + `\\` + CapLetter.
        preg_match_all(
            '#[\'"]Waaseyaa\\\\\\\\([A-Z][A-Za-z0-9]*)(?:\\\\\\\\([A-Z][A-Za-z0-9]*))?#',
            $text,
            $quotedMatches,
            PREG_SET_ORDER,
        );

        // Sub-pattern (b): inline, unquoted, fully-qualified `::class` tokens with no
        // `use` import — \Waaseyaa\<Ns>\...::class. In raw PHP file text this is real
        // syntax (not a string literal), so namespace separators appear as a SINGLE
        // backslash. The negative lookbehind excludes a preceding quote/backslash so
        // this pattern does not also fire on the second backslash of a sub-pattern-(a)
        // double-backslash sequence; requiring the `::class` suffix independently rules
        // out matching inside string-literal constant definitions (e.g. POLICY_ATTRIBUTE),
        // which are never followed by `::class`.
        preg_match_all(
            '#(?<![\'"\\\\])\\\\Waaseyaa\\\\([A-Z][A-Za-z0-9]*)(?:\\\\([A-Z][A-Za-z0-9]*))?(?:\\\\[A-Za-z0-9_]+)*::class#',
            $text,
            $inlineClassMatches,
            PREG_SET_ORDER,
        );

        $seen = [];
        foreach ([...$quotedMatches, ...$inlineClassMatches] as $match) {
            $depShort = $shortForNamespace($match[1], $match[2] ?? null);
            if ($depShort === null || !isset($layerByShort[$depShort]) || $depShort === $selfShort) {
                continue;
            }
            if (isset($seen[$depShort])) {
                continue;
            }
            $seen[$depShort] = true;

            $depLayer = $layerByShort[$depShort];
            if ($depLayer > $selfLayer) {
                $findings[] = ['relative' => $relative, 'dep' => $depShort, 'depLayer' => $depLayer];
            }
        }
    }

    return $findings;
};

/**
 * Scan a package's src/ for `use Waaseyaa\…` edges, classifying each as either an
 * upward layer violation ('upward' → PL005, hard fail) or a same-or-lower-layer
 * import that is not declared in composer.json require ('undeclared' → PL007,
 * baselined). Kernel-exempt files are skipped for both.
 *
 * @param array<string, true> $declaredShorts dep shorts in this package's require
 * @return list<array{relative: string, dep: string, depLayer: int, kind: 'upward'|'undeclared'}>
 */
$scanPhpImports = static function (string $packageDirectory, int $selfLayer, string $selfShort, array $declaredShorts) use (
    $root,
    $layerByShort,
    $isKernelExempt,
    $shortForNamespace,
): array {
    $src = $packageDirectory . DIRECTORY_SEPARATOR . 'src';
    if (!is_dir($src)) {
        return [];
    }

    $findings = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($src, FilesystemIterator::SKIP_DOTS),
    );

    foreach ($iterator as $file) {
        if (!$file instanceof SplFileInfo || $file->getExtension() !== 'php') {
            continue;
        }

        $relative = str_replace('\\', '/', substr($file->getPathname(), strlen($root . DIRECTORY_SEPARATOR . 'packages' . DIRECTORY_SEPARATOR)));
        if ($isKernelExempt($relative)) {
            continue;
        }

        $text = @file_get_contents($file->getPathname());
        if (!is_string($text)) {
            continue;
        }

        preg_match_all(
            '/^\s*use(?:\s+function|\s+const)?\s+Waaseyaa\\\\([A-Z][A-Za-z0-9]*)(?:\\\\([A-Z][A-Za-z0-9]*))?/m',
            $text,
            $matches,
            PREG_SET_ORDER,
        );

        $seen = [];
        foreach ($matches as $match) {
            $depShort = $shortForNamespace($match[1], $match[2] ?? null);
            if ($depShort === null || !isset($layerByShort[$depShort]) || isset($seen[$depShort])) {
                continue;
            }

            $seen[$depShort] = true;
            if ($depShort === $selfShort) {
                continue;
            }

            $depLayer = $layerByShort[$depShort];
            if ($depLayer > $selfLayer) {
                $findings[] = ['relative' => $relative, 'dep' => $depShort, 'depLayer' => $depLayer, 'kind' => 'upward'];
                continue;
            }

            // Same-or-lower layer: a legal dependency, but it must be declared in require.
            if (!isset($declaredShorts[$depShort])) {
                $findings[] = ['relative' => $relative, 'dep' => $depShort, 'depLayer' => $depLayer, 'kind' => 'undeclared'];
            }
        }
    }

    return $findings;
};

$packagesDirectory = $root . DIRECTORY_SEPARATOR . 'packages';
if (!is_dir($packagesDirectory)) {
    $emitError('FAIL [PL000] packages/ not found');
    if ($outputMode === 'json') {
        echo json_encode(['packages_scanned' => 0, 'violations' => []], JSON_THROW_ON_ERROR) . PHP_EOL;
    }
    exit(1);
}

$errors = 0;
$packagesScanned = 0;
$violations = [];
$sameLayerEdges = [];
/** @var array<string, array<string, string>> source-short => dep-short => example relative path */
$undeclaredFound = [];
$packageDirectories = glob($packagesDirectory . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR) ?: [];
sort($packageDirectories);

foreach ($packageDirectories as $packageDirectory) {
    $manifest = $packageDirectory . DIRECTORY_SEPARATOR . 'composer.json';
    if (!is_file($manifest)) {
        continue;
    }

    $data = json_decode((string) file_get_contents($manifest), true, 512, JSON_THROW_ON_ERROR);
    $packageShort = basename($packageDirectory);
    if (($data['type'] ?? 'library') === 'metapackage' || isset($metapackages[$packageShort])) {
        continue;
    }

    ++$packagesScanned;
    $name = (string) ($data['name'] ?? '');
    $short = $name !== '' ? $shortFromPackageName($name) : null;
    if ($short === null) {
        continue;
    }

    $relativeManifest = 'packages/' . $packageShort . '/composer.json';
    if ($short !== $packageShort) {
        ++$errors;
        $emit("FAIL [PL001] {$relativeManifest}: name {$name} does not match directory {$packageShort}");
        $violations[] = ['source' => $packageShort, 'target' => $name, 'edge' => 'manifest-name'];
        continue;
    }

    if (!isset($layerByShort[$short])) {
        ++$errors;
        $emit("FAIL [PL002] {$relativeManifest}: package {$short} missing from bin/check-package-layers layer index");
        $violations[] = ['source' => $short, 'target' => 'LAYER_BY_SHORT', 'edge' => 'missing-layer-entry'];
        continue;
    }

    $selfLayer = $layerByShort[$short];
    $requires = $data['require'] ?? [];
    /** @var array<string, true> $declaredShorts dep shorts declared in this package's require */
    $declaredShorts = [];
    if (is_array($requires)) {
        foreach ($requires as $depName => $_version) {
            if (!is_string($depName)) {
                continue;
            }

            $depShort = $shortFromPackageName($depName);
            if ($depShort === null) {
                continue;
            }

            $declaredShorts[$depShort] = true;

            if (!isset($layerByShort[$depShort])) {
                ++$errors;
                $emit("FAIL [PL003] {$relativeManifest} require: dependency {$depName} not in layer index");
                $violations[] = ['source' => $short, 'target' => $depShort, 'edge' => 'require'];
                continue;
            }

            $depLayer = $layerByShort[$depShort];
            if ($depLayer === $selfLayer) {
                $sameLayerEdges[$short][$depShort] = true;
            }

            if ($depLayer > $selfLayer) {
                ++$errors;
                $emit(
                    "FAIL [PL004] {$relativeManifest} require: layer violation - "
                    . "{$short} (layer {$selfLayer}) must not depend on {$depShort} (layer {$depLayer}).",
                );
                $violations[] = ['source' => $short, 'target' => $depShort, 'edge' => 'require'];
            }
        }
    }

    // De-dup PL007 findings per dep (one message per undeclared edge, with an example file).
    $undeclaredEdges = [];
    foreach ($scanPhpImports($packageDirectory, $selfLayer, $short, $declaredShorts) as $finding) {
        if ($finding['kind'] === 'upward') {
            ++$errors;
            $emit(
                "FAIL [PL005] packages/{$finding['relative']}: file-level layer violation - "
                . "{$short} (layer {$selfLayer}) imports waaseyaa/{$finding['dep']} (layer {$finding['depLayer']}).",
            );
            $violations[] = ['source' => $short, 'target' => $finding['dep'], 'edge' => 'use'];
            continue;
        }

        // kind === 'undeclared' (same-or-lower layer, legal to declare but missing from require)
        if (!isset($undeclaredEdges[$finding['dep']])) {
            $undeclaredEdges[$finding['dep']] = $finding['relative'];
        }
    }

    foreach ($undeclaredEdges as $depShort => $exampleRelative) {
        if ($generateBaseline) {
            $undeclaredFound[$short][$depShort] = $exampleRelative;
            continue;
        }
        if (isset($undeclaredBaseline[$short][$depShort])) {
            continue; // known/accepted undeclared edge (baselined) — fix by declaring it, then remove the line
        }
        ++$errors;
        $emit(
            "FAIL [PL007] packages/{$exampleRelative}: undeclared dependency - "
            . "{$short} (layer {$selfLayer}) imports waaseyaa/{$depShort} (layer {$layerByShort[$depShort]}) "
            . "but does not declare it in composer.json require. Add it to require, "
            . "or baseline it via: php bin/check-package-layers --generate-baseline.",
        );
        $violations[] = ['source' => $short, 'target' => $depShort, 'edge' => 'undeclared'];
    }

    // PL008: string-literal FQCN layer gate (Layer-0 only). De-dup per dep.
    $stringLiteralEdges = [];
    foreach ($scanStringLiteralFqcns($packageDirectory, $selfLayer, $short) as $finding) {
        if (!isset($stringLiteralEdges[$finding['dep']])) {
            $stringLiteralEdges[$finding['dep']] = $finding['relative'];
        }
    }
    foreach ($stringLiteralEdges as $depShort => $exampleRelative) {
        ++$errors;
        $emit(
            "FAIL [PL008] packages/{$exampleRelative}: string-literal layer violation - "
            . "{$short} (layer {$selfLayer}) contains a quoted string-literal or inline ::class "
            . "Waaseyaa\\{$depShort}\\… FQCN (layer {$layerByShort[$depShort]}). Move the "
            . "route/binding to the owning higher-layer provider, or baseline the file in "
            . "tools/package-layers-string-literal-baseline.txt with a mandatory rationale comment.",
        );
        $violations[] = ['source' => $short, 'target' => $depShort, 'edge' => 'string-literal'];
    }
}

if ($generateBaseline) {
    $lines = [
        '# Package-layers undeclared-dependency baseline (PL007) — see bin/check-package-layers.',
        '# Format: "<source-package> <dep-package>  # <example file>"',
        '# Meaning: <source> imports waaseyaa/<dep> (same-or-lower layer, legal to declare) from a',
        '#   src/ file but does NOT list it in composer.json require — it resolves only transitively,',
        '#   so a consumer installing <source> alone hits a fatal missing dependency. Fix by adding',
        '#   the dep to that package\'s require, then delete the line. New undeclared edges NOT in this',
        '#   list fail CI (PL007, fail-on-new). Regenerate: php bin/check-package-layers --generate-baseline',
        '',
    ];
    ksort($undeclaredFound);
    $edgeCount = 0;
    foreach ($undeclaredFound as $src => $deps) {
        ksort($deps);
        foreach ($deps as $dep => $example) {
            $lines[] = sprintf('%s %s  # %s', $src, $dep, $example);
            ++$edgeCount;
        }
    }
    file_put_contents($undeclaredBaselinePath, implode("\n", $lines) . "\n");
    fwrite(STDOUT, "Wrote undeclared-dependency baseline ({$edgeCount} edges): {$undeclaredBaselinePath}\n");
    exit(0);
}

$reportedCycles = [];
foreach ($sameLayerEdges as $a => $deps) {
    foreach (array_keys($deps) as $b) {
        if (!isset($sameLayerEdges[$b][$a])) {
            continue;
        }

        $pair = [$a, $b];
        sort($pair);
        $key = implode('<->', $pair);
        if (isset($reportedCycles[$key])) {
            continue;
        }

        $reportedCycles[$key] = true;
        $emit(
            "WARN [PL006] same-layer dependency cycle: {$pair[0]} <-> {$pair[1]} "
            . "(layer {$layerByShort[$pair[0]]}). Accepted-but-visible.",
        );
    }
}

if ($outputMode === 'json') {
    echo json_encode([
        'packages_scanned' => $packagesScanned,
        'violations' => $violations,
    ], JSON_THROW_ON_ERROR) . PHP_EOL;
    exit($errors > 0 ? 1 : 0);
}

if ($errors > 0) {
    fwrite(STDERR, "\nPackage layer check failed with {$errors} error(s).\n");
    exit(1);
}

echo "OK - package layer constraints (composer.json + PHP file-level + declared-require parity) satisfied.\n";
exit(0);
