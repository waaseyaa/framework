#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Hard-gate package-layers check. See CLAUDE.md "Layer Architecture".
 *
 * Output modes:
 *   --output=json
 *   WAASEYAA_OUTPUT=json
 */

$rootEnv = getenv('WAASEYAA_LAYER_ROOT');
$root = is_string($rootEnv) && $rootEnv !== '' ? $rootEnv : dirname(__DIR__);
$outputMode = getenv('WAASEYAA_OUTPUT') === 'json' ? 'json' : 'human';
$generateBaseline = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--output=json') {
        $outputMode = 'json';
    }
    if ($arg === '--generate-baseline') {
        $generateBaseline = true;
    }
}

$layerByShort = [
    'foundation' => 0,
    'cache' => 0,
    'plugin' => 0,
    'typed-data' => 0,
    'database-legacy' => 0,
    'i18n' => 0,
