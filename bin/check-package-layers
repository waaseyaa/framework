#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Hard-gate package-layers check. See CLAUDE.md "Layer Architecture".
 *
 * Output modes:
 *   --output=json
 *   WAASEYAA_OUTPUT=json
 *
 * Rules:
 *   PL001 – package name does not match directory
 *   PL002 – package missing from layer index
 *   PL003 – required dependency not in layer index
 *   PL004 – composer.json require edge violates layer order (upward)
 *   PL005 – PHP file-level `use Waaseyaa\…` import violates layer order (upward)
 *   PL006 – new same-layer dependency cycle (fail-on-new, baselined)
 *   PL007 – undeclared same-or-lower-layer dependency (fail-on-new, baselined)
 *   PL008 – src/ file references a higher-layer package's FQCN in a way
 *            PL005 cannot see (no plain `use` import). All non-kernel-exempt
 *            files are scanned; kernel/boot files are already trusted to
 *            wire all layers. New violations fail; pre-existing legitimate ones
 *            are baselined in tools/package-layers-string-literal-baseline.txt.
 *            The scan is TOKENIZER-BASED (token_get_all; comments are dropped as
 *            whole tokens, so FQCNs in comments/docblocks never fire). Two
 *            sub-patterns are matched under the same PL008 rule ID (same
 *            finding/baseline/emit path — a file with either pattern needs the
 *            same fix: move the reference to the owning higher-layer package or
 *            switch to the string-constant mechanism, then baseline if intentional):
 *              (a) FQCNs inside string scalars (quoted strings, interpolated
 *                  parts, heredoc/nowdoc), separator-tolerant: 'Waaseyaa\\Node\\Foo',
 *                  'Waaseyaa\Node\Foo', and '\Waaseyaa\Node\Foo' all match.
 *              (b) fully-qualified name tokens (T_NAME_FULLY_QUALIFIED) with no
 *                  `use` import — \Waaseyaa\Node\Foo::class / ::make() / ::CONST,
 *                  new \Waaseyaa\Node\Foo(), instanceof, type hints. Added
 *                  audit-remediation WP7; broadened from `::class`-only to any
 *                  usage shape in the same WP's adversarial-review fix round.
 */

$rootEnv = getenv('WAASEYAA_LAYER_ROOT');
$root = is_string($rootEnv) && $rootEnv !== '' ? $rootEnv : dirname(__DIR__);
$outputMode = getenv('WAASEYAA_OUTPUT') === 'json' ? 'json' : 'human';
$generateBaseline = false;
$printLayerMap = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--output=json') {
        $outputMode = 'json';
    }
    if ($arg === '--generate-baseline') {
        $generateBaseline = true;
    }
    if ($arg === '--layer-map=json') {
        $printLayerMap = true;
    }
}

