#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Composes package-local `packages/<pkg>/public-surface.php` declarations
 * into the two derived aggregate views (docs/specs/public-surface-declarations.md
 * §6, FW-DELIVERY-SURFACE-01 / #2901):
 *
 *   docs/public-surface-map.php — the FQCN => disposition map every existing
 *   `require` consumer already reads (unchanged shape).
 *
 *   docs/public-surface-map.md — layer -> package -> sorted symbol table,
 *   for humans, with shape derived from source and purpose/notes carried
 *   verbatim from the declarations.
 *
 * Usage:
 *   php bin/generate-surface-map [--root=DIR] --write
 *   php bin/generate-surface-map [--root=DIR] --check
 *   php bin/generate-surface-map [--root=DIR] --stdout=php|md
 *
 * --root defaults to the repository root (the directory containing this
 * bin/ directory's parent). The generator itself, and the layer table it
 * groups packages by, always come from THIS repository (dirname(__DIR__)),
 * independent of --root — --root only selects where package declarations
 * and source trees are read from (used by
 * tests/Architecture/SurfaceDeclarationCompositionTest.php to compose a
 * throwaway fixture tree without ever touching docs/public-surface-map.*).
 *
 * Exit codes: 0 success; 1 validation failure or --check drift; 2 usage or
 * infrastructure failure (unparsable layer table, unwritable target, ...).
 */

$selfRoot = dirname(__DIR__);

$autoload = $selfRoot . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "generate-surface-map: vendor/autoload.php not found — run `composer install` first.\n");
    exit(2);
}
require $autoload;

require_once $selfRoot . '/tools/lib/SurfaceScanner.php';
require_once $selfRoot . '/tools/lib/SurfaceDeclarations.php';

use Waaseyaa\Tooling\SurfaceDeclarations;
use Waaseyaa\Tooling\SurfaceScanner;

function gsmFail(string $message, int $exit = 1): never
{
    fwrite(STDERR, "generate-surface-map: {$message}\n");
    exit($exit);
}

function gsmInfo(string $message): void
{
    fwrite(STDOUT, "generate-surface-map: {$message}\n");
}

$root = $selfRoot;
$write = false;
$check = false;
$stdout = null;
foreach (array_slice($argv, 1) as $argument) {
    if (str_starts_with($argument, '--root=')) {
        $root = rtrim(substr($argument, strlen('--root=')), '/');
        continue;
    }
    if ($argument === '--write') {
        $write = true;
        continue;
    }
    if ($argument === '--check') {
        $check = true;
        continue;
    }
    if (str_starts_with($argument, '--stdout=')) {
        $stdout = substr($argument, strlen('--stdout='));
        if (!in_array($stdout, ['php', 'md'], true)) {
            gsmFail("--stdout must be 'php' or 'md', got '{$stdout}'.", 2);
        }
        continue;
    }
    gsmFail("unknown argument {$argument}; expected --root=DIR, --write, --check, or --stdout=php|md.", 2);
}
if (!$write && !$check && $stdout === null) {
    gsmFail('nothing to do; pass --write, --check, or --stdout=php|md.', 2);
}
if (!is_dir($root)) {
    gsmFail("--root {$root} is not a directory.", 2);
}

// ---------------------------------------------------------------------------
// Load + validate the declaration plane (§4).
// ---------------------------------------------------------------------------

try {
    $declarations = SurfaceDeclarations::load($root);
    $scanner = SurfaceScanner::scan($root);
} catch (\Throwable $e) {
    gsmFail('infrastructure failure while scanning: ' . $e->getMessage(), 2);
}

$errors = $declarations->validate($scanner);
if ($errors !== []) {
    gsmFail("declaration validation failed:\n\n" . implode("\n\n", $errors));
}

$composedMap = $declarations->compose();
if ($write || $check) {
    // Keep --stdout output byte-pure (no incidental info lines mixed in) so
    // a caller (and SurfaceDeclarationCompositionTest) can `require` it directly.
    gsmInfo(sprintf(
        'composed %d disposition(s) from %d package declaration file(s); scanned %d source file(s).',
        count($composedMap),
        count($declarations->packages()),
        $scanner->fileCount(),
    ));
}

// ---------------------------------------------------------------------------
// Layer table — always from THIS repository, never from --root.
// ---------------------------------------------------------------------------

const LAYER_NAMES = [
    0 => 'Foundation',
    1 => 'Core Data',
    2 => 'Content Types',
    3 => 'Services',
    4 => 'API',
    5 => 'AI',
    6 => 'Interfaces',
];
const UNASSIGNED_LAYER = 999;

$layerScriptPath = $selfRoot . '/bin/check-package-layers';
if (!is_file($layerScriptPath)) {
    gsmFail("cannot find the layer table at {$layerScriptPath}.", 2);
}
$layerScriptSource = (string) file_get_contents($layerScriptPath);
preg_match_all("/^\\s*'([a-z0-9-]+)'\\s*=>\\s*([0-9]+),\$/m", $layerScriptSource, $layerMatches, PREG_SET_ORDER);
if (count($layerMatches) < 40) {
    gsmFail(sprintf(
        'parsed only %d package(s) from the layer table in %s (expected at least 40) — the table shape may have changed; regex needs updating.',
        count($layerMatches),
        $layerScriptPath,
    ), 2);
}
$layerByShort = [];
foreach ($layerMatches as $match) {
    $layerByShort[$match[1]] = (int) $match[2];
}

// ---------------------------------------------------------------------------
// Render the two deterministic views.
// ---------------------------------------------------------------------------

/** @return array{0: string, 1: string} [phpView, mdView] */
function gsmRender(array $composedMap, array $packages, array $layerByShort, SurfaceScanner $scanner): array
{
    $phpLines = [];
    $phpLines[] = '<?php';
    $phpLines[] = '';
    $phpLines[] = '// GENERATED FILE — DO NOT EDIT BY HAND.';
    $phpLines[] = '// Composed by bin/generate-surface-map from packages/<pkg>/public-surface.php';
    $phpLines[] = '// declarations. Contract: docs/specs/public-surface-declarations.md.';
    $phpLines[] = '// Format: \'Fully\\Qualified\\ClassName\' => \'public|internal|extract|remove\'.';
    $phpLines[] = '';
    $phpLines[] = 'declare(strict_types=1);';
    $phpLines[] = '';
    $phpLines[] = 'return [';
    foreach ($composedMap as $fqcn => $disposition) {
        $phpLines[] = sprintf("    '%s' => '%s',", addslashes($fqcn), $disposition);
    }
    $phpLines[] = '];';
    $phpLines[] = '';
    $phpView = implode("\n", $phpLines);

    // Group owning packages by layer, then package name.
    $byLayer = [];
    foreach ($packages as $short => $package) {
        if ($package['entries'] === [] && $package['notes'] === []) {
            continue;
        }
        $layer = $layerByShort[$short] ?? UNASSIGNED_LAYER;
        $byLayer[$layer][$short] = $package;
    }
    ksort($byLayer, SORT_NUMERIC);

    $mdLines = [];
    $mdLines[] = '# Waaseyaa Public Surface Map';
    $mdLines[] = '';
    $mdLines[] = 'GENERATED FILE — DO NOT EDIT BY HAND.';
    $mdLines[] = '';
    $mdLines[] = 'This document lists every intentionally public API element in the Waaseyaa framework.';
    $mdLines[] = 'Elements not listed here are `@internal` and may change without notice.';
    $mdLines[] = '';
    $mdLines[] = 'Single editable authority: `packages/<pkg>/public-surface.php` (contract:';
    $mdLines[] = '`docs/specs/public-surface-declarations.md`). Composed by `bin/generate-surface-map`.';
    $mdLines[] = 'Machine-readable derived view: `docs/public-surface-map.php`.';
    $mdLines[] = '';
    $mdLines[] = '---';
    foreach ($byLayer as $layer => $packagesInLayer) {
        $layerName = LAYER_NAMES[$layer] ?? 'Unassigned';
        $mdLines[] = '';
        $mdLines[] = "## Layer {$layer}: {$layerName}";
        ksort($packagesInLayer, SORT_STRING);
        foreach ($packagesInLayer as $short => $package) {
            $mdLines[] = '';
            $mdLines[] = "### {$short}";
            $entries = $package['entries'];
            usort($entries, static fn(array $a, array $b): int => strcmp($a['fqcn'], $b['fqcn']));
            if ($entries !== []) {
                $mdLines[] = '';
                $mdLines[] = '| Element | Type | Purpose |';
                $mdLines[] = '|---------|------|---------|';
                foreach ($entries as $entry) {
                    $element = $entry['fqcn'];
                    foreach ($package['prefixes'] as $prefix) {
                        if ($prefix !== '' && str_starts_with($element, $prefix)) {
                            $element = substr($element, strlen($prefix));
                            break;
                        }
                    }
                    $type = $scanner->shape($entry['fqcn']) ?? 'unknown';
                    $purpose = $entry['purpose'] ?? '—';
                    $mdLines[] = sprintf('| `%s` | %s | %s |', $element, $type, $purpose);
                }
            }
            if ($package['notes'] !== []) {
                $mdLines[] = '';
                foreach ($package['notes'] as $note) {
                    $mdLines[] = "- {$note}";
                }
            }
        }
    }
    $mdLines[] = '';
    $mdView = implode("\n", $mdLines);

    return [$phpView, $mdView];
}

[$phpView, $mdView] = gsmRender($composedMap, $declarations->packages(), $layerByShort, $scanner);

// ---------------------------------------------------------------------------
// --stdout
// ---------------------------------------------------------------------------

if ($stdout === 'php') {
    fwrite(STDOUT, $phpView);
}
if ($stdout === 'md') {
    fwrite(STDOUT, $mdView);
}

$targetPhp = $root . '/docs/public-surface-map.php';
$targetMd = $root . '/docs/public-surface-map.md';

// ---------------------------------------------------------------------------
// --check
// ---------------------------------------------------------------------------

if ($check) {
    $problems = [];
    foreach ([['php', $targetPhp, $phpView], ['md', $targetMd, $mdView]] as [$label, $target, $fresh]) {
        $onDisk = is_file($target) ? (string) file_get_contents($target) : null;
        if ($onDisk === null) {
            $problems[] = "{$target} does not exist.";
            continue;
        }
        if ($onDisk !== $fresh) {
            $problems[] = sprintf(
                '%s differs from a fresh generation (on-disk %d bytes, generated %d bytes).',
                $target,
                strlen($onDisk),
                strlen($fresh),
            );
        }
    }
    if ($problems !== []) {
        gsmFail("--check found drift:\n  " . implode("\n  ", $problems) . "\n\nRun `php bin/generate-surface-map --write` to regenerate.");
    }
    gsmInfo('OK — both tracked aggregates are byte-identical to a fresh generation.');
}

// ---------------------------------------------------------------------------
// --write (atomic: write-to-temp-then-rename)
// ---------------------------------------------------------------------------

if ($write) {
    foreach ([[$targetPhp, $phpView], [$targetMd, $mdView]] as [$target, $content]) {
        $directory = dirname($target);
        if (!is_dir($directory)) {
            gsmFail("cannot write {$target}: directory {$directory} does not exist.", 2);
        }
        $temporary = $target . '.tmp-' . getmypid();
        if (file_put_contents($temporary, $content) === false || !rename($temporary, $target)) {
            gsmFail("failed to write {$target}.", 2);
        }
    }
    gsmInfo("wrote {$targetPhp} and {$targetMd}.");
}

exit(0);
