<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true">
    <extensions>
        <!-- M4 WP04D: agent-output NDJSON envelope is emitted on the last
             line of stdout when WAASEYAA_OUTPUT=json. Activation is a
             no-op when the env var is unset, so the extension adds zero
             overhead to human-mode test runs. -->
        <bootstrap class="Waaseyaa\AgentOutput\Listener\AgentOutputPhpUnitExtension"/>
    </extensions>
    <testsuites>
        <testsuite name="Unit">
            <directory>packages/*/tests/Unit</directory>
            <directory>packages/*/tests/Backend</directory>
            <directory>packages/ai-agent/tests/Contract</directory>
            <directory>packages/api/tests/Contract</directory>
            <directory>packages/config/tests/Contract</directory>
            <directory>packages/entity/tests/Contract</directory>
            <directory>packages/foundation/tests/Contract</directory>
            <directory>packages/migration/tests/Contract</directory>
            <directory>packages/queue/tests/Contract</directory>
            <file>packages/bimaaji/tests/SmokeTest.php</file>
        </testsuite>
        <testsuite name="GitHub">
            <directory>packages/github/tests</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>packages/*/tests/Integration</directory>
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <clover outputFile="build/logs/clover.xml"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>packages/*/src</directory>
        </include>
    </source>
</phpunit>
