#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/waaseyaa-s1-sqlite-artifact.XXXXXX")"
source_tree="$work/source"
package="$source_tree/packages/database-legacy"
artifacts="$work/artifacts"
consumer="$work/consumer"
version="1.0.0-alpha.1"

cleanup() {
    rm -rf -- "$work"
}
trap cleanup EXIT

mkdir -p "$source_tree" "$artifacts" "$consumer/vendor"
candidate="$($root/bin/git -C "$root" rev-parse HEAD)"
package_tree="$($root/bin/git -C "$root" rev-parse 'HEAD:packages/database-legacy')"
if [[ -n "$($root/bin/git -C "$root" status --porcelain=v1 -- packages/database-legacy)" ]]; then
    echo 'S1 artifact evidence refuses dirty database-package bytes.' >&2
    exit 1
fi
$root/bin/git -C "$root" archive --format=tar HEAD packages/database-legacy | tar -xf - -C "$source_tree"

# Composer artifact repositories read the package version from the archive's
# manifest. Stamp only the disposable staging copy; source bytes stay intact.
php -r '
    $path = $argv[1];
    $manifest = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    $manifest["version"] = $argv[2];
    $manifest["extra"]["waaseyaa"]["artifact-source"] = [
        "commit" => $argv[3],
        "package_tree" => $argv[4],
    ];
    unset($manifest["require-dev"], $manifest["autoload-dev"], $manifest["repositories"]);
    file_put_contents($path, json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$package/composer.json" "$version" "$candidate" "$package_tree"

tar --sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner \
    -czf "$artifacts/waaseyaa-database-legacy-$version.tar.gz" -C "$package" .
archive="$artifacts/waaseyaa-database-legacy-$version.tar.gz"
tar --sort=name --mtime='@0' --owner=0 --group=0 --numeric-owner \
    -czf "$artifacts/reproduced.tar.gz" -C "$package" .
if [[ "$(sha256sum "$archive" | cut -d ' ' -f 1)" != "$(sha256sum "$artifacts/reproduced.tar.gz" | cut -d ' ' -f 1)" ]]; then
    echo 'S1 artifact archive is not byte-reproducible.' >&2
    exit 1
fi

installed="$consumer/vendor/waaseyaa/database-legacy"
mkdir -p "$installed"
tar -xzf "$archive" -C "$installed"

if find "$installed" -type l -print -quit | grep -q .; then
    echo 'S1 artifact unexpectedly contains a symbolic link.' >&2
    exit 1
fi

for dependency in doctrine/dbal doctrine/deprecations psr/cache psr/log; do
    mkdir -p "$consumer/vendor/$(dirname "$dependency")"
    cp -R "$root/vendor/$dependency" "$consumer/vendor/$dependency"
done

php "$root/tests/PackagedForm/s1-sqlite-artifact-probe.php" \
    "$installed" "$consumer/vendor" "$candidate" "$package_tree"
printf 'Candidate: %s\nPackage tree: %s\nArtifact SHA-256: %s\n' \
    "$candidate" "$package_tree" "$(sha256sum "$archive" | cut -d ' ' -f 1)"
