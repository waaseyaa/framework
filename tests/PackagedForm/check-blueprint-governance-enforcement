#!/usr/bin/env bash

# Packaged runtime acceptance for #2848 (FW-GOVERNANCE-PACKAGED-ACCEPTANCE-01).
#
# Adapts check-site-recipe-provider-activation's archive/path-repository
# consumer pattern (no second package or test authority) to prove that a
# compiled application_blueprint's generated governance registrations
# (App\Provider\ApplicationBlueprintGovernanceServiceProvider,
# App\Provider\ApplicationBlueprintServiceProvider) actually participate in
# real packaged runtime enforcement, not just generated text or a hand-built
# provider instance.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/waaseyaa-blueprint-governance.XXXXXX")"
source_root="$work/source"
authoring="$work/authoring"
consumer="$work/consumer"
custody="$work/custody"

composer_bin="${COMPOSER_BIN:-}"
if [[ -z "$composer_bin" && -x "${HOME}/.local/bin/composer" ]]; then
    composer_bin="${HOME}/.local/bin/composer"
fi
if [[ -z "$composer_bin" ]]; then
    composer_bin="$(command -v composer)"
fi

cleanup() {
    rm -rf -- "$work" || echo "warning: failed to remove $work" >&2
}
trap cleanup EXIT

candidate="${CANDIDATE_SHA:-}"
if [[ -z "$candidate" ]]; then
    if [[ -n "$("$root/bin/git" -C "$root" status --porcelain=v1 --untracked-files=all)" ]]; then
        echo 'The default packaged candidate must be a clean immutable HEAD; commit the reviewed candidate or pass CANDIDATE_SHA.' >&2
        exit 1
    fi
    candidate="HEAD"
fi
candidate="$("$root/bin/git" -C "$root" rev-parse --verify "${candidate}^{commit}")"

mkdir -p "$source_root" "$consumer" "$custody"
chmod 0700 "$custody"
"$root/bin/git" -C "$root" archive --format=tar "$candidate" \
    | tar --no-same-owner --no-same-permissions -xf - -C "$source_root"

cp -R "$source_root/skeleton/." "$consumer/"
rm -f "$consumer/composer.lock" "$consumer/composer.local.json.example"
mkdir -p "$consumer/storage/framework" "$consumer/storage/files" "$consumer/config/sync"

php -r '
    $path = $argv[1];
    $composer = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    $composer["repositories"] = [
        ["type" => "path", "url" => $argv[2] . "/packages/*", "options" => ["symlink" => false]],
        ["type" => "path", "url" => $argv[2], "options" => ["symlink" => false]],
    ];
    $composer["require"]["waaseyaa/framework"] = "*";
    unset($composer["extra"]["merge-plugin"]);
    file_put_contents($path, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$consumer/composer.json" "$source_root"

app_secret="base64:$(php -r 'echo base64_encode(str_repeat("g", 32));')"
printf 'APP_ENV=local\nAPP_DEBUG=false\nWAASEYAA_APP_SECRET=%s\nWAASEYAA_DB=%s/storage/blueprint-governance.sqlite\nWAASEYAA_CONFIG_SYNC_PATH=%s/config/sync\n' \
    "$app_secret" "$consumer" "$consumer" > "$consumer/.env"

if ! "$composer_bin" install --working-dir="$consumer" \
        --no-interaction --no-progress --prefer-dist --no-scripts >"$work/composer.out" 2>&1; then
    tail -100 "$work/composer.out" >&2
    exit 1
fi

# Installed provenance: every waaseyaa/* package is a real copy from the
# archived candidate, never a symlink into it.
php -r '
    [$consumer, $sourceRoot] = array_slice($argv, 1);
    $installed = json_decode((string) file_get_contents($consumer . "/vendor/composer/installed.json"), true, flags: JSON_THROW_ON_ERROR);
    $packages = $installed["packages"] ?? $installed;
    $sourceRoot = realpath($sourceRoot);
    foreach ($packages as $package) {
        $name = $package["name"] ?? null;
        if (!is_string($name) || !str_starts_with($name, "waaseyaa/") || ($package["type"] ?? null) === "metapackage") {
            continue;
        }
        $installPath = $package["install-path"] ?? null;
        if (!is_string($installPath) || $installPath === "") {
            throw new RuntimeException($name . " is missing an install path.");
        }
        $raw = dirname($consumer . "/vendor/composer/installed.json") . "/" . $installPath;
        if (!is_dir($raw) || is_link($raw)) {
            throw new RuntimeException($name . " was not installed as a real copy.");
        }
    }
    fwrite(STDOUT, "Installed provenance OK: every waaseyaa/* package is a real copy.\n");
' "$consumer" "$source_root"

# The candidate's own canonical complete blueprint fixture, copied at runtime
# (not re-authored): packages/site-contract/tests/Fixtures/Blueprint/valid/complete.yaml.
lock_sha256="$(sha256sum "$consumer/composer.lock" | awk '{print $1}')"
cp "$source_root/packages/site-contract/tests/Fixtures/Blueprint/valid/complete.yaml" "$consumer/answers.yaml"
sed -i "s/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/${lock_sha256}/" "$consumer/answers.yaml"

tree_digest() {
    ( cd "$1" && find . -type f -not -path './vendor/*' -not -name '*.sqlite' | sort | xargs sha256sum | sha256sum | awk '{print $1}' )
}

# --- Unknown-metadata negative: mutate one policy condition to an
# already-unit-covered unsupported kind (mirrors
# packages/site-contract/tests/Fixtures/Blueprint/invalid/unsupported-condition-kind.yaml),
# run the real packaged dry-run JSON path, require the typed refusal, and
# prove a byte-identical whole-tree digest with no .waaseyaa. ---
cp "$consumer/answers.yaml" "$consumer/answers-bad.yaml"
php -r '
    $path = $argv[1];
    $yaml = (string) file_get_contents($path);
    $needle = "      condition:\n        kind: permission\n        permission: edit article\n";
    $replacement = "      condition:\n        kind: script\n        script: \"return true;\"\n";
    if (!str_contains($yaml, $needle)) {
        fwrite(STDERR, "Could not locate the article_create policy condition to mutate.\n");
        exit(1);
    }
    file_put_contents($path, str_replace($needle, $replacement, $yaml, $count));
    if ($count !== 1) {
        fwrite(STDERR, "Expected exactly one mutation site, found {$count}.\n");
        exit(1);
    }
' "$consumer/answers-bad.yaml"

before_bad_digest="$(tree_digest "$consumer")"
set +e
( cd "$consumer" && php vendor/bin/waaseyaa site:init --json --answers=answers-bad.yaml --project-root=. --dry-run ) >"$work/bad-dry-run.json" 2>"$work/bad-dry-run.err"
bad_exit=$?
set -e
if [[ "$bad_exit" -eq 0 ]]; then
    cat "$work/bad-dry-run.json" "$work/bad-dry-run.err" >&2
    echo 'FAIL: the mutated unsupported-condition blueprint must refuse dry-run, not succeed.' >&2
    exit 1
fi
if ! grep -Fq 'SITE047_BLUEPRINT_UNSUPPORTED_CONDITION' "$work/bad-dry-run.json" "$work/bad-dry-run.err"; then
    cat "$work/bad-dry-run.json" "$work/bad-dry-run.err" >&2
    echo 'FAIL: expected the typed SITE047_BLUEPRINT_UNSUPPORTED_CONDITION refusal.' >&2
    exit 1
fi
if [[ -e "$consumer/.waaseyaa" ]]; then
    echo 'FAIL: the refused dry-run created .waaseyaa.' >&2
    exit 1
fi
after_bad_digest="$(tree_digest "$consumer")"
if [[ "$before_bad_digest" != "$after_bad_digest" ]]; then
    echo 'FAIL: the refused dry-run changed the project tree.' >&2
    exit 1
fi
rm -f "$consumer/answers-bad.yaml"
echo 'Unknown-metadata dry-run refusal verified (SITE047, byte-identical tree, no .waaseyaa).'

# --- Real decision receipt via the installed production API, not hand JSON. ---
( cd "$consumer" && php -r '
    require "vendor/autoload.php";
    use Waaseyaa\SiteContract\Blueprint\BlueprintDecisionReceipt;
    use Waaseyaa\SiteContract\SiteManifestParser;
    $manifest = new SiteManifestParser()->parse((string) file_get_contents("answers.yaml"));
    $receipt = BlueprintDecisionReceipt::fromArray([
        "schema" => BlueprintDecisionReceipt::SCHEMA_ID,
        "version" => BlueprintDecisionReceipt::CONTRACT_VERSION,
        "decision" => "approved",
        "blueprint_digest" => $manifest->applicationBlueprint->digest,
        "manifest_digest" => $manifest->digest,
        "actor" => "packaged-acceptance-operator",
        "decided_at" => "2026-09-07T00:00:00Z",
        "mechanism" => "manual-review",
    ]);
    file_put_contents("decision.json", $receipt->canonicalJson() . "\n");
' )

if ! ( cd "$consumer" && php vendor/bin/waaseyaa site:init --json --answers=answers.yaml --decision-receipt=decision.json --project-root=. --dry-run ) >"$work/planned.json" 2>"$work/planned.err"; then
    cat "$work/planned.json" "$work/planned.err" >&2
    echo 'FAIL: the real complete blueprint failed to preview.' >&2
    exit 1
fi
grep -Fq '"outcome":"planned"' "$work/planned.json" || { cat "$work/planned.json" >&2; exit 1; }
[[ ! -e "$consumer/.waaseyaa" ]] || { echo 'FAIL: dry-run created .waaseyaa.' >&2; exit 1; }

if ! ( cd "$consumer" && php vendor/bin/waaseyaa site:init --json --answers=answers.yaml --decision-receipt=decision.json --project-root=. --yes ) >"$work/applied.json" 2>"$work/applied.err"; then
    cat "$work/applied.json" "$work/applied.err" >&2
    echo 'FAIL: the real complete blueprint failed to apply.' >&2
    exit 1
fi
grep -Fq '"outcome":"applied"' "$work/applied.json" || { cat "$work/applied.json" >&2; exit 1; }

# Literal root composer.json registers both providers exactly once.
php -r '
    $composer = json_decode((string) file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
    $providers = $composer["extra"]["waaseyaa"]["providers"] ?? [];
    foreach (["App\\Provider\\ApplicationBlueprintGovernanceServiceProvider", "App\\Provider\\ApplicationBlueprintServiceProvider"] as $fqcn) {
        $count = count(array_filter($providers, static fn(string $p): bool => $p === $fqcn));
        if ($count !== 1) {
            fwrite(STDERR, "{$fqcn}: expected exactly once, found {$count}\n");
            exit(1);
        }
    }
    fwrite(STDOUT, "Both blueprint providers registered exactly once in literal root composer.json.\n");
' "$consumer/composer.json"

# --- CFG-03 signing lifecycle: the blueprint generator must not mint signing
# custody, so the authored sync directory is signed on a separate authoring host
# and the importing consumer receives only the public trust key plus the signed
# envelope (mirrors check-verified-config-import exactly). ---
php -r '
    $pair = sodium_crypto_sign_keypair();
    file_put_contents($argv[1] . "/manifest-signing.key", sodium_crypto_sign_secretkey($pair));
    chmod($argv[1] . "/manifest-signing.key", 0600);
    file_put_contents($argv[1] . "/manifest-signing.pub", base64_encode(sodium_crypto_sign_publickey($pair)));
' "$custody"
public_key="$(cat "$custody/manifest-signing.pub")"
trust_reference='cfg04:blueprint-governance-key'

write_config() {
    local target="$1" role="$2"

    php -r '
        [$path, $reference, $publicKey, $role] = array_slice($argv, 1);
        $source = (string) file_get_contents($path);
        $signing = "    \x27config_manifest_signing\x27 => [\n"
            . "        \x27trust_keys\x27 => [\n"
            . "            \x27" . $reference . "\x27 => [\x27algorithm\x27 => \x27Ed25519\x27, \x27public_key\x27 => \x27" . $publicKey . "\x27],\n"
            . "        ],\n"
            . "        \x27revoked_trust_keys\x27 => [],\n";
        if ($role === "authoring") {
            $signing .= "        \x27signing_key\x27 => [\n"
                . "            \x27trust_key_reference\x27 => \x27" . $reference . "\x27,\n"
                . "            \x27secret_reference\x27 => [\n"
                . "                \x27provider\x27 => \x27authoring-file\x27,\n"
                . "                \x27identifier\x27 => \x27manifest-signing\x27,\n"
                . "                \x27secret_class\x27 => \x27token-signing-private-key\x27,\n"
                . "                \x27purpose\x27 => \x27waaseyaa.config.manifest-signing.v1\x27,\n"
                . "            ],\n"
                . "        ],\n";
        }
        $signing .= "    ],\n";
        $updated = preg_replace("/^return \[\n/m", "return [\n" . $signing, $source, 1);
        if (!is_string($updated) || $updated === $source) {
            fwrite(STDERR, "Could not inject manifest signing configuration.\n");
            exit(1);
        }
        file_put_contents($path, $updated);
    ' "$target/config/waaseyaa.php" "$trust_reference" "$public_key" "$role"
}

read_active_token() {
    ( cd "$consumer" && php vendor/bin/waaseyaa install:init ) >"$work/token.out" 2>&1
    active_generation="$(sed -nE 's/.*generation ([a-f0-9]{64}).*/\1/p' "$work/token.out" | head -1)"
    active_sequence="$(sed -nE 's/.*sequence ([0-9]+).*/\1/p' "$work/token.out" | head -1)"
    if [[ -z "$active_generation" || -z "$active_sequence" ]]; then
        cat "$work/token.out" >&2
        echo 'FAIL: could not read the active configuration token.' >&2
        exit 1
    fi
}

# Cloning the blueprint-activated consumer into an authoring host is unsafe:
# signing boots a kernel that still carries the generated blueprint providers and
# mutates the active store. Use the full authoring build from
# check-verified-config-import instead (one extra composer install).
build_authoring_host() {
    cp -R "$source_root/skeleton/." "$authoring/"
    rm -f "$authoring/composer.lock" "$authoring/composer.local.json.example"
    mkdir -p "$authoring/storage/framework" "$authoring/storage/files" "$authoring/config/sync"

    php -r '
        $path = $argv[1];
        $composer = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
        $composer["repositories"] = [
            ["type" => "path", "url" => $argv[2] . "/packages/*", "options" => ["symlink" => false]],
            ["type" => "path", "url" => $argv[2], "options" => ["symlink" => false]],
        ];
        $composer["require"]["waaseyaa/framework"] = "*";
        unset($composer["require-dev"], $composer["extra"]["merge-plugin"], $composer["scripts"]);
        $composer["extra"]["waaseyaa"]["providers"][] = $argv[3];
        file_put_contents($path, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    ' "$authoring/composer.json" "$source_root" 'App\Provider\AuthoringCustodyServiceProvider'

    printf 'APP_ENV=local\nAPP_DEBUG=false\nWAASEYAA_APP_SECRET=%s\nWAASEYAA_DB=%s/storage/blueprint-governance-authoring.sqlite\nWAASEYAA_CONFIG_SYNC_PATH=%s/config/sync\n' \
        "$app_secret" "$authoring" "$authoring" > "$authoring/.env"

    if ! "$composer_bin" install --working-dir="$authoring" \
            --no-interaction --no-progress --prefer-dist --no-scripts >"$work/composer-authoring.out" 2>&1; then
        tail -100 "$work/composer-authoring.out" >&2
        exit 1
    fi

    mkdir -p "$authoring/src/Provider"
    cp "$source_root/tests/PackagedForm/fixtures/app-AuthoringCustodyServiceProvider.php" \
       "$authoring/src/Provider/AuthoringCustodyServiceProvider.php"
    cp "$source_root/tests/PackagedForm/fixtures/app-FileSigningKeyProvider.php" \
       "$authoring/src/Provider/FileSigningKeyProvider.php"
    "$composer_bin" dump-autoload --working-dir="$authoring" --no-interaction >/dev/null 2>&1
    write_config "$authoring" authoring
}

build_authoring_host

if ! ( cd "$authoring" && php vendor/bin/waaseyaa install:init ) >"$work/authoring-install.out" 2>&1; then
    cat "$work/authoring-install.out" >&2
    echo 'FAIL: install:init failed on the blueprint authoring host.' >&2
    exit 1
fi
grep -Fq 'Installation is complete.' "$work/authoring-install.out"
test -d "$authoring/config/sync"
test -z "$(ls -A "$authoring/config/sync")"

cp -R "$consumer/config/sync/." "$authoring/config/sync/"
test -n "$(ls -A "$authoring/config/sync")"

if ! ( cd "$authoring" \
        && WAASEYAA_AUTHORING_SIGNING_KEY_FILE="$custody/manifest-signing.key" \
           php vendor/bin/waaseyaa config:manifest:sign --scope=site:blueprint-governance ) >"$work/sign.out" 2>&1; then
    cat "$work/sign.out" >&2
    echo 'FAIL: the authoring host could not sign the blueprint-generated sync directory.' >&2
    exit 1
fi
grep -Fq 'Envelope written to' "$work/sign.out"
test -f "$authoring/config/sync.envelope.json"
if grep -qiE 'BEGIN [A-Z ]*PRIVATE KEY|secret|private' "$work/sign.out"; then
    cat "$work/sign.out" >&2
    echo 'FAIL: signing output mentions secret material.' >&2
    exit 1
fi

write_config "$consumer" consumer
cp -R "$authoring/config/sync/." "$consumer/config/sync/"
cp "$authoring/config/sync.envelope.json" "$consumer/config/sync.envelope.json"

private_key_b64="$(php -r 'echo base64_encode((string) file_get_contents($argv[1]));' "$custody/manifest-signing.key")"
# Rules 1 and 2 from check-consumer-key-hygiene are load-bearing for manifest
# signing custody. Rule 3 (*signing* by name) false-positives on this harness's
# symlink:false provenance install because the copied framework tree includes
# OIDC migration/spec paths whose names contain "signing".
if grep -rqF -- "$private_key_b64" "$consumer" 2>/dev/null; then
    echo 'FAIL: the consumer tree contains the private signing key.' >&2
    exit 1
fi
key_hits="$(find "$consumer" -type f -name '*.key' -print 2>/dev/null || true)"
if [[ -n "$key_hits" ]]; then
    echo 'FAIL: the consumer tree contains a key file:' >&2
    printf '%s\n' "$key_hits" >&2
    exit 1
fi
if grep -rq -- 'manifest-signing.key\|WAASEYAA_AUTHORING_SIGNING_KEY_FILE\|authoring-file' "$consumer/config" "$consumer/.env" 2>/dev/null; then
    echo 'FAIL: the consumer references authoring signing custody.' >&2
    exit 1
fi
grep -Fq 'signing_key' "$authoring/config/waaseyaa.php"
if grep -Fq 'signing_key' "$consumer/config/waaseyaa.php"; then
    echo 'FAIL: the consumer profile declares a signing key.' >&2
    exit 1
fi

if ! ( cd "$consumer" && php vendor/bin/waaseyaa install:init ) >"$work/install-init.out" 2>&1; then
    cat "$work/install-init.out" >&2
    echo 'FAIL: install:init failed on the blueprint-activated consumer.' >&2
    exit 1
fi
grep -Fq 'Installation is complete.' "$work/install-init.out"

read_active_token
if ! ( cd "$consumer" && php vendor/bin/waaseyaa config:import \
             --activation-request-id=blueprint-governance-import-1 \
             --expected-generation="$active_generation" \
             --expected-sequence="$active_sequence" ) >"$work/config-import.out" 2>&1; then
    cat "$work/config-import.out" >&2
    echo 'FAIL: config:import failed to activate workflows.assignments.' >&2
    exit 1
fi
cat "$work/config-import.out"
grep -Eq '[1-9][0-9]* created|[1-9][0-9]* updated' "$work/config-import.out" \
    || { echo 'FAIL: config:import did not report created or updated entries.' >&2; exit 1; }
if grep -rqF -- "$private_key_b64" "$work/config-import.out" "$work/install-init.out" "$consumer/storage" 2>/dev/null; then
    echo 'FAIL: key material appeared in consumer output or storage.' >&2
    exit 1
fi
echo 'CFG-03 signed import verified (authoring custody split, public trust only on consumer).'

editor_out="$(cd "$consumer" && php vendor/bin/waaseyaa user:create governance-editor --email=editor@packaged.test --password=governance-editor-pw)"
viewer_out="$(cd "$consumer" && php vendor/bin/waaseyaa user:create governance-viewer --email=viewer@packaged.test --password=governance-viewer-pw)"
editor_uid="$(sed -n 's/.*ID: \([0-9]*\).*/\1/p' <<<"$editor_out")"
viewer_uid="$(sed -n 's/.*ID: \([0-9]*\).*/\1/p' <<<"$viewer_out")"
[[ -n "$editor_uid" && -n "$viewer_uid" ]] || { echo 'FAIL: could not parse created user IDs.' >&2; exit 1; }

( cd "$consumer" && php vendor/bin/waaseyaa user:assign-role "$editor_uid" editor ) >"$work/assign-editor.out" 2>&1
grep -Fq 'Assigned role' "$work/assign-editor.out"
( cd "$consumer" && php vendor/bin/waaseyaa user:assign-role "$viewer_uid" viewer ) >"$work/assign-viewer.out" 2>&1
grep -Fq 'Assigned role' "$work/assign-viewer.out"

# The probe is test-driver tooling, not runtime under test, so — mirroring
# check-site-init-profile-acceptance's own `probe=$root/tests/...` reference —
# it is read from the live checkout rather than the archived candidate.
cp "$root/tests/PackagedForm/fixtures/blueprint-governance-enforcement-probe.php" "$consumer/blueprint-governance-enforcement-probe.php"

if ! ( cd "$consumer" && php blueprint-governance-enforcement-probe.php positive "$editor_uid" "$viewer_uid" ) >"$work/probe-positive.out" 2>"$work/probe-positive.err"; then
    cat "$work/probe-positive.out" "$work/probe-positive.err" >&2
    echo 'FAIL: the packaged kernel governance probe failed with providers registered.' >&2
    exit 1
fi
cat "$work/probe-positive.out"
for marker in \
    'governance-probe kernel boot OK' \
    'governance-probe role-editor-registered: yes' \
    'governance-probe role-viewer-registered: yes' \
    'governance-probe permission-catalogue-edit-article: yes' \
    'governance-probe permission-catalogue-publish: yes' \
    'governance-probe article-revisionable: yes' \
    'governance-probe default-deny-person: yes' \
    'governance-probe entity-access-viewer-denied: yes' \
    'governance-probe entity-access-editor-allowed: yes' \
    'governance-probe workflow-transition-viewer-denied: yes' \
    'governance-probe workflow-transition-editor-allowed: yes'; do
    grep -Fq "$marker" "$work/probe-positive.out" || { echo "FAIL: missing marker: $marker" >&2; exit 1; }
done

# --- Discriminating negative control: remove ONLY the literal-root
# governance provider entry, clear the manifest cache, leave every generated
# class/config file untouched, and prove the registry disappears / fails
# closed. ---
php -r '
    $path = $argv[1];
    $composer = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    $providers = $composer["extra"]["waaseyaa"]["providers"] ?? [];
    $composer["extra"]["waaseyaa"]["providers"] = array_values(array_filter(
        $providers,
        static fn(string $p): bool => $p !== "App\\Provider\\ApplicationBlueprintGovernanceServiceProvider",
    ));
    file_put_contents($path, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$consumer/composer.json"
rm -f "$consumer/storage/framework/packages.php"
[[ -f "$consumer/src/Provider/ApplicationBlueprintGovernanceServiceProvider.php" ]] || { echo 'FAIL: rival step must leave the generated class file intact.' >&2; exit 1; }

if ! ( cd "$consumer" && php blueprint-governance-enforcement-probe.php negative ) >"$work/probe-negative.out" 2>"$work/probe-negative.err"; then
    cat "$work/probe-negative.out" "$work/probe-negative.err" >&2
    echo 'FAIL: the rival kernel boot must still succeed; only registry observations must change.' >&2
    exit 1
fi
cat "$work/probe-negative.out"
grep -Fq 'governance-probe kernel boot OK' "$work/probe-negative.out"
grep -Fq 'governance-probe role-editor-registered: no' "$work/probe-negative.out" || { echo 'FAIL: role registry must disappear after removing the literal-root provider entry.' >&2; exit 1; }
grep -Fq 'governance-probe role-viewer-registered: no' "$work/probe-negative.out" || { echo 'FAIL: role registry must disappear after removing the literal-root provider entry.' >&2; exit 1; }
grep -Fq 'governance-probe permission-catalogue-edit-article: no' "$work/probe-negative.out" || { echo 'FAIL: permission catalogue must lose the blueprint permissions.' >&2; exit 1; }

set +e
new_out="$(cd "$consumer" && php vendor/bin/waaseyaa user:create governance-rival --email=rival@packaged.test --password=governance-rival-pw)"
new_uid="$(sed -n 's/.*ID: \([0-9]*\).*/\1/p' <<<"$new_out")"
assign_out="$(cd "$consumer" && php vendor/bin/waaseyaa user:assign-role "$new_uid" editor 2>&1)"
assign_exit=$?
set -e
if [[ "$assign_exit" -eq 0 ]]; then
    echo "$assign_out" >&2
