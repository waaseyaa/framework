#!/usr/bin/env bash

# Packaged-form proof for `bin/waaseyaa bimaaji:install` (#2656).
#
# Before #2656 the canonical Agent Skills lived at the framework monorepo
# root (`skills/waaseyaa/<id>/SKILL.md`) and BimaajiServiceProvider fell back
# to `<projectRoot>/skills/waaseyaa`. That directory exists only in the
# framework checkout, so `bimaaji:install` worked exclusively in the
# repository that did not need it and exited 1 with
# "no skills discovered" for every downstream consumer.
#
# This proof builds a disposable consumer from the EXACT candidate tree,
# installs the packages as COPIES (path repositories with symlink=false, so
# `vendor/waaseyaa/bimaaji` holds real bytes rather than a link back into
# the checkout), and drives the command from there. It seeds no skill
# fixtures: everything the command writes must come from resources shipped
# inside the installed package. It then mutates only the consumer's own
# vendor copy to drive the remaining proofs.
#
# It asserts the EXACT installed structure, not mere presence. A flat
# `.claude/skills/waaseyaa-<id>.md` is not a Claude Code discovery layout, so
# an earlier revision of this proof passed — "12 written" — while producing
# files Claude Code would never load.
#
# Proofs, in order: install from installed resources; idempotent re-run;
# marker-bounded refresh; prune of an upstream removal; neutralisation of a
# retired target the consumer has edited; a look-alike file the ownership
# manifest does not claim staying untouched; corrupt- and missing-resource
# diagnostics.
#
# Run: bash tests/PackagedForm/check-bimaaji-skill-resources

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/waaseyaa-bimaaji-skills.XXXXXX")"
source_root="$work/source"
consumer="$work/consumer"

composer_bin="${COMPOSER_BIN:-}"
if [[ -z "$composer_bin" && -x "${HOME}/.local/bin/composer" ]]; then
    composer_bin="${HOME}/.local/bin/composer"
fi
if [[ -z "$composer_bin" ]]; then
    composer_bin="$(command -v composer)"
fi

cleanup() {
    # Cleanup is best-effort and must never change this script's exit
    # status; report a leak on stderr instead of letting a failed rm
    # corrupt the proof under test (#2870).
    rm -rf -- "$work" || echo "warning: failed to remove $work" >&2
}
trap cleanup EXIT

fail() {
    echo "$1" >&2
    exit 1
}

candidate="$("$root/bin/git" -C "$root" rev-parse HEAD)"

mkdir -p "$source_root" "$consumer"
"$root/bin/git" -C "$root" archive --format=tar HEAD \
    | tar --no-same-owner --no-same-permissions -xf - -C "$source_root"

# Mirror the skeleton app exactly as a consumer starts from it.
cp -R "$source_root/skeleton/." "$consumer/"
rm -f "$consumer/composer.lock" "$consumer/composer.local.json.example"
mkdir -p "$consumer/storage/framework" "$consumer/storage/files" "$consumer/config/sync"

# symlink=false makes Composer copy each package into vendor/, so the proof
# reads installed bytes rather than following a link back into the checkout.
php -r '
    $path = $argv[1];
    $composer = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    $composer["repositories"] = [
        ["type" => "path", "url" => $argv[2] . "/packages/*", "options" => ["symlink" => false]],
        ["type" => "path", "url" => $argv[2], "options" => ["symlink" => false]],
    ];
    $composer["require"]["waaseyaa/framework"] = "*";
    unset($composer["require-dev"], $composer["extra"]["merge-plugin"], $composer["scripts"]);
    file_put_contents($path, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$consumer/composer.json" "$source_root"

printf 'APP_ENV=local\nAPP_DEBUG=false\nWAASEYAA_DB=%s/storage/bimaaji-skills.sqlite\nWAASEYAA_CONFIG_SYNC_PATH=%s/config/sync\n' \
    "$consumer" "$consumer" > "$consumer/.env"

if ! "$composer_bin" install --working-dir="$consumer" \
        --no-interaction --no-progress --prefer-dist --no-scripts >"$work/composer.out" 2>&1; then
    tail -100 "$work/composer.out" >&2
    fail 'The packaged-form consumer could not install the candidate framework.'
fi

# A consumer never has a project-root skills/ directory. If one appeared, the
# proof would be worthless — it could be reading the old monorepo-only path.
[[ ! -e "$consumer/skills" ]] || fail 'The consumer unexpectedly has a project-root skills/ directory.'

resources="$consumer/vendor/waaseyaa/bimaaji/resources/skills"
[[ ! -L "$consumer/vendor/waaseyaa/bimaaji" ]] \
    || fail 'vendor/waaseyaa/bimaaji is a symlink; this proof requires installed bytes.'
[[ -d "$resources" ]] \
    || fail "The installed waaseyaa/bimaaji package ships no skill resources at $resources."

shipped="$(find "$resources" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')"
[[ "$shipped" -gt 0 ]] || fail "No <skill-id>/SKILL.md documents inside $resources."
printf 'Installed package ships %s Agent Skill documents.\n' "$shipped"

if ! ( cd "$consumer" && php vendor/bin/waaseyaa install:init ) >"$work/install-init.out" 2>&1; then
    cat "$work/install-init.out" >&2
    fail 'The governed installation phase failed on the packaged-form consumer.'
fi

# 1. The install succeeds from installed package resources alone.
if ! ( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=claude,cursor --force ) \
        >"$work/install.out" 2>&1; then
    cat "$work/install.out" >&2
    fail 'bimaaji:install failed from a packaged consumer.'
fi
grep -Fq 'Client claude:' "$work/install.out"
grep -Fq 'Client cursor:' "$work/install.out"

[[ -f "$consumer/.cursorrules" ]] || fail 'bimaaji:install wrote no .cursorrules.'
[[ -f "$consumer/.claude/CLAUDE-WAASEYAA.md" ]] || fail 'bimaaji:install wrote no Claude index.'

# Claude Code discovers a project skill ONLY at
# `.claude/skills/<skill-name>/SKILL.md` — the command name comes from the
# directory. Assert the exact structure, not mere presence: the previous
# flat `.claude/skills/waaseyaa-<id>.md` layout wrote bytes Claude never
# loaded, so a "12 written" summary looked like success while producing
# nothing usable. <https://code.claude.com/docs/en/skills>
installed_skill_files="$(find "$consumer/.claude/skills" -mindepth 2 -maxdepth 2 -type f -name 'SKILL.md' | wc -l | tr -d ' ')"
[[ "$installed_skill_files" -eq "$shipped" ]] \
    || fail "Expected $shipped Claude skill directories each holding SKILL.md, found $installed_skill_files."

if find "$consumer/.claude/skills" -maxdepth 1 -type f -name '*.md' -print -quit | grep -q .; then
    fail 'A flat .md sits directly in .claude/skills/; Claude Code does not discover that layout.'
fi

# Every shipped skill must have produced its own directory, and the content
# must come from the shipped document rather than a stub.
while IFS= read -r skill_id; do
    target="$consumer/.claude/skills/waaseyaa-$skill_id/SKILL.md"
    [[ -d "$consumer/.claude/skills/waaseyaa-$skill_id" ]] \
        || fail "No Claude skill DIRECTORY for shipped skill $skill_id."
    [[ -f "$target" ]] || fail "No SKILL.md inside .claude/skills/waaseyaa-$skill_id/."
    # Frontmatter must start at byte 0 or Claude Code treats the whole file
    # — markers included — as skill content.
    head -1 "$target" | grep -qx -- '---' \
        || fail "$target does not open with YAML frontmatter on line 1."
    grep -qx -- "name: waaseyaa-$skill_id" "$target" \
        || fail "$target frontmatter name does not match its directory."
    grep -Fq '<!-- waaseyaa:bimaaji:install BEGIN -->' "$target" \
        || fail "$target carries no managed-region marker."
done < <(find "$resources" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)

first_skill_id="$(find "$resources" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | head -1)"
grep -Fq '<!-- waaseyaa:bimaaji:install BEGIN -->' "$consumer/.cursorrules"
grep -Fq '<!-- waaseyaa:bimaaji:install END -->' "$consumer/.cursorrules"

# The ownership manifest is what makes pruning safe; it must exist and name
# the exact targets written.
manifest="$consumer/.waaseyaa/bimaaji-install.json"
[[ -f "$manifest" ]] || fail "bimaaji:install wrote no ownership manifest at $manifest."
grep -Fq ".claude/skills/waaseyaa-$first_skill_id/SKILL.md" "$manifest" \
    || fail 'The ownership manifest does not record the Claude skill targets.'
grep -Fq '.cursorrules' "$manifest" \
    || fail 'The ownership manifest does not record the cursor target.'

# 2. Re-running is idempotent.
if ! ( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=cursor ) \
        >"$work/install-retry.out" 2>&1; then
    cat "$work/install-retry.out" >&2
    fail 'A second bimaaji:install run must succeed idempotently.'
fi
grep -Fq 'Client cursor: 0 written, 1 unchanged, 0 skipped.' "$work/install-retry.out"

# 3. The install is marker-bounded: hand-authored content around the managed
#    region survives a refresh, and refreshing needs no --force.
{
    printf '# House rules\n\nThis line is mine.\n\n'
    cat "$consumer/.cursorrules"
    printf '\n## Team addendum\n\nSo is this one.\n'
} > "$work/edited.cursorrules"
cp "$work/edited.cursorrules" "$consumer/.cursorrules"

# Change the managed content upstream so the refresh has something to do.
sed -i '1s/^/Local edit to force a refresh.\n/' "$resources/$first_skill_id/SKILL.md"

if ! ( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=cursor ) \
        >"$work/install-merge.out" 2>&1; then
    cat "$work/install-merge.out" >&2
    fail 'A marker-bounded refresh must succeed without --force.'
fi
grep -Fq 'Client cursor: 1 written, 0 unchanged, 0 skipped.' "$work/install-merge.out"
grep -Fq '# House rules' "$consumer/.cursorrules" \
    || fail 'The marker-bounded refresh dropped hand-authored content above the region.'
grep -Fq 'This line is mine.' "$consumer/.cursorrules"
grep -Fq '## Team addendum' "$consumer/.cursorrules" \
    || fail 'The marker-bounded refresh dropped hand-authored content below the region.'
grep -Fq 'So is this one.' "$consumer/.cursorrules"
grep -Fq 'Local edit to force a refresh.' "$consumer/.cursorrules" \
    || fail 'The marker-bounded refresh did not update the managed region.'

# 4. A skill retired upstream is pruned on the next run — the remove case.
#    Ownership comes from the manifest, so this is a positive control: the
#    file must actually disappear, and its directory with it.
retire_id="$(find "$resources" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tail -1)"
[[ "$retire_id" != "$first_skill_id" ]] || fail 'Need at least two shipped skills for the prune proof.'
cp -R "$resources/$retire_id" "$work/retired-skill-backup"
[[ -f "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md" ]] \
    || fail "Retire probe target .claude/skills/waaseyaa-$retire_id/SKILL.md is missing."

rm -rf "$resources/$retire_id"
if ! ( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=claude --force ) \
        >"$work/install-prune.out" 2>&1; then
    cat "$work/install-prune.out" >&2
    fail 'The pruning run must succeed.'
fi
[[ ! -e "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md" ]] \
    || { cat "$work/install-prune.out" >&2; fail "Retired skill waaseyaa-$retire_id was not pruned."; }
[[ ! -e "$consumer/.claude/skills/waaseyaa-$retire_id" ]] \
    || fail "Retired skill directory waaseyaa-$retire_id was left behind."
[[ -f "$consumer/.claude/skills/waaseyaa-$first_skill_id/SKILL.md" ]] \
    || fail 'Pruning removed a skill that is still shipped.'
grep -Fq 'Removed retired target' "$work/install-prune.out" \
    || { cat "$work/install-prune.out" >&2; fail 'The prune was not reported.'; }

# 5. A retired target the consumer has edited is neutralised, never deleted,
#    and supporting assets beside it survive.
cp -R "$work/retired-skill-backup" "$resources/$retire_id"
( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=claude --force ) >/dev/null 2>&1
printf '\n## My own notes\n\nKeep this line.\n' >> "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md"
printf 'My reference material.\n' > "$consumer/.claude/skills/waaseyaa-$retire_id/reference.md"
rm -rf "$resources/$retire_id"

if ! ( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=claude --force ) \
        >"$work/install-retire.out" 2>&1; then
    cat "$work/install-retire.out" >&2
    fail 'The retirement run must succeed.'
fi
[[ -f "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md" ]] \
    || fail 'A retired target carrying user content must not be deleted.'
grep -Fq 'Keep this line.' "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md" \
    || fail 'Retirement dropped hand-authored content.'
grep -Fq 'has been retired' "$consumer/.claude/skills/waaseyaa-$retire_id/SKILL.md" \
    || fail 'Retirement left the withdrawn guidance in place.'
[[ -f "$consumer/.claude/skills/waaseyaa-$retire_id/reference.md" ]] \
    || fail 'Retirement removed a supporting asset the consumer added.'

# 6. A look-alike file the manifest does not claim is never touched. Filename
#    is a guess about ownership; the manifest is the record.
mkdir -p "$consumer/.claude/skills/waaseyaa-not-ours"
printf -- '---\nname: waaseyaa-not-ours\n---\n\nMine, not the framework of it.\n' \
    > "$consumer/.claude/skills/waaseyaa-not-ours/SKILL.md"
theirs_before="$(sha1sum "$consumer/.claude/skills/waaseyaa-not-ours/SKILL.md" | cut -d ' ' -f 1)"
( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=claude --force ) >/dev/null 2>&1
[[ "$(sha1sum "$consumer/.claude/skills/waaseyaa-not-ours/SKILL.md" | cut -d ' ' -f 1)" == "$theirs_before" ]] \
    || fail 'A look-alike file the manifest does not claim was modified.'
cp -R "$work/retired-skill-backup" "$resources/$retire_id"

# 7. A corrupt resource names the offending file and says so.
cp "$resources/$first_skill_id/SKILL.md" "$work/$first_skill_id.SKILL.md.bak"
printf -- '---\nname: broken\ndescription: this frontmatter never closes\n\nbody\n' \
    > "$resources/$first_skill_id/SKILL.md"
set +e
( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=cursor --force ) \
    >"$work/install-corrupt.out" 2>&1
corrupt_exit=$?
set -e
[[ "$corrupt_exit" -ne 0 ]] || fail 'A corrupt SKILL.md must fail the install.'
grep -Fq 'is corrupt' "$work/install-corrupt.out" \
    || { cat "$work/install-corrupt.out" >&2; fail 'The corrupt-resource diagnostic is missing.'; }
grep -Fq "$resources/$first_skill_id/SKILL.md" "$work/install-corrupt.out" \
    || { cat "$work/install-corrupt.out" >&2; fail 'The corrupt-resource diagnostic does not name the file.'; }
cp "$work/$first_skill_id.SKILL.md.bak" "$resources/$first_skill_id/SKILL.md"

# 8. A missing resource directory names the resolved vendor path and the
#    reinstall remedy — not a monorepo-shaped `skills/waaseyaa/...` hint.
rm -rf "$resources"
set +e
( cd "$consumer" && php vendor/bin/waaseyaa bimaaji:install --client=cursor --force ) \
    >"$work/install-missing.out" 2>&1
missing_exit=$?
set -e
[[ "$missing_exit" -ne 0 ]] || fail 'A missing resource directory must fail the install.'
grep -Fq "$resources" "$work/install-missing.out" \
    || { cat "$work/install-missing.out" >&2; fail 'The missing-resource diagnostic does not name the resolved directory.'; }
grep -Fq 'composer reinstall waaseyaa/bimaaji' "$work/install-missing.out" \
    || { cat "$work/install-missing.out" >&2; fail 'The missing-resource diagnostic offers no remedy.'; }
if grep -Fq 'skills/waaseyaa/<id>/SKILL.md' "$work/install-missing.out"; then
    cat "$work/install-missing.out" >&2
    fail 'The diagnostic still points at the monorepo-only skills/waaseyaa path.'
fi

printf 'Bimaaji packaged skill-resource proof passed.\n'
printf 'Candidate: %s\n' "$candidate"
