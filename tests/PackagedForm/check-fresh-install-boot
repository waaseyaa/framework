#!/usr/bin/env bash

# Fresh-install boot proof (#2426).
#
# Builds a disposable consumer from the EXACT candidate tree using path
# repositories — no Packagist, no tag — installs the full framework the way the
# skeleton does, and boots it through the real initialization path.
#
# Why this exists alongside Skeleton Smoke: Skeleton Smoke resolves the
# published artifact from Packagist and therefore cannot run until after the tag
# is pushed. Two releases (v0.1.0-alpha.294, v0.1.0-alpha.295) shipped over a red
# Skeleton Smoke because a post-publication proof cannot block a publication.
# This proof runs pre-tag, so the release cut can depend on it.
#
# It proves boot AND a day-one write. An earlier revision stopped at boot, and
# v0.1.0-alpha.296 shipped through this gate green while Skeleton Smoke — which
# saves an entity — went red on the same commit.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/waaseyaa-fresh-install-boot.XXXXXX")"
source_root="$work/source"
consumer="$work/consumer"

composer_bin="${COMPOSER_BIN:-}"
if [[ -z "$composer_bin" && -x "${HOME}/.local/bin/composer" ]]; then
    composer_bin="${HOME}/.local/bin/composer"
fi
if [[ -z "$composer_bin" ]]; then
    composer_bin="$(command -v composer)"
fi

cleanup() {
    rm -rf -- "$work"
}
trap cleanup EXIT

candidate="$("$root/bin/git" -C "$root" rev-parse HEAD)"

mkdir -p "$source_root" "$consumer"
"$root/bin/git" -C "$root" archive --format=tar HEAD \
    | tar --no-same-owner --no-same-permissions -xf - -C "$source_root"

# Mirror the skeleton app: its config, its entity types, its front controller.
cp -R "$source_root/skeleton/." "$consumer/"
rm -f "$consumer/composer.lock" "$consumer/composer.local.json.example"
mkdir -p "$consumer/storage/framework" "$consumer/storage/files" "$consumer/config/sync"

# Resolve every waaseyaa/* — including the waaseyaa/framework metapackage at the
# repository root — from the candidate tree rather than Packagist.
php -r '
    $path = $argv[1];
    $composer = json_decode((string) file_get_contents($path), true, flags: JSON_THROW_ON_ERROR);
    $composer["repositories"] = [
        ["type" => "path", "url" => $argv[2] . "/packages/*"],
        ["type" => "path", "url" => $argv[2]],
    ];
    $composer["require"]["waaseyaa/framework"] = "*";
    // The merge plugin only matters for per-developer overrides that this
    // disposable consumer does not have, and it is not installed here.
    unset($composer["require-dev"], $composer["extra"]["merge-plugin"], $composer["scripts"]);
    file_put_contents($path, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
' "$consumer/composer.json" "$source_root"

printf 'APP_ENV=local\nAPP_DEBUG=false\nWAASEYAA_DB=%s/storage/fresh-install.sqlite\nWAASEYAA_CONFIG_SYNC_PATH=%s/config/sync\n' \
    "$consumer" "$consumer" > "$consumer/.env"

if ! "$composer_bin" install --working-dir="$consumer" \
        --no-interaction --no-progress --prefer-dist --no-scripts >"$work/composer.out" 2>&1; then
    tail -100 "$work/composer.out" >&2
    exit 1
fi

# The governed installation phase, run exactly as a deployment runs it (#2428).
# Everything the probe then does is ordinary runtime.
if ! ( cd "$consumer" && php vendor/bin/waaseyaa install:init ) >"$work/install.out" 2>&1; then
    cat "$work/install.out" >&2
    echo 'The governed installation phase failed on a fresh consumer.' >&2
    exit 1
fi
grep -Fq 'Installation is complete.' "$work/install.out"

# Re-running must be idempotent: no competing generation, still successful.
if ! ( cd "$consumer" && php vendor/bin/waaseyaa install:init ) >"$work/install-retry.out" 2>&1; then
    cat "$work/install-retry.out" >&2
    echo 'A second installation run must succeed idempotently.' >&2
    exit 1
fi
grep -Fq 'Configuration already initialized' "$work/install-retry.out"

# The probe asserts the property; keep it outside the consumer's autoload roots.
cp "$source_root/tests/FreshInstallBoot/boot.php" "$consumer/boot.php"

if ! php "$consumer/boot.php" >"$work/boot.out" 2>&1; then
    cat "$work/boot.out" >&2
    echo 'A fresh packaged-form install could not boot.' >&2
    exit 1
fi
grep -Fq 'fresh-install kernel boot OK' "$work/boot.out"
# Booting is necessary but not sufficient — alpha.296 booted and could not
# write. Require the day-one round-trip too.
grep -Fq 'fresh-install entity round-trip OK' "$work/boot.out"

# Simulate the exact pre-DB-03 upgrade trap from #2460: a persisted aggregate
# remains, but its authority row does not. Ordinary provider boot must fail
# closed until the deliberate restricted command repairs it.
cp "$source_root/tests/MutationAuthorityUpgrade/simulate-legacy.php" "$consumer/simulate-legacy.php"
cp "$source_root/tests/MutationAuthorityUpgrade/ordinary-boot.php" "$consumer/ordinary-boot.php"
cp "$source_root/tests/MutationAuthorityUpgrade/verify-authorities.php" "$consumer/verify-authorities.php"

php "$consumer/simulate-legacy.php" \
    "$consumer/storage/fresh-install.sqlite" "$work/preserved-authority.json" \
    >"$work/simulate-legacy.out" 2>&1

if php "$consumer/ordinary-boot.php" >"$work/legacy-boot.out" 2>&1; then
    cat "$work/legacy-boot.out" >&2
    echo 'Ordinary boot must fail closed over a legacy aggregate without authority.' >&2
    exit 1
fi
grep -Fq "Persisted entity workflow 'editorial' has no aggregate mutation authority." "$work/legacy-boot.out"

if ! ( cd "$consumer" && php vendor/bin/waaseyaa entity:backfill-mutation-authorities \
        --reason='Packaged-form legacy upgrade proof' --json ) >"$work/backfill.out" 2>&1; then
    cat "$work/backfill.out" >&2
    echo 'The restricted mutation-authority upgrade failed.' >&2
    exit 1
fi
grep -Eq '"created"[[:space:]]*:[[:space:]]*1' "$work/backfill.out"
grep -Eq '"workflow"[[:space:]]*:[[:space:]]*1' "$work/backfill.out"
if grep -Fq 'mutation_tag' "$work/backfill.out"; then
    echo 'The upgrade output exposed mutation-token material.' >&2
    exit 1
fi

php "$consumer/verify-authorities.php" \
    "$consumer/storage/fresh-install.sqlite" "$work/preserved-authority.json" \
    >"$work/verify-authorities.out" 2>&1

if ! php "$consumer/ordinary-boot.php" >"$work/repaired-boot.out" 2>&1; then
    cat "$work/repaired-boot.out" >&2
    echo 'Ordinary boot remained blocked after the supported upgrade.' >&2
    exit 1
fi
grep -Fq 'ordinary boot OK' "$work/repaired-boot.out"

if ! ( cd "$consumer" && php vendor/bin/waaseyaa entity:backfill-mutation-authorities \
        --reason='Packaged-form idempotency proof' --json ) >"$work/backfill-retry.out" 2>&1; then
    cat "$work/backfill-retry.out" >&2
    echo 'The mutation-authority upgrade retry failed.' >&2
    exit 1
fi
grep -Eq '"created"[[:space:]]*:[[:space:]]*0' "$work/backfill-retry.out"

printf 'Fresh-install boot proof passed.\n'
printf 'Candidate: %s\n' "$candidate"
