#!/usr/bin/env bash
set -euo pipefail

framework_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
work_root=${WAASEYAA_REFERENCE_WORK_ROOT:-$(mktemp -d)}
consumer_root="$work_root/consumer"
project_source="$work_root/project-source"
framework_source="$work_root/framework-source"
keep=${WAASEYAA_REFERENCE_KEEP:-0}
export APP_ENV=testing
export WAASEYAA_APP_SECRET=base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
composer_bin=$(command -v composer)
if [[ -x "$HOME/.local/bin/composer" ]]; then
  composer_bin="$HOME/.local/bin/composer"
fi

cleanup() {
  if [[ "$keep" != "1" ]]; then
    # Cleanup is best-effort and must never change this script's exit
    # status; report a leak on stderr instead of letting a failed rm
    # corrupt the proof under test (#2870).
    rm -rf -- "$work_root" || echo "warning: failed to remove $work_root" >&2
  fi
}
trap cleanup EXIT

mkdir -p "$project_source" "$framework_source"
candidate_revision=$(git -C "$framework_root" rev-parse HEAD)
git -C "$framework_root" archive --format=tar "$candidate_revision" \
  | tar -xf - -C "$framework_source"
if find "$framework_source" -type l -print -quit | grep -q .; then
  echo "reference-consumer: exact candidate archive must not contain symlinks" >&2
  exit 1
fi

cp -R "$framework_source/skeleton/." "$project_source/"
git -C "$project_source" init --quiet
git -C "$project_source" config user.name 'Waaseyaa Reference Consumer'
git -C "$project_source" config user.email 'reference-consumer@invalid.example'
git -C "$project_source" add --all
git -C "$project_source" commit --quiet -m 'Exact candidate project skeleton'
project_revision=$(git -C "$project_source" rev-parse HEAD)
"$composer_bin" create-project waaseyaa/waaseyaa "$consumer_root" \
  --repository="{\"type\":\"package\",\"package\":{\"name\":\"waaseyaa/waaseyaa\",\"version\":\"dev-main\",\"source\":{\"url\":\"$project_source\",\"type\":\"git\",\"reference\":\"$project_revision\"}}}" \
  --stability=dev --prefer-source --no-install --no-scripts --no-plugins --no-interaction
cp "$framework_source/tests/ReferenceConsumer/site.answers.yaml" "$consumer_root/site.answers.yaml"
php "$framework_source/tests/ReferenceConsumer/prepare.php" configure "$framework_source" "$consumer_root"

# The dependency install is the only network-permitted phase. Waaseyaa path
# packages are copied (never symlinked) into this clean create-project fixture.
"$composer_bin" update --working-dir="$consumer_root" --no-interaction --no-scripts --no-plugins --prefer-dist
if find "$consumer_root/vendor/waaseyaa" -type l -print -quit | grep -q .; then
  echo "reference-consumer: installed Waaseyaa packages must not be source symlinks" >&2
  exit 1
fi

php "$framework_source/tests/ReferenceConsumer/prepare.php" bind-lock "$framework_source" "$consumer_root"

# #2644: verification before site:init is a definite state, not a shell error.
# The generated command does not exist yet, so the portable entry must name the
# remedy and exit 3 rather than dying with a 127 "not found".
pre_init_status=0
(cd "$consumer_root" && php .ci/site-verify.php) >"$work_root/pre-init-verify.log" 2>&1 || pre_init_status=$?
if [[ "$pre_init_status" != 3 ]]; then
  echo "reference-consumer: pre-init verification must exit 3, got $pre_init_status" >&2
  cat "$work_root/pre-init-verify.log" >&2
  exit 1
fi
grep -q 'site:init' "$work_root/pre-init-verify.log"

assert_project_init_json() {
  local receipt=$1
  local expected_status=$2
  local expected_install_status=$3
  local expected_install_text=$4

  php -r '
    $bytes = file_get_contents($argv[1]);
    if (!is_string($bytes) || !str_ends_with($bytes, "\n")) {
        throw new RuntimeException("project:init must emit one newline-terminated document");
    }
    $result = json_decode($bytes, false, 512, JSON_THROW_ON_ERROR);
    if (!$result instanceof stdClass) {
        throw new RuntimeException("project:init result must be an object");
    }
    $keys = array_keys(get_object_vars($result));
    sort($keys, SORT_STRING);
    if ($keys !== ["errors", "phases", "schema", "status", "version"]
        || $result->schema !== "waaseyaa.project_init_result"
        || $result->version !== 1
        || $result->status !== $argv[2]
        || !is_array($result->errors)
        || $result->errors !== []
        || !$result->phases instanceof stdClass
        || !$result->phases->site instanceof stdClass
        || !$result->phases->install instanceof stdClass
        || $result->phases->site->command !== "site:init"
        || $result->phases->site->status !== "succeeded"
        || $result->phases->site->exit_code !== 0
        || !$result->phases->site->result instanceof stdClass
        || $result->phases->install->command !== "install:init"
        || $result->phases->install->status !== $argv[3]
        || $result->phases->install->exit_code !== 0
        || $result->phases->install->not_run_reason !== null
        || !str_contains($result->phases->install->stdout, $argv[4])) {
        throw new RuntimeException("project:init result does not match the completed lifecycle contract");
    }
  ' "$receipt" "$expected_status" "$expected_install_status" "$expected_install_text"
}

assert_generation_state() {
  php -r '
    $state = json_decode($argv[1], true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($state)
        || array_keys($state) !== ["generation_count", "activation_count", "generations", "activations"]
        || $state["generation_count"] !== 1
        || $state["activation_count"] !== 1
        || !is_array($state["generations"])
        || count($state["generations"]) !== 1
        || !is_array($state["activations"])
        || count($state["activations"]) !== 1
        || ($state["generations"][0]["authority_id"] ?? null) !== ($state["activations"][0]["authority_id"] ?? null)
        || ($state["generations"][0]["generation_id"] ?? null) !== ($state["activations"][0]["generation_id"] ?? null)
        || preg_match("/^[a-z0-9._-]{1,64}$/D", $state["activations"][0]["authority_id"] ?? "") !== 1
        || preg_match("/^[a-f0-9]{64}$/D", $state["activations"][0]["generation_id"] ?? "") !== 1
        || ($state["activations"][0]["activation_sequence"] ?? null) !== 1) {
        throw new RuntimeException("fresh installation must expose exactly one canonical active configuration generation");
    }
  ' "$1"
}

# The installed command must retain the real site:init interaction boundary.
# The wizard currently asks four identity/content questions, one route question
# for the default page type, and two capability questions before the separate
# publication confirmation. Eight blank answers therefore accept those seven
# source-defined defaults and decline publication at the final default-no gate.
if ! command -v script >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
  echo "reference-consumer: util-linux script and coreutils timeout are required for the bounded interactive CLI proof" >&2
  exit 1
fi
interactive_status=0
(
  cd "$consumer_root"
  printf '\n\n\n\n\n\n\n\n' \
    | timeout --signal=TERM --kill-after=5s 30s \
      script -qefc 'php vendor/bin/waaseyaa project:init' "$work_root/project-init-interactive.log"
) >"$work_root/project-init-interactive.out" 2>"$work_root/project-init-interactive.err" || interactive_status=$?
if [[ "$interactive_status" == 124 || "$interactive_status" == 137 ]]; then
  echo "reference-consumer: interactive project:init exceeded its 30-second bound" >&2
  cat "$work_root/project-init-interactive.out" "$work_root/project-init-interactive.err" >&2
  exit 1
fi
if [[ "$interactive_status" != 1 ]]; then
  echo "reference-consumer: declined interactive project:init must exit 1, got $interactive_status" >&2
  cat "$work_root/project-init-interactive.out" "$work_root/project-init-interactive.err" >&2
  exit 1
fi
grep -Fq 'What is the public name of this application?' "$work_root/project-init-interactive.log"
grep -Fq 'Publish this complete generated site contract?' "$work_root/project-init-interactive.log"
grep -Fq 'Site initialization cancelled without publishing new artifacts.' "$work_root/project-init-interactive.log"
if grep -Fq 'Installation is complete.' "$work_root/project-init-interactive.log"; then
  echo "reference-consumer: declined interactive project:init continued into install:init" >&2
  exit 1
fi
if [[ -e "$consumer_root/storage/waaseyaa.sqlite" \
  || -e "$consumer_root/.waaseyaa/generated.json" \
  || -e "$consumer_root/bin/maintenance/site-verify" ]]; then
  echo "reference-consumer: declined interactive project:init materialized project state" >&2
  exit 1
fi

# #2664: the freshly installed exact candidate now exercises the composed entry
# point itself. site:init still owns publication and install:init remains the
# only materialization phase; the parent only preserves their process boundary.
(cd "$consumer_root" && php vendor/bin/waaseyaa project:init --answers=site.answers.yaml --project-root="$consumer_root" --yes --json --no-interaction) \
  >"$work_root/project-init.json" 2>"$work_root/project-init.err"
if [[ -s "$work_root/project-init.err" ]]; then
  echo "reference-consumer: successful project:init wrote unexpected parent stderr" >&2
  cat "$work_root/project-init.err" >&2
  exit 1
fi
assert_project_init_json "$work_root/project-init.json" completed succeeded 'Installation is complete.'
if [[ ! -e "$consumer_root/storage/waaseyaa.sqlite" \
  || ! -e "$consumer_root/.waaseyaa/generated.json" \
  || ! -e "$consumer_root/bin/maintenance/site-verify" ]]; then
  echo "reference-consumer: project:init did not complete the installed fresh-project lifecycle" >&2
  exit 1
fi

before=$(php "$framework_source/tests/ReferenceConsumer/prepare.php" snapshot "$framework_source" "$consumer_root")
generation_before=$(php "$framework_source/tests/ReferenceConsumer/prepare.php" generation-state "$framework_source" "$consumer_root")
assert_generation_state "$generation_before"
export COMPOSER_DISABLE_NETWORK=1
(cd "$consumer_root" && php vendor/bin/waaseyaa project:init --answers=site.answers.yaml --project-root="$consumer_root" --yes --json --no-interaction) \
  >"$work_root/project-init-repeat.json" 2>"$work_root/project-init-repeat.err"
if [[ -s "$work_root/project-init-repeat.err" ]]; then
  echo "reference-consumer: repeated project:init wrote unexpected parent stderr" >&2
  cat "$work_root/project-init-repeat.err" >&2
  exit 1
fi
assert_project_init_json "$work_root/project-init-repeat.json" completed succeeded 'Configuration already initialized'
after=$(php "$framework_source/tests/ReferenceConsumer/prepare.php" snapshot "$framework_source" "$consumer_root")
generation_after=$(php "$framework_source/tests/ReferenceConsumer/prepare.php" generation-state "$framework_source" "$consumer_root")
assert_generation_state "$generation_after"
if [[ "$before" != "$after" ]]; then
  echo "reference-consumer: offline project:init retry is not byte-identical" >&2
  exit 1
fi
if [[ "$generation_before" != "$generation_after" ]]; then
  echo "reference-consumer: configuration generation changed during idempotent project:init retry" >&2
  exit 1
fi

(cd "$consumer_root" && php vendor/bin/waaseyaa site:doctor --strict --format=json --project-root="$consumer_root")
"$consumer_root/bin/maintenance/site-verify"
"$consumer_root/.ci/site-verify"

# Framework upgrade continuity: a reviewed dependency-lock change must fail
# strict provenance until site:init rebinds the manifest, without replacing the
# shared Admin SPA/Anokii page authority or any generated acceptance contract.
printf '\n' >> "$consumer_root/composer.lock"
if (cd "$consumer_root" && php vendor/bin/waaseyaa site:doctor --strict --format=json --project-root="$consumer_root") >"$work_root/lock-drift.json" 2>&1; then
  echo "reference-consumer: lock drift was accepted before regeneration" >&2
  exit 1
fi
grep -q 'SITE011_COMPOSER_LOCK_DRIFT' "$work_root/lock-drift.json"
php "$framework_source/tests/ReferenceConsumer/prepare.php" bind-lock "$framework_source" "$consumer_root"
(cd "$consumer_root" && php vendor/bin/waaseyaa site:init --answers=site.answers.yaml --project-root="$consumer_root" --yes)
(cd "$consumer_root" && php vendor/bin/waaseyaa site:doctor --strict --format=json --project-root="$consumer_root")
"$consumer_root/.ci/site-verify"

grep -q "'clients' => \['admin_spa', 'anokii'\]" "$consumer_root/config/waaseyaa-recipes/governed-authoring.php"
for bundle in page update event job announcement; do
  grep -q "'bundle' => '$bundle'" "$consumer_root/config/waaseyaa-recipes/published-content.php"
done

echo "reference-consumer: PASS (offline regeneration, framework upgrade continuity, provider-neutral adapter)"
